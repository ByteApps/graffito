<?xml version="1.0" encoding="UTF-8"?>
<!-- App Sandbox entitlements for the Mac App Store build of chain-notes-app.
     Referenced by the macOS target's CODE_SIGN_ENTITLEMENTS (project.yml).
     No secrets here — $(AppIdentifierPrefix) is resolved to the team prefix
     by the signing toolchain at build time.

     Capabilities the app actually uses:
       app-sandbox                 — required for the Mac App Store.
       network.client              — esplora / mempool.space HTTPS.
       device.camera               — nokhwa AVFoundation QR scanning.
       files.user-selected.rw      — rfd open/save dialogs (import/export).
       keychain-access-groups      — the notes key lives in the keychain under
                                      the team-prefixed group so it iCloud-Keychain
                                      syncs iPhone <-> Mac (Universal Purchase, same
                                      bundle id → same default access group).
       ubiquity-kvstore-identifier — iCloud-contacts feature (2026-07-20):
                                      NSUbiquitousKeyValueStore (src/icloud.rs)
                                      needs this capability to sync the
                                      device-level contacts list iPhone <-> Mac;
                                      SAME identifier as the iOS target
                                      (chain-notes-ios.entitlements) so both
                                      platforms read/write the one KV store. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.objsal.chainnotes</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.objsal.chainnotes</string>
</dict>
</plist>

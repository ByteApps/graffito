/target
/target-mobile
/target-macapp
# XcodeGen-generated (source of truth: project.yml)
/build
# xcodebuild -derivedDataPath for on-device iOS builds
/build-ios
*.xcodeproj/
/Info.plist
/Info-mac.plist

# Internal docs kept in the private workspace companion
# (prime/private/chain-notes-app) — not published in this (public-ready)
# repo. Copies live there; these are the working-tree originals a local
# checkout may still have on disk from before the move.
/CLAUDE.md
/DEVELOPMENT.md
/EXTERNAL-FUNDING-STATUS.md
/SIGNING-NOTARIZATION.md
/UPSTREAM-ISSUES.md

# Local signing config symlinked from the private companion (real Team ID) — never publish
/signing.env

# App Store Connect signing + config, symlinked from the private companion
# (prime/private/chain-notes-app/appstore) — certs, ASC key, provisioning
# profiles, team/app ids. Never publish.
/appstore

# App Review contact (real name/email/phone) — symlinked from the private
# appstore/ companion; never publish.
/fastlane/metadata/review_information

# fastlane run artifacts
/fastlane/report.xml
/fastlane/Preview.html
/fastlane/test_output
/fastlane/README.md

# xcodebuild -derivedDataPath for iOS Simulator builds
/build-sim

# Google Play AAB build wrapper (android/play/) — Gradle project outputs and
# machine-local config, not build inputs. The .so staged into jniLibs is a
# build product copied out of the cargo-apk APK by
# scripts/build-play-bundle.sh, not source; bundletool.jar is downloaded by
# the same script from the official Google GitHub releases.
/android/play/local.properties
/android/play/.gradle
/android/play/build
/android/play/app/build
/android/play/app/src/main/jniLibs
/android/play/tools

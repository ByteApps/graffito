<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for `xcodebuild -exportArchive` (App Store upload).
     scripts/ios-archive-upload.sh copies this to build/ios-release/ExportOptions.plist
     and substitutes __TEAM_ID__ with $TEAM_ID at build time, so no team id is
     committed. destination=upload sends the build straight to App Store Connect. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>teamID</key>
	<string>__TEAM_ID__</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<true/>
</dict>
</plist>

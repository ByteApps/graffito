// Screen.backup-words -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- 2 · backup ----------

import { Ui, Settings, BackupWords, Change } from "../globals.slint";
import { Caption, Mono, Card, PrimaryButton, SvgIconButton, Header, CopyButton } from "../components.slint";
import { EditField } from "../edit.slint";
import { Pal } from "../theme.slint";
import { Switch } from "std-widgets.slint";

export component BackupWordsScreen inherits VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Write these words down";
            show-back: true;
            back => { Ui.nav-back-nonce += 1; }
        }
        Rectangle {
            border-radius: 10px;
            background: Pal.warn.with-alpha(0.12);
            height: warn-t.preferred-height + 20px;
            warn-t := Caption {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                color: Pal.warn;
                text: "Anyone with these words can spend your funds and read every private note. Write them on paper — never a screenshot.";
            }
        }
        Card {
            height: words-t.preferred-height + 32px;
            words-t := Mono {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                text: Ui.backup-words;
                font-size: 13px;
            }
            CopyButton {
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                clicked => { Ui.copy-text("backup-words", Ui.backup-words); }
            }
        }
        // Honest about provenance: the standard caption says the device
        // generated this, which is exactly what a dice user chose NOT to do.
        // The hot-wallet warning still applies either way — the key lives on
        // an online phone regardless of where its randomness came from.
        Caption {
            color: Pal.muted;
            text: BackupWords.seed-from-dice
                ? "Built from your dice rolls alone — this device added nothing. It still lives on an online device, so treat it as a hot wallet and keep only note-fee amounts here. You can view these words again later in Settings."
                : "Generated on this online device, so treat it as a hot wallet — keep only note-fee amounts here. For real savings, use a hardware wallet and import it as watch-only. You can also view these words again later in Settings.";
        }
        // Advanced (collapsible, styled like the compose panels so it clearly
        // reads as tappable): optional user-supplied entropy ("salt").
        //
        // HIDDEN for a dice seed. Both controls in here would destroy the
        // property the user chose dice for: the reroll button replaces the
        // seed with a device-random one, and the salt field re-derives it as
        // SHA256(csprng ‖ salt). Either would silently make the words stop
        // matching the hash they just watched being built, with no way to
        // reproduce them off-device. To reroll dice, go back and roll again.
        if !BackupWords.seed-from-dice: Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: adv-col.preferred-height;
            adv-col := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Rectangle {
                    height: 22px;
                    TouchArea { clicked => { BackupWords.advanced-expanded = !BackupWords.advanced-expanded; } }
                    HorizontalLayout {
                        Text {
                            text: "Advanced";
                            font-size: 12px;
                            color: Pal.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        Image {
                            source: BackupWords.advanced-expanded
                                ? @image-url("../icons/caret-up.svg")
                                : @image-url("../icons/caret-down.svg");
                            colorize: Pal.muted;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                        }
                    }
                }
                if BackupWords.advanced-expanded: Caption {
                    text: "Add extra entropy — dice rolls, random words, anything. It's hashed with the device's secure RNG, so it can only ADD randomness. Press the reroll button or Enter to reroll.";
                }
                if BackupWords.advanced-expanded: HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        placeholder-text: "extra entropy (optional)";
                        text <=> BackupWords.entropy-salt;
                        accepted => { BackupWords.regenerate-words(); }
                    }
                    SvgIconButton {
                        icon: "refresh";
                        tint: Pal.text;
                        clicked => { BackupWords.regenerate-words(); }
                    }
                }
            }
        }
        if Ui.apple-platform && Ui.icloud-enabled: Switch {
            text: "Back up to iCloud";
            checked <=> Ui.icloud-backup;
            toggled => { Ui.set-icloud-backup(Ui.icloud-backup); }
        }
        if Ui.apple-platform && Ui.icloud-enabled: Caption {
            text: "Syncs your key to your Apple devices and lets you restore after reinstall. Change anytime in Settings.";
            color: Pal.muted;
        }
        if Ui.apple-platform && !Ui.icloud-enabled: Caption {
            text: "iCloud backup is off — you're not signed into iCloud. Turn on iCloud (with iCloud Keychain) in system Settings to back up your key automatically.";
            color: Pal.warn;
        }
        PrimaryButton { text: "I wrote them down"; clicked => { BackupWords.backup-continue(); } }
    }

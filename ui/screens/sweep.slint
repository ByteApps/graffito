// Screen.sweep -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- 16 · sweep (compose-like, minus the note text) ----------

import { Screen } from "../types.slint";
import { Ui, Sweep } from "../globals.slint";
import { Caption, PrimaryButton, Header, Badge, SelectPill } from "../components.slint";
import { EditField } from "../edit.slint";
import { Pal, Metrics } from "../theme.slint";
import { Switch } from "std-widgets.slint";

export component SweepScreen inherits VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: Ui.sweep-kind == "consolidate" ? "Consolidate" : "Sweep";
            show-sync: true;
            net-busy: Ui.net-busy;
            back => { Ui.nav-back-nonce += 1; }
            sync => { Ui.refresh-notebooks(); }
            busy-tapped => { Ui.sync-busy-toast(); }
        }
        Flickable {
            viewport-height: sweep-col.preferred-height;
            // Dismiss layer (see the global one under back-scope) — the
            // custom-fee and custom-change fields live in here.
            TouchArea {
                width: parent.width;
                height: sweep-col.preferred-height;
                clicked => { Ui.focus-back-scope-nonce += 1; }
            }
            sweep-col := VerticalLayout {
                spacing: 12px;
                Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: 34px * Metrics.type-scale;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: Sweep.sweep-to-label;
                        font-size: 12px * Metrics.type-scale;
                        color: Pal.muted;
                        overflow: elide;
                    }
                }
                if Sweep.sweep-dest-note != "": Caption { text: Sweep.sweep-dest-note; color: Pal.warn; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    SelectPill { text: "economy"; active: Sweep.sweep-tier == 0; clicked => { Sweep.set-sweep-tier(0); } }
                    SelectPill { text: "normal"; active: Sweep.sweep-tier == 1; clicked => { Sweep.set-sweep-tier(1); } }
                    SelectPill { text: "fast"; active: Sweep.sweep-tier == 2; clicked => { Sweep.set-sweep-tier(2); } }
                    SelectPill { text: "custom"; active: Sweep.sweep-tier == 3; clicked => { Sweep.sweep-tier = 3; Sweep.sweep-rate-changed(); } }
                }
                if Sweep.sweep-tier == 3: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    EditField {
                        width: 84px * Metrics.type-scale;
                        text <=> Sweep.sweep-rate-text;
                        edited => { Sweep.sweep-rate-changed(); }
                    }
                    Caption { text: "sat/vB"; vertical-alignment: center; }
                }
                if Sweep.sweep-cost-line != "": Text {
                    text: Sweep.sweep-cost-line;
                    font-size: 13px * Metrics.type-scale;
                    font-weight: 600;
                    color: Pal.accent;
                }
                // ---- pay the fee from another wallet (watch-only: the
                // external signer's full-value transfer needs it; keyed
                // sweeps pay their own fee out of the swept amount) ----
                if Ui.watch-only: HorizontalLayout {
                    Switch {
                        text: "Pay the fee from another wallet";
                        checked <=> Sweep.sweep-fund-external;
                        toggled => { Sweep.toggle-sweep-fund-external(self.checked); }
                    }
                    Rectangle { }
                }
                if Sweep.sweep-fund-external: Caption {
                    text: "The full balance arrives at the destination. The fee comes out of the funding wallet; its change returns there.";
                }
                if Sweep.sweep-fund-external: Rectangle {
                    border-radius: 10px;
                    background: sftap.has-hover ? Pal.card-hover : Pal.card;
                    border-width: 1px;
                    border-color: Ui.funding-ready ? Pal.line : Pal.accent.with-alpha(0.5);
                    height: 44px * Metrics.type-scale;
                    sftap := TouchArea { clicked => { Ui.funding-return = Screen.sweep; Ui.open-funding(); } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: Sweep.funding-summary;
                            font-size: 12px * Metrics.type-scale;
                            color: Ui.funding-ready ? Pal.text : Pal.accent;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text { text: "›"; font-size: 22px * Metrics.type-scale; color: Pal.muted; vertical-alignment: center; }
                    }
                }
                // ---- inputs (read-only: a sweep spends everything) ----
                Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: sw-in-col.preferred-height;
                    sw-in-col := VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Rectangle {
                            height: 22px * Metrics.type-scale;
                            TouchArea { clicked => { Sweep.sweep-inputs-expanded = !Sweep.sweep-inputs-expanded; } }
                            HorizontalLayout {
                                Text {
                                    text: Sweep.sweep-inputs-title;
                                    font-size: 12px * Metrics.type-scale;
                                    color: Pal.muted;
                                    vertical-alignment: center;
                                }
                                Rectangle { }
                                Image {
                                    source: Sweep.sweep-inputs-expanded
                                        ? @image-url("../icons/caret-up.svg")
                                        : @image-url("../icons/caret-down.svg");
                                    colorize: Pal.muted;
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - 16px) / 2;
                                }
                            }
                        }
                        if Sweep.sweep-inputs-expanded: Caption {
                            text: "A sweep spends every spendable coin, so the inputs are fixed.";
                        }
                        if Sweep.sweep-inputs-expanded: VerticalLayout {
                            spacing: 6px;
                            for c in Sweep.sweep-coins: Rectangle {
                                height: 42px * Metrics.type-scale;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Pal.accent;
                                background: Pal.accent.with-alpha(0.10);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: c.value + " sats";
                                            font-size: 12px * Metrics.type-scale;
                                            color: Pal.text;
                                        }
                                    }
                                    Rectangle { }
                                    VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            label: c.confirmed ? "confirmed" : "unconfirmed";
                                            tint: c.confirmed ? Pal.good : Pal.warn;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 22px * Metrics.type-scale;
                                            width: swpill.preferred-width + 14px;
                                            border-radius: 11px;
                                            border-width: 1px;
                                            border-color: Pal.line;
                                            background: swpta.has-hover && c.explorer != "" ? Pal.card-hover : transparent;
                                            swpta := TouchArea {
                                                clicked => { if (c.explorer != "") { Ui.act-explorer(c.explorer); } }
                                            }
                                            swpill := HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 7px;
                                                spacing: 4px;
                                                Text {
                                                    text: c.txid-short;
                                                    font-family: "Menlo";
                                                    font-size: 10px * Metrics.type-scale;
                                                    color: Pal.muted;
                                                    vertical-alignment: center;
                                                }
                                                if c.explorer != "": Image {
                                                    source: @image-url("../icons/external.svg");
                                                    colorize: Pal.accent;
                                                    width: 11px;
                                                    height: 11px;
                                                    y: (parent.height - 11px) / 2;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                // ---- locktime override (collapsible), right before Sign ----
                Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: swlt-col.preferred-height;
                    swlt-col := VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Rectangle {
                            height: 22px * Metrics.type-scale;
                            TouchArea { clicked => { Sweep.sweep-locktime-expanded = !Sweep.sweep-locktime-expanded; } }
                            HorizontalLayout {
                                Text {
                                    text: "Locktime · " + (Sweep.sweep-locktime-mode == "tip" ? "chain height"
                                        : Sweep.sweep-locktime-mode == "zero" ? "zero"
                                        : "custom " + Sweep.sweep-locktime-height);
                                    font-size: 12px * Metrics.type-scale;
                                    color: Pal.muted;
                                    vertical-alignment: center;
                                }
                                Rectangle { }
                                Image {
                                    source: Sweep.sweep-locktime-expanded
                                        ? @image-url("../icons/caret-up.svg")
                                        : @image-url("../icons/caret-down.svg");
                                    colorize: Pal.muted;
                                    width: 16px;
                                    height: 16px;
                                }
                            }
                        }
                        if Sweep.sweep-locktime-expanded: HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            SelectPill {
                                text: "Chain height";
                                active: Sweep.sweep-locktime-mode == "tip";
                                clicked => { Sweep.set-sweep-locktime("tip", Sweep.sweep-locktime-height); }
                            }
                            SelectPill {
                                text: "Zero";
                                active: Sweep.sweep-locktime-mode == "zero";
                                clicked => { Sweep.set-sweep-locktime("zero", Sweep.sweep-locktime-height); }
                            }
                            SelectPill {
                                text: "Custom";
                                active: Sweep.sweep-locktime-mode == "custom";
                                clicked => { Sweep.set-sweep-locktime("custom", Sweep.sweep-locktime-height); }
                            }
                        }
                        if Sweep.sweep-locktime-expanded && Sweep.sweep-locktime-mode == "custom": HorizontalLayout {
                            spacing: 8px;
                            EditField {
                                width: 130px * Metrics.type-scale;
                                text <=> Sweep.sweep-locktime-height;
                                placeholder-text: "block height";
                                accepted(t) => { Sweep.set-sweep-locktime("custom", t); }
                            }
                            Caption { text: "height · press Return to apply"; vertical-alignment: center; }
                        }
                        if Sweep.sweep-locktime-expanded: Caption { text: Sweep.sweep-locktime-effective; }
                        if Sweep.sweep-locktime-warn != "": Caption { text: Sweep.sweep-locktime-warn; color: Pal.warn; }
                    }
                }
                if !Sweep.sweep-fund-external && !Ui.watch-only: PrimaryButton {
                    text: Ui.wallet-scan-busy ? "Syncing…"
                        : Ui.sweep-kind == "consolidate" ? "Consolidate — sign + review…" : "Sweep — sign + review…";
                    tint: Ui.wallet-scan-busy ? Pal.faint : Pal.accent;
                    tint-hover: Ui.wallet-scan-busy ? Pal.faint : Pal.accent-hover;
                    clicked => { if (!Ui.wallet-scan-busy) { Sweep.sweep-send(); } }
                }
                if !Sweep.sweep-fund-external && Ui.watch-only: PrimaryButton {
                    text: Ui.wallet-scan-busy ? "Syncing…" : "Build transaction to sign";
                    tint: Ui.wallet-scan-busy ? Pal.faint : Pal.accent;
                    tint-hover: Ui.wallet-scan-busy ? Pal.faint : Pal.accent-hover;
                    clicked => { if (!Ui.wallet-scan-busy) { Sweep.sweep-send(); } }
                }
                if Sweep.sweep-fund-external: PrimaryButton {
                    text: !Ui.funding-ready ? "Set a funding wallet first"
                        : Ui.wallet-scan-busy ? "Syncing…" : "Build transaction to sign";
                    tint: (Ui.funding-ready && Ui.wallet-scan-busy) ? Pal.faint : Pal.accent;
                    tint-hover: (Ui.funding-ready && Ui.wallet-scan-busy) ? Pal.faint : Pal.accent-hover;
                    clicked => {
                        if (!Ui.funding-ready) {
                            Ui.funding-return = Screen.sweep;
                            Ui.open-funding();
                        } else if (!Ui.wallet-scan-busy) {
                            Sweep.sweep-send();
                        }
                    }
                }
                Caption { text: Ui.status; color: Pal.bad; }
            }
        }
    }

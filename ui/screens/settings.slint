// Screen.settings -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- 8 · settings ----------

import { Ui, Terms, Settings, Note, Change, Sweep, Coins, Compose } from "../globals.slint";
import { Caption, Mono, GhostButton, SvgIconButton, Header, CopyButton, QrArea, SelectPill, Dropdown, SettingsCard } from "../components.slint";
import { EditField } from "../edit.slint";
import { Pal, Metrics } from "../theme.slint";
import { Switch } from "std-widgets.slint";

export component SettingsScreen inherits VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            // Compose's "Edit compose defaults…" row opens this screen
            // filtered to just the "Compose defaults" card (PLAN-graffito-
            // compose-simplify.md, Sal: "opens the settings screen, but
            // only the subset of compose settings") — the header names
            // that subset instead of the generic "Settings" title. Sync
            // stays off in that mode: it's not a wallet-wide screen here.
            title: Settings.settings-compose-only ? "Compose defaults" : "Settings";
            show-sync: !Settings.settings-compose-only;
            net-busy: Ui.net-busy;
            back => { Ui.nav-back-nonce += 1; }
            sync => { Ui.refresh-notebooks(); }
            busy-tapped => { Ui.sync-busy-toast(); }
        }
        Flickable {
            viewport-height: settings-col.preferred-height;
            viewport-y <=> Settings.settings-scroll-y;
            // Dismiss layer (see the global one under back-scope): the
            // Flickable intercepts its whole region, so the global layer
            // can't reach the gaps between these cards — the node-URL and
            // explorer-URL fields below would otherwise trap the keyboard.
            TouchArea {
                width: parent.width;
                height: settings-col.preferred-height;
                clicked => { Ui.focus-back-scope-nonce += 1; }
            }
            settings-col := VerticalLayout {
                spacing: 12px;
                alignment: start;
        if !Settings.settings-compose-only: SettingsCard {
            title: "Identity";
            // Wallet-level on purpose: no per-notebook account or address
            // here (notebooks own those); kind · network · notebook count.
            subtitle: Settings.settings-identity;
            if Settings.settings-hierarchical: GhostButton {
                text: "Change account…";
                clicked => { Settings.open-account-picker(); }
            }
            GhostButton {
                text: "Switch identity — new seed or different key…";
                clicked => { Ui.show-reset-confirm = true; }
            }
        }
        if Ui.apple-platform && !Settings.settings-compose-only: SettingsCard {
            title: "iCloud backup";
            subtitle: "Sync your key to iCloud Keychain — it's restored automatically after a reinstall or on your other Apple devices. Reveal still needs Face ID.";
            if Ui.icloud-enabled: Switch {
                text: "Back up to iCloud";
                checked <=> Ui.icloud-backup;
                toggled => { Ui.set-icloud-backup(Ui.icloud-backup); }
            }
            if !Ui.icloud-enabled: Caption {
                text: "iCloud is off on this device — sign into iCloud with iCloud Keychain to enable backup.";
                color: Pal.warn;
            }
        }
        if !Settings.settings-compose-only: SettingsCard {
            title: "Network";
            subtitle: "Which chain this notebook lives on. Every network keeps its own separate notebook for the same key.";
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill { text: "mainnet"; active: Settings.settings-network == "mainnet"; clicked => { Settings.set-network("mainnet"); } }
                SelectPill { text: "testnet4"; active: Settings.settings-network == "testnet4"; clicked => { Settings.set-network("testnet4"); } }
                SelectPill { text: "signet"; active: Settings.settings-network == "signet"; clicked => { Settings.set-network("signet"); } }
                SelectPill { text: "regtest"; active: Settings.settings-network == "regtest"; clicked => { Settings.set-network("regtest"); } }
            }
        }
        // The chain-connection group: which chain, the server that reads
        // and writes it, and where its links open. These three belong
        // together — node and explorer used to sit ~9 cards below Network
        // (Sal, 2026-09-10 iOS pass).
        if !Settings.settings-compose-only: SettingsCard {
            title: "Bitcoin node" + ((Ui.node-is-core || Ui.node-is-electrum) ? " · " + Ui.node-backend-label : "");
            subtitle: "Scans and broadcasts go through this server — it learns your address and IP. Pick a provider, point at your own Esplora/mempool-compatible node, choose Electrum server for a personal electrs (the one Sparrow uses), or choose Bitcoin Core and enter your node's address (RPC credentials below, never stored in this URL).";
            Dropdown {
                options: Ui.node-options;
                current-index: Ui.node-index;
                selected(i) => { Ui.node-index = i; Settings.set-node-preset(i); }
            }
            // "Bitcoin Core" row (U12, second-to-last option — see
            // `node-core-row-selected` above): a plain address field, no
            // storage prefix in sight. "Custom…" (last option, unchanged)
            // stays the free-text Esplora URL field.
            if Settings.node-core-row-selected: EditField {
                text <=> Ui.node-address-text;
                placeholder-text: "192.168.1.10:8332  or  umbrel.local";
                edited(t) => { Settings.node-address-dirty = true; }
                accepted(t) => { Settings.node-address-dirty = false; Settings.set-node-address(t); }
                // Commit on focus loss too — see node-address-dirty above.
                // Empty is never auto-committed: clearing the field and
                // pressing Return stays the explicit way to unset it, so
                // tabbing through an empty field can't wipe a stored node.
                changed has-focus => {
                    if (!self.has-focus && Settings.node-address-dirty && self.text != "") {
                        Settings.node-address-dirty = false;
                        Settings.set-node-address(self.text);
                    }
                }
            }
            // "Electrum server" row: host[:port] of a personal electrs — no
            // credentials, no watch wallet, nothing imported on the server.
            if Settings.node-electrum-row-selected: EditField {
                text <=> Ui.node-address-text;
                placeholder-text: "192.168.1.10:50001  or  umbrel.local";
                edited(t) => { Settings.node-address-dirty = true; }
                accepted(t) => { Settings.node-address-dirty = false; Settings.set-node-electrum-address(t); }
                changed has-focus => {
                    if (!self.has-focus && Settings.node-address-dirty && self.text != "") {
                        Settings.node-address-dirty = false;
                        Settings.set-node-electrum-address(self.text);
                    }
                }
            }
            if Settings.node-electrum-row-selected: Caption {
                text: "Plain TCP to your electrs (the server Sparrow connects to) — use Tailscale, Tor, or an SSH tunnel unless it's on localhost. Your server has no price oracle — USD estimates stay hidden while it's active.";
                wrap: word-wrap;
            }
            if Ui.node-index == Ui.node-options.length - 1: EditField {
                text <=> Settings.node-custom-text;
                placeholder-text: "https://mempool.example/api";
                edited(t) => { Settings.node-custom-dirty = true; }
                accepted(t) => { Settings.node-custom-dirty = false; Settings.set-node-custom(t); }
                changed has-focus => {
                    if (!self.has-focus && Settings.node-custom-dirty && self.text != "") {
                        Settings.node-custom-dirty = false;
                        Settings.set-node-custom(self.text);
                    }
                }
            }
            // FLATTENED (2026-07-29, U11): every row below used to live
            // inside a single `if Ui.node-is-core: VerticalLayout { … }`
            // — a nested layout whose OWN preferred-height didn't reliably
            // propagate up to this SettingsCard's `height: l.preferred-
            // height` binding when a row inside it changed size AFTER the
            // settings screen's first layout pass (which is exactly what
            // the node-health line does — it starts empty, then flips to
            // a real result either synchronously from `set-node-custom`/
            // `set-node-core-creds` or asynchronously from
            // `refresh_node_health`'s worker thread). Symptom: a short
            // one-line health result got ZERO visible height (fully
            // invisible — the worst failure mode for text that tells a
            // user their node is pruned or missing txindex), and a longer
            // wrapped result was clipped mid-glyph, bleeding into the
            // "Block explorer" card below. Nesting the health Caption one
            // level deeper still (a second `if`) only made it worse — it
            // landed on the SAME row as the "Save credentials" button
            // instead of after it. Neither a sibling `if` at the card level
            // NOR switching the innermost Caption to `visible:` (keeping it
            // permanently in the tree) fixed the card's height — the bug
            // lives in the NESTED VerticalLayout itself, not in how its
            // last child is toggled. Removing that nested layout — making
            // every row here a DIRECT child of the SettingsCard's own `l`
            // layout, each individually gated by its own `if …: …`
            // (repeating the condition, exactly the single-`if`-depth shape
            // the iCloud-backup card's working `if !Ui.icloud-enabled:
            // Caption` above already uses) — is what actually fixes it: `l`
            // now sees every row as one of its own direct children, so its
            // preferred-height always includes whichever are currently
            // shown, at any point after the first paint. `l`'s own 8px
            // spacing (SettingsCard) reproduces the nested layout's old
            // `spacing: 8px` unchanged. U12 switched every gate below from
            // `Ui.node-is-core` (the ACTUALLY ACTIVE backend) to
            // `Settings.node-core-row-selected` (the dropdown row being
            // browsed) — picking "Bitcoin Core" must reveal these rows
            // immediately, before any address has been submitted, same as
            // "Custom…" already reveals its own field on selection alone.
            if Settings.node-core-row-selected: Caption {
                text: "RPC username and password — stored in the device Keychain, never in app settings. Credentials cross the network in plaintext over http:// — use Tailscale, Tor, or an SSH tunnel unless this node is on localhost.";
                wrap: word-wrap;
            }
            if Settings.node-core-row-selected: Caption {
                text: "Your node has no price oracle — USD estimates stay hidden while it's active, so no third-party price lookup happens either.";
                wrap: word-wrap;
            }
            if Settings.node-core-row-selected: HorizontalLayout {
                spacing: 8px;
                EditField {
                    text <=> Settings.node-core-user;
                    placeholder-text: "RPC username";
                    accepted(t) => { Settings.set-node-core-creds(Settings.node-core-user, Settings.node-core-pass); }
                }
                EditField {
                    text <=> Settings.node-core-pass;
                    placeholder-text: "RPC password";
                    input-type: password;
                    accepted(t) => { Settings.set-node-core-creds(Settings.node-core-user, Settings.node-core-pass); }
                }
            }
            if Settings.node-core-row-selected: Switch {
                text: "Save credentials to Keychain";
                checked <=> Settings.node-core-save-creds;
                toggled => { Settings.set-node-core-save-creds(Settings.node-core-save-creds); }
            }
            if Settings.node-core-row-selected && !Settings.node-core-save-creds: Caption {
                text: "Credentials stay in memory for this session only — you'll re-enter them next launch.";
                color: Pal.muted;
                wrap: word-wrap;
            }
            if Settings.node-core-row-selected: GhostButton {
                text: "Save credentials";
                clicked => { Settings.set-node-core-creds(Settings.node-core-user, Settings.node-core-pass); }
            }
            if (Settings.node-core-row-selected || Settings.node-electrum-row-selected) && Settings.node-health-text != "": Caption {
                text: Settings.node-health-text;
                color: Ui.node-health-warn ? Pal.warn : Pal.muted;
                wrap: word-wrap;
            }
        }
        if !Settings.settings-compose-only: SettingsCard {
            title: "Block explorer";
            subtitle: "Where the app's Explorer links open a transaction. Pick a site or use your own (e.g. a self-hosted mempool); the link becomes <base>/tx/<txid>.";
            Dropdown {
                options: Settings.explorer-options;
                current-index: Settings.explorer-index;
                selected(i) => { Settings.explorer-index = i; Settings.set-explorer-preset(i); }
            }
            if Settings.explorer-index == Settings.explorer-options.length - 1: EditField {
                text <=> Settings.explorer-custom-text;
                placeholder-text: "https://your-mempool-host  (no trailing /tx)";
                edited(t) => { Settings.explorer-custom-dirty = true; }
                accepted(t) => { Settings.explorer-custom-dirty = false; Settings.set-explorer-custom(t); }
                changed has-focus => {
                    if (!self.has-focus && Settings.explorer-custom-dirty && self.text != "") {
                        Settings.explorer-custom-dirty = false;
                        Settings.set-explorer-custom(self.text);
                    }
                }
            }
        }
        if !Settings.settings-compose-only: SettingsCard {
            title: "Note size limit";
            subtitle: "Largest OP_RETURN chunk per output. Standard suits modern relays (Core v30+). If a broadcast is rejected, switch to 80 compat and recompose.";
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill {
                    text: "Standard";
                    active: !Settings.chunk-custom && Settings.chunk-text == "100000";
                    clicked => { Settings.set-chunk("100000"); }
                }
                SelectPill {
                    text: "80 compat";
                    active: !Settings.chunk-custom && Settings.chunk-text == "80";
                    clicked => { Settings.set-chunk("80"); }
                }
                SelectPill {
                    text: "Custom";
                    active: Settings.chunk-custom || (Settings.chunk-text != "100000" && Settings.chunk-text != "80");
                    clicked => { Settings.chunk-custom = true; }
                }
            }
            if Settings.chunk-custom || (Settings.chunk-text != "100000" && Settings.chunk-text != "80"): HorizontalLayout {
                spacing: 8px;
                EditField {
                    width: 130px * Metrics.type-scale;
                    text <=> Settings.chunk-text;
                    placeholder-text: "20 – 100000";
                    accepted(t) => { Settings.set-chunk(t); }
                }
                Caption { text: "bytes · press Return to apply"; vertical-alignment: center; }
            }
        }
        // ---- Compose defaults (PLAN-graffito-compose-simplify.md) ----
        // Policy set once here; the Compose screen's status-strip pills +
        // gear card only override a given note, never these.
        SettingsCard {
            title: "Compose defaults";
            // In the subset view the screen HEADER already reads "Compose
            // defaults" — showing it again on the card looked like a
            // duplicate, so only the title row is suppressed there.
            hide-title: Settings.settings-compose-only;
            subtitle: "What a fresh note starts with. Override any one of these per note from Compose's status strip or gear icon — the override dies with that note.";
            Caption { text: "New notes"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill {
                    text: "Private";
                    active: Settings.compose-default-visibility == "private";
                    clicked => { Settings.set-compose-default-visibility("private"); }
                }
                SelectPill {
                    text: "Public";
                    active: Settings.compose-default-visibility == "public";
                    clicked => { Settings.set-compose-default-visibility("public"); }
                }
            }
            Caption { text: "Fee"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill { text: "economy"; active: Settings.compose-default-fee-tier == "economy"; clicked => { Settings.set-compose-default-fee("economy", Settings.compose-default-fee-rate); } }
                SelectPill { text: "normal"; active: Settings.compose-default-fee-tier == "normal"; clicked => { Settings.set-compose-default-fee("normal", Settings.compose-default-fee-rate); } }
                SelectPill { text: "fast"; active: Settings.compose-default-fee-tier == "fast"; clicked => { Settings.set-compose-default-fee("fast", Settings.compose-default-fee-rate); } }
                SelectPill { text: "custom"; active: Settings.compose-default-fee-tier == "custom"; clicked => { Settings.set-compose-default-fee("custom", Settings.compose-default-fee-rate); } }
            }
            if Settings.compose-default-fee-tier == "custom": HorizontalLayout {
                spacing: 8px;
                EditField {
                    width: 100px * Metrics.type-scale;
                    text <=> Settings.compose-default-fee-rate;
                    placeholder-text: "sat/vB";
                    input-type: number;
                    accepted(t) => { Settings.set-compose-default-fee("custom", t); }
                }
                Caption { text: "sat/vB · press Return to apply"; vertical-alignment: center; }
            }
            Caption { text: "Gift to recipients"; }
            HorizontalLayout {
                spacing: 8px;
                EditField {
                    width: 100px * Metrics.type-scale;
                    text <=> Settings.compose-default-gift;
                    placeholder-text: "sats";
                    input-type: number;
                    accepted(t) => { Settings.set-compose-default-gift(t); }
                    changed has-focus => {
                        if (!self.has-focus) { Settings.set-compose-default-gift(self.text); }
                    }
                }
                Caption { text: "sats · minimum 330 (dust)"; vertical-alignment: center; }
            }
            if Settings.compose-default-gift-error != "": Caption {
                text: Settings.compose-default-gift-error;
                color: Pal.bad;
            }
            Caption { text: "Pay from"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill { text: "Notebook"; active: Settings.compose-default-payfrom == "notebook"; clicked => { Settings.set-compose-default-payfrom("notebook"); } }
                if Ui.spending-capable: SelectPill { text: "Spending wallet"; active: Settings.compose-default-payfrom == "spending"; clicked => { Settings.set-compose-default-payfrom("spending"); } }
                SelectPill { text: "Ask each time"; active: Settings.compose-default-payfrom == "ask"; clicked => { Settings.set-compose-default-payfrom("ask"); } }
            }
            Caption { text: "Coin selection"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill { text: "Fewest coins"; active: Settings.compose-default-coins == "fewest"; clicked => { Settings.set-compose-default-coins("fewest"); } }
                SelectPill { text: "Consolidate"; active: Settings.compose-default-coins == "consolidate"; clicked => { Settings.set-compose-default-coins("consolidate"); } }
            }
            Caption { text: "Quantum encryption"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill { text: "On when available"; active: Settings.compose-default-pq-mlkem == "on"; clicked => { Settings.set-compose-default-pq-mlkem("on"); } }
                SelectPill { text: "Off"; active: Settings.compose-default-pq-mlkem == "off"; clicked => { Settings.set-compose-default-pq-mlkem("off"); } }
            }
            Caption { text: "Passphrase cost"; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill { text: "Standard"; active: Compose.pq-pw-cost == "standard"; clicked => { Compose.pq-pw-cost-changed("standard"); } }
                SelectPill { text: "Strong"; active: Compose.pq-pw-cost == "strong"; clicked => { Compose.pq-pw-cost-changed("strong"); } }
                SelectPill { text: "Maximum"; active: Compose.pq-pw-cost == "maximum"; clicked => { Compose.pq-pw-cost-changed("maximum"); } }
            }
            Caption { text: Compose.pq-pw-cost-caption; }
        }
        if !Settings.settings-compose-only: SettingsCard {
            title: "Transaction locktime";
            subtitle: "Most wallets stamp the current block height, which discourages a re-org from stealing your fee and helps your transactions blend in. Zero is the simplest and what this app used to do.";
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill {
                    text: "Chain height";
                    active: Settings.locktime-mode == "tip";
                    clicked => { Settings.set-locktime("tip", Settings.locktime-text); }
                }
                SelectPill {
                    text: "Zero";
                    active: Settings.locktime-mode == "zero";
                    clicked => { Settings.set-locktime("zero", Settings.locktime-text); }
                }
                SelectPill {
                    text: "Custom";
                    active: Settings.locktime-mode == "custom";
                    clicked => { Settings.set-locktime("custom", Settings.locktime-text); }
                }
            }
            if Settings.locktime-mode == "custom": HorizontalLayout {
                spacing: 8px;
                EditField {
                    width: 130px * Metrics.type-scale;
                    text <=> Settings.locktime-text;
                    placeholder-text: "block height";
                    accepted(t) => { Settings.set-locktime("custom", t); }
                }
                Caption { text: "height · press Return to apply"; vertical-alignment: center; }
            }
            Caption { text: Settings.locktime-effective; }
        }
        if !Settings.settings-compose-only: SettingsCard {
            title: "Coins";
            subtitle: Settings.coins-summary-settings;
            GhostButton {
                text: "View wallet coins…";
                // This card summarizes NOTEBOOK coins, so always land on that
                // segment — without the reset, arriving after the spending
                // card's "View in Coins…" kept the spending segment active.
                clicked => { Ui.coins-segment = "notebook"; Settings.open-coins(); }
            }
        }
        if Ui.spending-capable && !Settings.settings-compose-only: SettingsCard {
            title: "Separate spending wallet";
            subtitle: "Fresh bc1q addresses hold your funds instead of the notebook — protects your balance and pubkey behind the fresh-address discipline (costs slightly more per note). A shared spending pool publicly links the notes it pays for.";
            HorizontalLayout {
                Switch {
                    text: Ui.spending-enabled ? "On" : "Off";
                    checked <=> Ui.spending-enabled;
                    toggled => { Settings.set-spending-enabled(Ui.spending-enabled); }
                }
                Rectangle { }
            }
            if Ui.spending-enabled: Rectangle {
                border-radius: 10px;
                background: Pal.field;
                border-width: 1px;
                border-color: Pal.line;
                height: spending-card-col.preferred-height;
                spending-card-col := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text {
                            text: Ui.spending-balance-line;
                            font-size: 13px * Metrics.type-scale;
                            font-weight: 700;
                            color: Pal.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        SvgIconButton { icon: "refresh"; size: 14px; width: 28px; height: 22px; clicked => { Settings.spending-refresh(); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            background: white;
                            border-radius: 6px;
                            QrArea {
                                img: Settings.spending-qr;
                                qr-size: 58px;
                                x: 3px;
                                y: 3px;
                            }
                            TouchArea {
                                clicked => {
                                    Ui.qr-zoom-image = Settings.spending-qr;
                                    Ui.qr-zoom-open = true;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Caption { text: "Next receive address"; }
                            HorizontalLayout {
                                spacing: 4px;
                                Mono {
                                    text: Settings.spending-address;
                                    font-size: 10px * Metrics.type-scale;
                                    color: Pal.muted;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    CopyButton { clicked => { Ui.copy-text("address", Settings.spending-address); } }
                                }
                            }
                        }
                    }
                    GhostButton {
                        text: "Sweep notebook funds here…";
                        clicked => { Settings.spending-sweep-here(); }
                    }
                    GhostButton {
                        text: "View in Coins…";
                        // Through the callback, NOT a direct property write —
                        // set-coins-segment kicks the spending scan when the
                        // cache is cold (first-time View-in-Coins showed an
                        // empty spending list otherwise).
                        clicked => { Ui.set-coins-segment("spending"); Settings.open-coins(); }
                    }
                }
            }
        }
        if !Settings.settings-compose-only: SettingsCard {
            title: "Sweep wallet";
            subtitle: Ui.watch-only
                ? "Leaving this wallet: move everything (minus the fee) to an address you choose. Watch-only: you'll sign on your external wallet."
                : "Leaving this wallet: EVERY notebook's coins go to an address you choose, in one transaction (minus the fee). To move coins between notebooks, use Consolidate instead.";
            GhostButton {
                text: "Sweep wallet…";
                clicked => { Settings.sweep-open(); }
            }
        }
        if !Settings.settings-compose-only: SettingsCard {
            title: "Dangerous area";
            subtitle: Ui.watch-only
                ? "This is a watch-only identity — only public material (xpub / descriptor) can be revealed here. It can't spend and can't read private notes."
                : "Export this notebook's keys — to back them up, or move them to another wallet. Private material controls the funds and every private note: protect it like cash.";
            if Settings.reveal-can-public: GhostButton { text: "Public keys"; clicked => { Settings.reveal-public(); } }
            if !Ui.watch-only: GhostButton {
                text: "Private keys";
                clicked => { Settings.reveal-private(); }
            }
        }
        // Hidden for watch-only, same reasoning as "Private keys" above —
        // no leaf secret on a watch-only identity, so no derived ML-KEM
        // receive key to manage either.
        if !Ui.watch-only && !Settings.settings-compose-only: SettingsCard {
            title: "Quantum keys";
            subtitle: "A post-quantum receive key for this notebook (ML-KEM), added on top of your normal note encryption so directed notes to you can add hybrid protection against a future quantum computer.";
            GhostButton { text: "Manage quantum keys…"; clicked => { Settings.open-pq-keys(); } }
        }
        if !Settings.settings-compose-only: SettingsCard {
            title: "About & help";
            subtitle: "What Graffito is, how it handles your privacy, how to use it, and the terms you accepted.";
            GhostButton { text: "About"; clicked => { Settings.open-info("about"); } }
            GhostButton { text: "Help"; clicked => { Settings.open-info("help"); } }
            GhostButton { text: "Q & A"; clicked => { Settings.open-info("faq"); } }
            GhostButton { text: "Source code"; clicked => { Settings.open-source(); } }
            GhostButton { text: "Privacy"; clicked => { Settings.open-info("privacy"); } }
            GhostButton { text: "Terms & disclaimer"; clicked => { Settings.open-info("terms"); } }
        }
        // Key-protection downgrade (audit M2). Deliberately the LAST card:
        // it appears and disappears with device state, and anything above it
        // would shift under the e2e suites' calibrated tap offsets.
        if Settings.key-protection-degraded && !Settings.settings-compose-only: SettingsCard {
            // No glyph in the title: the icon rule (femtovg has no font
            // fallback) makes "⚠" tofu on Android's stricter renderer.
            title: "Key not protected by this device";
            subtitle: "Your key is stored without the operating system's Face ID / Touch ID lock, so the app is guarding it on its own. This normally means an unsigned development build. If you see this in an App Store build, move your funds using your recovery phrase and reinstall.";
        }
        if Ui.status != "": Caption { text: Ui.status; color: Pal.bad; }
        // Signature tagline — last thing under every settings card, centered
        // with breathing room above and below. Skipped in the compose-only
        // subset (Sal: just the one card) — it reads oddly floating under a
        // single card, and the harness re-measure never needs to find it there.
        if !Settings.settings-compose-only: VerticalLayout {
            padding-top: 20px;
            padding-bottom: 28px;
            Text {
                text: "For bitcoiners by bitcoiners";
                horizontal-alignment: center;
                color: Pal.muted;
                font-size: 12px * Metrics.type-scale;
                font-italic: true;
            }
        }
            }
        }
    }

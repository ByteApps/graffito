// Screen.notebooks -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- 17 · notebooks (the main screen) ----------

import { Ui, Notebooks } from "../globals.slint";
import { Caption, PrimaryButton, GhostButton, IconButton, SvgIconButton, SyncButton, Badge, PencilButton } from "../components.slint";
import { Pal, Metrics } from "../theme.slint";

export component NotebooksScreen inherits VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 40px;
            Text {
                text: "Graffito";
                font-size: 19px * Metrics.type-scale;
                font-weight: 700;
                color: Pal.text;
                vertical-alignment: center;
            }
            Rectangle { }
            SyncButton {
                net-busy: Ui.net-busy;
                sync => { Ui.refresh-notebooks(); }
                busy-tapped => { Ui.sync-busy-toast(); }
            }
            SvgIconButton { icon: "activity"; clicked => { Ui.open-activity(); } }
            IconButton { glyph: "⚙"; clicked => { Notebooks.settings-open(); } }
        }
        if Notebooks.can-create-notebook: PrimaryButton { text: "+  New notebook"; clicked => { Notebooks.create-notebook(); } }
        Caption { text: Ui.status; }
        // Zero active notebooks is a legitimate state (fresh start, or
        // everything archived) — say so instead of showing a blank page.
        if Ui.notebooks.length == 0: Caption {
            text: Notebooks.archived-toggle-label != ""
                ? "All notebooks are archived."
                : (Notebooks.can-create-notebook
                    ? "No notebooks yet — create one to start writing."
                    : "No notebooks yet.");
        }
        Flickable {
            viewport-height: nb-col.preferred-height;
            nb-col := VerticalLayout {
                alignment: start;
                spacing: 6px;
                for nb in Ui.notebooks: Rectangle {
                    height: 86px * Metrics.type-scale;
                    nb-ta := TouchArea { clicked => { Notebooks.open-notebook(nb.index); } }
                    Rectangle {
                        y: 2px;
                        height: parent.height - 6px;
                        border-radius: 10px;
                        background: nb-ta.has-hover ? Pal.card-hover : Pal.card;
                        border-width: 1px;
                        border-color: nb.active ? Pal.accent.with-alpha(0.55) : Pal.line;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 4px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: nb.name;
                                        font-size: 14px * Metrics.type-scale;
                                        font-weight: 700;
                                        color: Pal.text;
                                        overflow: elide;
                                    }
                                    if nb.unread != "": Badge { label: nb.unread; tint: Pal.good; }
                                }
                                Caption { text: nb.snippet; overflow: elide; }
                                Caption { text: nb.meta; color: Pal.faint; }
                            }
                            VerticalLayout {
                                alignment: center;
                                PencilButton { clicked => { Notebooks.nb-rename-start(nb.index, nb.name); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                SvgIconButton {
                                    icon: "archive";
                                    size: 15px;
                                    width: 32px;
                                    height: 32px;
                                    clicked => { Notebooks.nb-archive(nb.index, true); }
                                }
                            }
                        }
                    }
                }
                if Notebooks.archived-toggle-label != "": Rectangle {
                    height: 34px * Metrics.type-scale;
                    arch-ta := TouchArea { clicked => { Notebooks.show-archived = !Notebooks.show-archived; } }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Caption { text: Notebooks.archived-toggle-label; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: Notebooks.show-archived
                                    ? @image-url("../icons/caret-up.svg")
                                    : @image-url("../icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 12px;
                                height: 12px;
                            }
                        }
                    }
                }
                if Notebooks.show-archived: VerticalLayout {
                    spacing: 6px;
                    for nb in Notebooks.archived-notebooks: Rectangle {
                        height: 56px * Metrics.type-scale;
                        anb-ta := TouchArea { clicked => { Notebooks.open-notebook(nb.index); } }
                        Rectangle {
                            y: 2px;
                            height: parent.height - 6px;
                            border-radius: 10px;
                            background: anb-ta.has-hover ? Pal.card-hover : Pal.card;
                            border-width: 1px;
                            border-color: Pal.line;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: nb.name;
                                        font-size: 13px * Metrics.type-scale;
                                        color: Pal.muted;
                                        overflow: elide;
                                    }
                                    Caption { text: nb.meta; color: Pal.faint; }
                                }
                                Rectangle { }
                                VerticalLayout {
                                    alignment: center;
                                    GhostButton { text: "Restore"; clicked => { Notebooks.nb-archive(nb.index, false); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

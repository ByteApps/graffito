// Screen.entropy-source -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- 27 · where does the entropy come from? ----------
// Two doors, same pattern as onboarding. Reached from every "Create a new
// N-word seed" door — creation no longer generates immediately, because
// "the device rolled it for you, trust us" is exactly the thing a bitcoin
// user may not want to trust.

import { Ui, Dice, EntropySource } from "../globals.slint";
import { Caption, Header, DoorCard } from "../components.slint";
import { Pal } from "../theme.slint";

export component EntropySourceScreen inherits VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "New " + Ui.new-word-count + "-word seed";
            back => { Ui.nav-back-nonce += 1; }
        }
        Caption {
            text: "Your seed is just a very large random number. Choose where that randomness comes from.";
        }
        Rectangle { height: 6px; }
        DoorCard {
            highlight: true;
            title: "This device";
            subtitle: "Uses the device's secure random number generator.";
            clicked => { EntropySource.pick-entropy-source("device"); }
        }
        DoorCard {
            title: "Dice rolls";
            subtitle: "You roll a real die and enter each result. The seed is built from your rolls alone — nothing from this device is mixed in — so you can reproduce it yourself with any SHA-256 tool and check it matches.";
            clicked => { EntropySource.pick-entropy-source("dice"); }
        }
        Rectangle { height: 4px; }
        Caption {
            color: Pal.muted;
            text: "Dice take a few minutes, and they are more responsibility: the seed rests entirely on your rolls rather than on this device's randomness, so a fair die and honest rolls are what keep it strong.";
        }
    }

// ui/modals.slint -- the AppWindow overlays extracted verbatim from
// app.slint on 2026-09-03 (PLAN-graffito-app-arch.md U3b). Each stays
// gated the same way it always was; app.slint instantiates them, in the
// same order, as the LAST children of the window (z-order matters).

import { Ui, Modals, Note } from "globals.slint";
import { Body, Caption, Mono, PrimaryButton, GhostButton, IconButton, QrArea } from "components.slint";
import { EditField } from "edit.slint";
import { Pal } from "theme.slint";
import { Switch } from "std-widgets.slint";

// ScanningModal -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- shared camera-scan overlay (live preview) ----------
export component ScanningModal inherits Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.86);
        z: 200;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            padding: 24px;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: Modals.scan-hint;
                    color: Pal.text;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-width: 340px;
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 300px;
                    border-radius: 16px;
                    clip: true;
                    background: #0a0a0a;
                    border-width: 2px;
                    border-color: Pal.accent;
                    Image {
                        source: Modals.camera-frame;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 6px;
                    border-radius: 3px;
                    background: Pal.line;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: 100%;
                        width: parent.width * clamp(Modals.scan-progress, 0, 1);
                        background: Pal.accent;
                        border-radius: 3px;
                        animate width { duration: 150ms; }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Caption {
                    text: Modals.scan-progress > 0.001
                        ? "Collecting frames · \{round(Modals.scan-progress * 100)}%"
                        : "Hold your phone steady and fill the frame.";
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                alignment: center;
                GhostButton {
                    text: "Cancel";
                    min-width: 220px;
                    clicked => { Ui.cancel-scan(); }
                }
            }
        }
    }

// FundRenameModal -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- funding-wallet rename (modal overlay) ----------
export component FundRenameModal inherits Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.fund-rename-cancel(); } }
        Rectangle {
            width: 400px;
            height: frl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            // Swallow clicks on the card body so they don't reach the dim
            // (which cancels) — and drop the keyboard while we're here.
            TouchArea { clicked => { Ui.focus-back-scope-nonce += 1; } }
            frl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this wallet";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                EditField {
                    text <=> Modals.fund-rename-input;
                    placeholder-text: "wallet name";
                    accepted(t) => { Modals.fund-rename-save(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.fund-rename-cancel(); } }
                    PrimaryButton { text: "Save"; clicked => { Modals.fund-rename-save(Modals.fund-rename-input); } }
                }
            }
        }
    }

// RenameAddressModal -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- rename dialog (modal overlay) ----------
export component RenameAddressModal inherits Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.cancel-rename(); } }
        Rectangle {
            width: 400px;
            height: dl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            // Swallow clicks on the card body; also drops the keyboard.
            TouchArea { clicked => { Ui.focus-back-scope-nonce += 1; } }
            dl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this contact";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Mono {
                    text: Ui.rename-address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
                rename-edit := EditField {
                    text <=> Modals.rename-input;
                    placeholder-text: "name (empty clears it)";
                    accepted(t) => { Modals.save-rename(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                if Ui.apple-platform: Rectangle {
                    height: 30px;
                    cbta := TouchArea { clicked => { Modals.rename-synced = !Modals.rename-synced; } }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 20px; height: 20px;
                            y: (parent.height - 20px) / 2;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: Modals.rename-synced ? Pal.accent : Pal.muted;
                            background: Modals.rename-synced ? Pal.accent : transparent;
                            if Modals.rename-synced: Image {
                                source: @image-url("icons/check.svg");
                                colorize: Pal.on-accent;
                                width: 14px; height: 14px;
                                x: (parent.width - 14px) / 2;
                                y: (parent.height - 14px) / 2;
                            }
                        }
                        Text {
                            text: "Save to iCloud";
                            font-size: 13px;
                            color: Pal.text;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { height: 1px; background: Pal.line; }
                Text { text: "Quantum key"; font-size: 13px; font-weight: 700; color: Pal.text; }
                if Ui.rename-pq-display != "": HorizontalLayout {
                    spacing: 8px;
                    Caption { text: Ui.rename-pq-display; horizontal-stretch: 1; wrap: word-wrap; }
                    IconButton {
                        glyph: "×";
                        glyph-size: 18px;
                        width: 28px;
                        height: 28px;
                        glyph-color: Pal.bad;
                        clicked => { Ui.contact-pq-remove(); }
                    }
                }
                if Ui.rename-pq-display == "": HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        horizontal-stretch: 1;
                        text <=> Modals.rename-pq-input;
                        placeholder-text: "paste their quantum public key";
                        accepted(t) => { Ui.contact-pq-set(t); }
                    }
                    GhostButton { text: "Set"; width: 64px; clicked => { Ui.contact-pq-set(Modals.rename-pq-input); } }
                }
                if Ui.desktop-platform && Ui.rename-pq-display == "": GhostButton {
                    text: "From file…";
                    clicked => { Modals.contact-pq-file(); }
                }
                if Modals.rename-pq-error != "": Caption { text: Modals.rename-pq-error; color: Pal.bad; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.cancel-rename(); } }
                    PrimaryButton { text: "Save"; clicked => { Modals.save-rename(Modals.rename-input); } }
                }
            }
        }
    }


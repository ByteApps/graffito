// ConfirmRemoveAddressModal -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- remove-contact confirmation (modal overlay) ----------
export component ConfirmRemoveAddressModal inherits Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.cancel-remove(); } }
        Rectangle {
            width: 400px;
            height: cl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            cl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Remove this contact?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                if Modals.confirm-remove-name != "": Body { text: Modals.confirm-remove-name; }
                Mono {
                    text: Ui.confirm-remove-address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Caption { text: "Only removes it from recents — sending to this address again re-adds it."; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.cancel-remove(); } }
                    PrimaryButton {
                        text: "Remove";
                        tint: Pal.bad;
                        tint-hover: #ff6b62;
                        clicked => { Modals.remove-contact(Ui.confirm-remove-address); }
                    }
                }
            }
        }
    }

// DiceClearConfirmModal -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- reset-identity confirmation (modal overlay) ----------
// Clearing dice rolls is unrecoverable and can throw away several minutes
// of physical rolling, so it confirms — same rule as every other
// destructive action here. Only armed above a handful of rolls; nagging
// about discarding three of them would just be noise.
export component DiceClearConfirmModal inherits Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.show-dice-clear-confirm = false; } }
        Rectangle {
            width: 400px;
            height: dcl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { clicked => { Ui.focus-back-scope-nonce += 1; } }
            dcl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Discard " + Ui.dice-count + " rolls?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body {
                    text: "You'll start again from zero and have to re-roll them.";
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton {
                        text: "Keep rolling";
                        clicked => { Ui.show-dice-clear-confirm = false; }
                    }
                    PrimaryButton {
                        text: "Discard";
                        tint: Pal.bad;
                        clicked => {
                            Ui.show-dice-clear-confirm = false;
                            Ui.dice-clear();
                        }
                    }
                }
            }
        }
    }

// PqBackupConfirmModal -- extracted verbatim from app.slint on 2026-09-03
// (PLAN-graffito-app-arch.md U3b).
//
// ---------- backup quantum private key confirmation (modal overlay) ----------
export component PqBackupConfirmModal inherits Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.pq-show-backup-confirm = false; } }
        Rectangle {
            width: 400px;
            height: pqbl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { clicked => { Ui.focus-back-scope-nonce += 1; } }
            pqbl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Back up your quantum private key?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Caption {
                    text: "Anyone who gets this key can read notes sealed to it. It already recovers from your seed phrase — only do this if you want a separate copy.";

// The touch-aware text-editing system: EditOps (Rust-implemented text/
// clipboard helpers), the floating EditToolbar, and EditField/EditArea
// (drop-in replacements for std LineEdit/TextEdit). Split out of
// app.slint (U1, PLAN-graffito-app-arch.md) as a pure file move: no value
// changes.
import { Pal } from "theme.slint";

// ---- text-input layer --------------------------------------------------
// EditField/EditArea replace std LineEdit/TextEdit so the app can reach
// TextInput's byte-offset cursor API (double-tap word-select, clipboard on
// touch platforms via the UIPasteboard/ClipboardManager shims, paste at
// the cursor) and ship a reliable touch edit toolbar. Std widgets hide
// their inner TextInput; upstream iOS has no edit menu/selection UI, std
// LineEdit doesn't even take tap-focus on iOS, and Android's native
// selection toolbar is one-shot — see UPSTREAM-ISSUES.md.

// Pure text helpers + platform clipboard, implemented in Rust (run()).
// Offsets are UTF-8 byte offsets, matching TextInput's cursor API.
export global EditOps {
    pure callback slice(text: string, start: int, end: int) -> string;
    pure callback splice(text: string, start: int, end: int, insert: string) -> string;
    pure callback byte-len(text: string) -> int;
    pure callback word-start(text: string, offset: int) -> int;
    pure callback word-end(text: string, offset: int) -> int;
    callback clip-set(text: string);
    callback clip-get() -> string;
    // true on iOS/Android (set from Rust): show the touch toolbar and
    // enable double-tap word selection.
    in-out property <bool> touch: false;
    // window width, kept current by the AppWindow root — used to clamp the
    // floating edit bubble to the screen.
    in-out property <length> win-width: 480px;
    // true on iOS only: TextInput's internal clipboard is a no-op there
    // (winit has no iOS clipboard), so cut/copy/paste go through the
    // UIPasteboard shim + byte-offset splicing. Everywhere else the native
    // TextInput ops are used — they hit the system clipboard AND keep the
    // undo stack coherent (splicing via `text =` corrupts undo history).
    in-out property <bool> ios: false;
}

component ToolbarAction inherits Rectangle {
    in property <string> text;
    callback clicked;
    width: label.preferred-width + 18px;
    border-radius: 14px;
    background: ta.has-hover ? Pal.card-hover : transparent;
    label := Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        font-size: 12px;
        color: Pal.text;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Floating Select all / Copy / Paste / Cut pill shown above a focused
// field on touch platforms. Drawn outside the field's bounds; the caller
// anchors it to the screen's left edge via absolute-position.
component EditToolbar inherits Rectangle {
    callback action(string); // select-all | copy | paste | cut
    width: l.preferred-width;
    height: 30px;
    border-radius: 15px;
    background: #262E3A;
    border-width: 1px;
    border-color: Pal.line;
    l := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 2px;
        ToolbarAction { text: "Select all"; clicked => { root.action("select-all"); } }
        ToolbarAction { text: "Copy"; clicked => { root.action("copy"); } }
        ToolbarAction { text: "Paste"; clicked => { root.action("paste"); } }
        ToolbarAction { text: "Cut"; clicked => { root.action("cut"); } }
    }
}

// Single-line text field (drop-in for the std LineEdit call sites).
export component EditField inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder-text;
    in property <InputType> input-type <=> ti.input-type;
    in property <bool> read-only <=> ti.read-only;
    out property <bool> has-focus: ti.has-focus;
    callback edited(string);
    callback accepted(string);

    public function select-all() { ti.select-all(); }
    public function paste-clip() {
        if (EditOps.ios) { do-paste(EditOps.clip-get()); }
        else { ti.paste(); }
    }

    // scratch for statement-order tricks (slint functions have no locals)
    property <int> scratch;
    property <int> last-tap-off: -1;
    property <string> last-tap-text;
    property <int> tap-count;
    property <bool> internal-sel: false; // guards reentrant cursor events
    property <bool> bubble: false;       // floating edit bubble visible?
    property <length> caret-x;           // last caret position, ti coords
    property <length> caret-y;

    pure function sel-start() -> int {
        min(ti.cursor-position-byte-offset, ti.anchor-position-byte-offset)
    }
    pure function sel-end() -> int {
        max(ti.cursor-position-byte-offset, ti.anchor-position-byte-offset)
    }
    function do-copy() {
        if (self.sel-start() == self.sel-end()) {
            EditOps.clip-set(ti.text);
        } else {
            EditOps.clip-set(EditOps.slice(ti.text, self.sel-start(), self.sel-end()));
        }
    }
    function do-cut() {
        if (self.sel-start() != self.sel-end()) {
            EditOps.clip-set(EditOps.slice(ti.text, self.sel-start(), self.sel-end()));
            scratch = self.sel-start();
            ti.text = EditOps.splice(ti.text, self.sel-start(), self.sel-end(), "");
            ti.set-selection-offsets(scratch, scratch);
            root.edited(ti.text);
        }
    }
    function do-paste(clip: string) {
        if (clip != "") {
            scratch = self.sel-start() + EditOps.byte-len(clip);
            ti.text = EditOps.splice(ti.text, self.sel-start(), self.sel-end(), clip);
            ti.set-selection-offsets(scratch, scratch);
            root.edited(ti.text);
        }
    }
    function toolbar-action(a: string) {
        // select-all re-fires cursor-position-changed (anchor jumps to 0);
        // guard with internal-sel so handle-tap()'s reentrant call doesn't
        // see a non-empty selection, fall through to its reset branch, and
        // clear root.bubble out from under the "keep it open" logic below.
        if (a == "select-all") { root.internal-sel = true; ti.select-all(); root.internal-sel = false; }
        if (a == "copy" && EditOps.ios) { do-copy(); }
        if (a == "copy" && !EditOps.ios) { ti.copy(); }
        if (a == "paste") { self.paste-clip(); }
        if (a == "cut" && EditOps.ios) { do-cut(); }
        if (a == "cut" && !EditOps.ios) { ti.cut(); }
    }

    min-width: 120px;
    min-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 6px;
    background: Pal.field;
    border-width: 1px;
    border-color: ti.has-focus ? #33404E : Pal.line;
    forward-focus: ti;

    // double-tap → select word (touch only): two caret placements at
    // (nearly) the same offset within the window, text unchanged, no
    // selection in progress. `edited` disarms so typing can't misfire.
    // Native-iOS-style bubble triggers: nothing on plain caret placement;
    // 2 taps at the same spot select the word, 3 select everything, and a
    // slow tap exactly ON the resting caret toggles the bubble. `edited`
    // hides it and resets the tap chain; typing can't misfire the selectors
    // because each keystroke's `edited` disarms the window and the text-
    // equality guard kills tap-then-type.
    function handle-tap() {
        if (dbl.running && ti.text == root.last-tap-text && root.sel-start() == root.sel-end() && abs(ti.cursor-position-byte-offset - root.last-tap-off) <= 2) {
            root.tap-count += 1;
            if (root.tap-count == 2) {
                root.internal-sel = true;
                ti.set-selection-offsets(
                    EditOps.word-start(ti.text, ti.cursor-position-byte-offset),
                    EditOps.word-end(ti.text, ti.cursor-position-byte-offset));
                root.internal-sel = false;
                // Bubble reveal is DEFERRED to dbl's `triggered` handler
                // below, NOT shown here: the bubble floats just above the
                // word we just selected, only ~8px from the text row, which
                // is exactly where a real 3rd tap (finishing a triple-tap)
                // tends to land. A plain Rectangle — even one with no
                // TouchArea of its own — still swallows taps inside its
                // bounds (see the QR-zoom overlay gotcha), so an immediately
                // -shown bubble silently eats the 3rd tap before it reaches
                // the TextInput, breaking triple-tap-select-all on-device
                // (confirmed: a tap landing in the bubble's padding does
                // nothing and never reaches handle-tap). Deferring keeps the
                // bubble off-screen for the whole window a 3rd tap could
                // still arrive in.
                dbl.running = false;
                dbl.running = true;   // keep the window open for a 3rd tap
            } else {
                root.internal-sel = true;
                ti.select-all();
                root.internal-sel = false;
                root.bubble = true;
                root.tap-count = 0;
                dbl.running = false;
            }
        } else if (!dbl.running && ti.text == root.last-tap-text && ti.cursor-position-byte-offset == root.last-tap-off && root.sel-start() == root.sel-end()) {
            // slow tap exactly on the resting caret → toggle the bubble
            root.bubble = !root.bubble;
            root.tap-count = 1;
            dbl.running = true;
        } else {
            root.bubble = false;
            root.last-tap-off = ti.cursor-position-byte-offset;
            root.last-tap-text = ti.text;
            root.tap-count = 1;
            dbl.running = false;
            dbl.running = true;
        }
    }

    dbl := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            // Window closed with no 3rd tap: reveal the bubble the
            // tap-count==2 branch above deferred. `has-focus` re-check
            // avoids popping it up over a field the user already left.
            if (root.tap-count == 2 && ti.has-focus) {
                root.bubble = true;
            }
        }
    }

    // placeholder — declared BELOW the input stack: a Text element laid
    // over the TextInput swallows touches on iOS (fine with a mouse on
    // macOS); underneath it shows through and never sees a tap.
    Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        vertical-alignment: center;
        text: root.text == "" ? root.placeholder-text : "";
        font-size: 13px;
        color: Pal.muted;
        overflow: elide;
    }

    ContextMenuArea {
        enabled: !EditOps.touch;
        Menu {
            MenuItem { title: "Cut"; enabled: !root.read-only; activated => { ti.cut(); } }
            MenuItem { title: "Copy"; activated => { ti.copy(); } }
            MenuItem { title: "Paste"; enabled: !root.read-only; activated => { ti.paste(); } }
            MenuItem { title: "Select All"; activated => { ti.select-all(); } }
        }

        clip-rect := Rectangle {
            x: 12px;
            width: parent.width - 24px - (clear-btn.visible ? 20px : 0px);
            height: parent.height;
            clip: true;
            ti := TextInput {
                property <length> computed-x;
                x: min(0px, max(parent.width - self.width, self.computed-x));
                width: max(parent.width, self.preferred-width);
                height: parent.height;
                vertical-alignment: center;
                single-line: true;
                wrap: no-wrap;
                font-size: 13px;
                color: Pal.text;
                selection-background-color: Pal.sel-bg;
                selection-foreground-color: Pal.sel-fg;
                edited => {
                    dbl.running = false;
                    root.tap-count = 0;
                    root.bubble = false;
                    root.edited(self.text);
                }
                accepted => { root.accepted(self.text); }
                cursor-position-changed(cpos) => {
                    if (cpos.x + self.computed-x < 12px) {
                        self.computed-x = -cpos.x + 12px;
                    } else if (cpos.x + self.computed-x > parent.width - 12px - self.text-cursor-width) {
                        self.computed-x = parent.width - cpos.x - 12px - self.text-cursor-width;
                    }
                    root.caret-x = cpos.x;
                    root.caret-y = cpos.y;
                    if (EditOps.touch && !root.internal-sel) {
                        root.handle-tap();
                    }
                }
            }
        }
    }

    // fluent-style clear button, kept from the std LineEdit UX
    // (SVG, not a text glyph — femtovg has no font fallback)
    clear-btn := Image {
        visible: ti.has-focus && ti.text != "" && !ti.read-only;
        x: parent.width - 22px;
        y: (parent.height - self.height) / 2;
        width: 11px;
        height: 11px;
        source: @image-url("icons/dismiss.svg");
        colorize: Pal.muted;
        TouchArea {
            clicked => {
                ti.text = "";
                root.edited("");
                ti.focus();
            }
        }
    }

    // focus underline (fluent look)
    Rectangle {
        visible: ti.has-focus;
        x: parent.border-radius;
        y: parent.height - self.height;
        width: parent.width - 2 * parent.border-radius;
        height: 2px;
        background: Pal.field-focus-line;
    }

    if EditOps.touch && ti.has-focus && root.bubble: EditToolbar {
        // centered above the caret, clamped to the screen; flips below the
        // caret line when there is no room above.
        x: clamp(12px + ti.x + root.caret-x - self.width / 2,
                 0px,
                 EditOps.win-width - self.width - 8px - root.absolute-position.x);
        y: root.absolute-position.y + root.caret-y - self.height - 8px < 8px
            ? root.caret-y + 26px
            : root.caret-y - self.height - 8px;
        action(a) => {
            root.toolbar-action(a);
            if (a != "select-all") { root.bubble = false; }
        }
    }
}

// Multi-line text editor (drop-in for the std TextEdit call sites).
export component EditArea inherits Rectangle {
    in-out property <string> text <=> ti.text;
    in property <string> placeholder-text;
    out property <bool> has-focus: ti.has-focus;
    callback edited(string);

    public function select-all() { ti.select-all(); }
    public function paste-clip() {
        if (EditOps.ios) { do-paste(EditOps.clip-get()); }
        else { ti.paste(); }
    }

    property <int> scratch;
    property <int> last-tap-off: -1;
    property <string> last-tap-text;
    property <int> tap-count;
    property <bool> internal-sel: false; // guards reentrant cursor events
    property <bool> bubble: false;       // floating edit bubble visible?
    property <length> caret-x;           // last caret position, ti coords
    property <length> caret-y;

    pure function sel-start() -> int {
        min(ti.cursor-position-byte-offset, ti.anchor-position-byte-offset)
    }
    pure function sel-end() -> int {
        max(ti.cursor-position-byte-offset, ti.anchor-position-byte-offset)
    }
    function do-copy() {
        if (self.sel-start() == self.sel-end()) {
            EditOps.clip-set(ti.text);
        } else {
            EditOps.clip-set(EditOps.slice(ti.text, self.sel-start(), self.sel-end()));
        }
    }
    function do-cut() {
        if (self.sel-start() != self.sel-end()) {
            EditOps.clip-set(EditOps.slice(ti.text, self.sel-start(), self.sel-end()));
            scratch = self.sel-start();
            ti.text = EditOps.splice(ti.text, self.sel-start(), self.sel-end(), "");
            ti.set-selection-offsets(scratch, scratch);
            root.edited(ti.text);
        }
    }
    function do-paste(clip: string) {
        if (clip != "") {
            scratch = self.sel-start() + EditOps.byte-len(clip);
            ti.text = EditOps.splice(ti.text, self.sel-start(), self.sel-end(), clip);
            ti.set-selection-offsets(scratch, scratch);
            root.edited(ti.text);
        }
    }
    function toolbar-action(a: string) {
        // select-all re-fires cursor-position-changed (anchor jumps to 0);
        // guard with internal-sel so handle-tap()'s reentrant call doesn't
        // see a non-empty selection, fall through to its reset branch, and
        // clear root.bubble out from under the "keep it open" logic below.
        if (a == "select-all") { root.internal-sel = true; ti.select-all(); root.internal-sel = false; }
        if (a == "copy" && EditOps.ios) { do-copy(); }
        if (a == "copy" && !EditOps.ios) { ti.copy(); }
        if (a == "paste") { self.paste-clip(); }
        if (a == "cut" && EditOps.ios) { do-cut(); }
        if (a == "cut" && !EditOps.ios) { ti.cut(); }
    }

    min-height: 60px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: Pal.field;
    border-width: 1px;
    border-color: ti.has-focus ? #33404E : Pal.line;
    forward-focus: ti;

    // Native-iOS-style bubble triggers: nothing on plain caret placement;
    // 2 taps at the same spot select the word, 3 select everything, and a
    // slow tap exactly ON the resting caret toggles the bubble. `edited`
    // hides it and resets the tap chain; typing can't misfire the selectors
    // because each keystroke's `edited` disarms the window and the text-
    // equality guard kills tap-then-type.
    function handle-tap() {
        if (dbl.running && ti.text == root.last-tap-text && root.sel-start() == root.sel-end() && abs(ti.cursor-position-byte-offset - root.last-tap-off) <= 2) {
            root.tap-count += 1;
            if (root.tap-count == 2) {
                root.internal-sel = true;
                ti.set-selection-offsets(
                    EditOps.word-start(ti.text, ti.cursor-position-byte-offset),
                    EditOps.word-end(ti.text, ti.cursor-position-byte-offset));
                root.internal-sel = false;
                // Bubble reveal is DEFERRED to dbl's `triggered` handler
                // below, NOT shown here: the bubble floats just above the
                // word we just selected, only ~8px from the text row, which
                // is exactly where a real 3rd tap (finishing a triple-tap)
                // tends to land. A plain Rectangle — even one with no
                // TouchArea of its own — still swallows taps inside its
                // bounds (see the QR-zoom overlay gotcha), so an immediately
                // -shown bubble silently eats the 3rd tap before it reaches
                // the TextInput, breaking triple-tap-select-all on-device
                // (confirmed: a tap landing in the bubble's padding does
                // nothing and never reaches handle-tap). Deferring keeps the
                // bubble off-screen for the whole window a 3rd tap could
                // still arrive in.
                dbl.running = false;
                dbl.running = true;   // keep the window open for a 3rd tap
            } else {
                root.internal-sel = true;
                ti.select-all();
                root.internal-sel = false;
                root.bubble = true;
                root.tap-count = 0;
                dbl.running = false;
            }
        } else if (!dbl.running && ti.text == root.last-tap-text && ti.cursor-position-byte-offset == root.last-tap-off && root.sel-start() == root.sel-end()) {
            // slow tap exactly on the resting caret → toggle the bubble
            root.bubble = !root.bubble;
            root.tap-count = 1;
            dbl.running = true;
        } else {
            root.bubble = false;
            root.last-tap-off = ti.cursor-position-byte-offset;
            root.last-tap-text = ti.text;
            root.tap-count = 1;
            dbl.running = false;
            dbl.running = true;
        }
    }

    dbl := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            // Window closed with no 3rd tap: reveal the bubble the
            // tap-count==2 branch above deferred. `has-focus` re-check
            // avoids popping it up over a field the user already left.
            if (root.tap-count == 2 && ti.has-focus) {
                root.bubble = true;
            }
        }
    }

    Text {
        x: 10px;
        y: 8px;
        width: parent.width - 20px;
        vertical-alignment: top;
        text: root.text == "" ? root.placeholder-text : "";
        font-size: 13px;
        color: Pal.muted;
        overflow: elide;
    }

    ContextMenuArea {
        enabled: !EditOps.touch;
        Menu {
            MenuItem { title: "Cut"; activated => { ti.cut(); } }
            MenuItem { title: "Copy"; activated => { ti.copy(); } }
            MenuItem { title: "Paste"; activated => { ti.paste(); } }
            MenuItem { title: "Select All"; activated => { ti.select-all(); } }
        }

        fli := Flickable {
            x: 10px;
            y: 8px;
            width: parent.width - 20px;
            height: parent.height - 16px;
            viewport-width: self.width;
            viewport-height: max(self.height, ti.preferred-height);
            ti := TextInput {
                width: fli.viewport-width;
                height: fli.viewport-height;
                single-line: false;
                wrap: word-wrap;
                font-size: 13px;
                color: Pal.text;
                selection-background-color: Pal.sel-bg;
                selection-foreground-color: Pal.sel-fg;
                page-height: fli.height;
                edited => {
                    dbl.running = false;
                    root.tap-count = 0;
                    root.bubble = false;
                    root.edited(self.text);
                }
                cursor-position-changed(cpos) => {
                    // keep the caret in view (pattern from std textedit-base)
                    if (cpos.y + fli.viewport-y < 0px) {
                        fli.viewport-y = min(0px, max(fli.height - self.height, -cpos.y));
                    } else if (cpos.y + fli.viewport-y > fli.height - 20px) {
                        fli.viewport-y = min(0px, max(fli.height - self.height, fli.height - cpos.y - 20px));
                    }
                    root.caret-x = cpos.x;
                    root.caret-y = cpos.y;
                    if (EditOps.touch && !root.internal-sel) {
                        root.handle-tap();
                    }
                }
            }
        }
    }

    Rectangle {
        visible: ti.has-focus;
        x: parent.border-radius;
        y: parent.height - self.height;
        width: parent.width - 2 * parent.border-radius;
        height: 2px;
        background: Pal.field-focus-line;
    }

    if EditOps.touch && ti.has-focus && root.bubble: EditToolbar {
        x: clamp(10px + root.caret-x - self.width / 2,
                 0px,
                 EditOps.win-width - self.width - 8px - root.absolute-position.x);
        y: root.absolute-position.y + 8px + fli.viewport-y + root.caret-y - self.height - 8px < 8px
            ? 8px + fli.viewport-y + root.caret-y + 26px
            : 8px + fli.viewport-y + root.caret-y - self.height - 8px;
        action(a) => {
            root.toolbar-action(a);
            if (a != "select-all") { root.bubble = false; }
        }
    }
}

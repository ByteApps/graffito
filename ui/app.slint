component ScanButton inherits Rectangle {
    callback clicked;
    width: 44px;
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Pal.line;
    background: ta.has-hover ? Pal.card-hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Rectangle {
        width: 20px;
        height: 20px;
        x: (parent.width - 20px) / 2;
        y: (parent.height - 20px) / 2;
        Rectangle { x: 0; y: 0; width: 8px; height: 8px; border-width: 2px; border-color: Pal.accent; }
        Rectangle { x: 12px; y: 0; width: 8px; height: 8px; border-width: 2px; border-color: Pal.accent; }
        Rectangle { x: 0; y: 12px; width: 8px; height: 8px; border-width: 2px; border-color: Pal.accent; }
        Rectangle { x: 12px; y: 12px; width: 8px; height: 8px; background: Pal.accent; }
    }
}

component SelectPill inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    height: 32px;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.active ? Pal.accent : Pal.line;
    background: root.active ? Pal.accent : (ta.has-hover ? Pal.card-hover : transparent);
    width: t.preferred-width + 24px;
    ta := TouchArea { clicked => { root.clicked(); } }
    t := Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.text;
        font-size: 12px;
        font-weight: 600;
        color: root.active ? Pal.on-accent : Pal.text;
    }
}

// A dark-themed dropdown: a button showing the current option, a popup list on
// click. `options` is the label model (caller appends a trailing "Custom…"),
// `current-index` the selected row; `selected(i)` fires on pick.
component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <int> current-index;
    callback selected(int);
    height: 40px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Pal.line;
    background: ta.has-hover ? Pal.card-hover : Pal.bg;
    ta := TouchArea { clicked => { popup.show(); } }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: (root.current-index >= 0 && root.current-index < root.options.length)
                ? root.options[root.current-index] : "";
            vertical-alignment: center;
            horizontal-alignment: left;
            color: Pal.text;
            font-size: 13px;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Image {
            source: @image-url("icons/caret-down.svg");
            colorize: Pal.muted;
            width: 14px;
            height: 14px;
            y: (parent.height - 14px) / 2;
        }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            border-radius: 10px;
            border-width: 1px;
            border-color: Pal.line;
            background: Pal.card;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000088;
            VerticalLayout {
                padding: 4px;
                for opt[i] in root.options: Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: ota.has-hover ? Pal.card-hover
                        : (i == root.current-index ? Pal.accent.with-alpha(0.18) : transparent);
                    ota := TouchArea { clicked => { root.selected(i); popup.close(); } }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: opt;
                            vertical-alignment: center;
                            color: i == root.current-index ? Pal.accent : Pal.text;
                            font-size: 13px;
                        }
                    }
                }
            }
        }
    }
}

component SettingsCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    border-radius: 12px;
    border-width: 1px;
    border-color: Pal.line;
    background: Pal.card;
    height: l.preferred-height;
    l := VerticalLayout {
        padding: 16px;
        spacing: 8px;
        Text {
            text: root.title;
            font-size: 14px;
            font-weight: 700;
            color: Pal.text;
        }
        Caption { text: root.subtitle; }
        @children
    }
}

component DoorCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> highlight: false;
    callback clicked;
    border-radius: 12px;
    border-width: 1px;
    border-color: root.highlight ? Pal.accent.with-alpha(0.55) : Pal.line;
    background: ta.has-hover ? Pal.card-hover : Pal.card;
    height: l.preferred-height;
    ta := TouchArea { clicked => { root.clicked(); } }
    l := VerticalLayout {
        padding: 16px;
        spacing: 5px;
        Text {
            text: root.title;
            font-size: 14px;
            font-weight: 700;
            color: root.highlight ? Pal.accent : Pal.text;
        }
        Caption { text: root.subtitle; }
    }
}

export component AppWindow inherits Window {
    preferred-width: 480px;
    preferred-height: 780px;
    min-width: 440px;
    min-height: 620px;
    title: "Chain Notes";
    background: Pal.bg;
    init => { EditOps.win-width = self.width; }
    changed width => { EditOps.win-width = self.width; }

    // 0 onboard · 1 import · 2 backup · 3 quiz · 4 home · 5 note ·
    // 6 compose · 7 contacts · 8 settings
    in-out property <int> screen: 0;
    in-out property <string> status; // in-out: back buttons clear stale messages

    // Safe-area insets (set from Rust on iOS: status bar / Dynamic Island /
    // home indicator). 0 on macOS. Applied as padding on each screen root.
    in property <length> safe-top: 0px;
    in property <length> safe-bottom: 0px;
    // Set true by Rust once the safe-area inset is known; until then a splash
    // cover hides the content so it never slides down from under the status
    // bar on cold start.
    in property <bool> ready: false;

    // iCloud Keychain backup opt-in (current stored state) + restore-availability.
    in-out property <bool> icloud-backup: false;
    in property <bool> icloud-available: false;
    // Apple-only UI (iCloud Keychain sync) — hidden on Android, where the
    // keystore is device-bound and there is no iCloud.
    in property <bool> apple-platform: true;
    // Desktop-only UI (native file dialogs via rfd) — hidden on iOS/Android,
    // where platform::pick_file/save_file return None and the QR + clipboard
    // paths carry the flows instead.
    in property <bool> desktop-platform: true;
    // What the reveal prompt authenticates with, per platform ("Touch ID" /
    // "Face ID" / "biometrics") — copy only, the gating is in keychain.rs.
    in property <string> biometric-name: "Touch ID";

    // Backup screen: "Advanced" collapsible + optional user entropy ("salt").
    in-out property <bool> advanced-expanded: false;
    in-out property <string> entropy-salt;

    in-out property <string> import-text;
    in property <string> import-feedback;
    in property <bool> import-feedback-ok;
    in property <string> import-suggestions;

    in property <string> backup-words;
    in property <string> quiz-prompt;
    in-out property <string> quiz-answer;

    in property <string> address;
    in property <image> address-qr;
    in property <string> balance-line;
    in property <[NoteItem]> notes;
    in property <string> note-detail;
    in property <string> note-web-url;
    in-out property <string> note-view-id;
    in property <bool> note-pending;
    in property <string> note-txid;

    in property <string> to-label;
    in-out property <string> compose-text;
    in-out property <bool> compose-private: true;
    in-out property <string> rate-text;
    in-out property <int> fee-tier: 1;
    in property <string> cost-line;
    // Directed-note gift: is the current note directed, the sats to gift, and
    // whether the collapsible gift section is open.
    in property <bool> directed;
    in-out property <string> gift-sats;
    in-out property <bool> gift-expanded;
    // "Note too large to broadcast" dialog (per-tx ~100 kB ceiling).
    in-out property <bool> show-oversize-modal;
    in property <bool> oversize-offer-bump; // true → offer to switch to Standard
    in property <string> oversize-message;
    in-out property <string> change-address;
    in-out property <bool> change-expanded;
    in property <string> change-amount;
    in property <string> change-error;
    in property <[SpendCoin]> spend-coins;
    in property <string> spend-title;
    in-out property <bool> spend-expanded;
    in-out property <int> coin-strategy;
    in property <bool> spend-enough: true;
    // ---- external funding (pay a note from another wallet via PSBT) ----
    in-out property <bool> fund-external;      // compose toggle
    in property <bool> funding-ready;          // a valid source with coins is loaded
    in property <string> funding-summary;      // one-line source summary (or a call to action)
    in-out property <string> funding-descriptor;
    in property <string> funding-feedback;     // parse feedback on the entry screen
    in property <bool> funding-valid;
    in property <image> psbt-qr;               // current animated-UR frame
    in property <string> psbt-frame-label;     // "frame 2 / 5" or "" for a single frame
    in property <string> psbt-cost-line;       // "fee 240 sats · 1 input · 187 vB"
    in property <bool> psbt-signed;            // an imported signed PSBT validated
    in property <[PsbtRow]> confirm-inputs;
    in property <[PsbtRow]> confirm-outputs;
    in property <string> confirm-note;         // decoded note text (public) or placeholder
    in property <string> confirm-fee-line;
    in property <[FundingWalletRow]> funding-wallets;   // saved wallet manager
    in-out property <string> fund-rename-id;            // non-empty = rename modal open
    in-out property <string> fund-rename-input;
    // shared camera-scan overlay (every "Scan QR" path uses it)
    in-out property <bool> scanning;
    in-out property <image> camera-frame;
    in-out property <float> scan-progress;   // 0..1 multi-frame reassembly
    in property <string> scan-hint: "Point the QR code at the camera";
    callback cancel-scan();
    in property <[ContactItem]> contacts;
    in-out property <string> contact-input;
    in-out property <string> rename-address;
    in-out property <string> rename-input;
    in-out property <string> confirm-remove-address;
    in property <string> confirm-remove-name;

    in property <string> settings-network;
    in property <string> settings-identity;
    in property <bool> settings-hierarchical;
    // Watch-only identity (account-xpub import): no signing key, no private
    // notes — compose/sweep/consolidate/bump are hidden everywhere.
    in property <bool> watch-only;
    in property <[AccountItem]> accounts;
    in-out property <int> account-page;
    in-out property <bool> show-reset-confirm;
    in-out property <string> chunk-text;
    in-out property <bool> chunk-custom;
    // Bitcoin node picker (URLs must be Esplora/mempool-compatible): option
    // labels (last = "Custom…"), selected index, custom-URL text when active.
    in property <[string]> node-options;
    in-out property <int> node-index;
    in-out property <string> node-custom-text;
    // Block-explorer picker: same shape.
    in property <[string]> explorer-options;
    in-out property <int> explorer-index;
    in-out property <string> explorer-custom-text;
    in property <string> reveal-text;
    in property <[CoinItem]> coins;
    in property <string> coins-summary;
    in property <[ActivityItem]> activity;
    in property <string> activity-summary;
    in-out property <bool> show-bump-dialog;
    in-out property <string> bump-ref;
    in-out property <bool> bump-is-note;
    in property <string> bump-kind;
    in property <string> bump-current;
    in property <string> bump-min;
    in property <string> bump-error;
    in property <string> bump-new-fee;
    in-out property <string> bump-rate;
    in-out property <string> consolidate-rate: "1";
    in-out property <bool> show-consolidate-confirm;
    in property <string> consolidate-fee-line;
    in-out property <string> sweep-dest;
    in-out property <string> sweep-rate: "1";
    in-out property <bool> show-sweep-confirm;
    // Sweep flow (picker → dedicated screen 15, compose-like): the send-to
    // picker doubles as the sweep destination picker via pick-mode.
    in-out property <string> pick-mode: "compose";   // "compose" | "sweep"
    in property <string> sweep-to-label;
    in-out property <int> sweep-tier: 1;
    in-out property <string> sweep-rate-text: "1";
    in property <string> sweep-cost-line;
    in property <string> sweep-inputs-title;
    in-out property <bool> sweep-inputs-expanded;
    in property <[SpendCoin]> sweep-coins;
    in-out property <bool> sweep-fund-external;
    // Screen 16 serves both flows: "sweep" (dest from the picker) and
    // "consolidate" (dest = self, opened from the Coins screen).
    in-out property <string> sweep-kind: "sweep";
    // Which screen the funding-wallet manager returns to (6 compose, 16 sweep).
    in-out property <int> funding-return: 6;

    callback door-import();
    callback door-create(int);
    callback import-changed(string);
    callback import-confirm(string);
    callback import-scan();
    callback import-file();
    callback paste-import();
    callback quiz-submit(string);
    callback backup-continue();
    callback regenerate-words();
    callback set-icloud-backup(bool);
    callback restore-icloud();
    callback refresh();
    callback open-note(string);
    callback open-note-web-url(string);
    callback open-note-web();
    callback copy-text(string, string);
    callback set-fee-tier(int);
    callback sweep();
    callback sweep-open();                 // settings → destination picker
    callback consolidate-open();           // coins → consolidate screen (16)
    callback set-sweep-tier(int);
    callback sweep-rate-changed();
    callback toggle-sweep-fund-external(bool);
    callback sweep-send();                 // screen 15 primary action
    callback open-coins();
    callback consolidate();
    callback consolidate-preview();
    callback open-activity();
    callback act-retry(string, bool);
    callback act-bump-open(string, bool);
    callback act-bump-rate-changed(string);
    callback act-bump-confirm();
    callback act-explorer(string);
    callback compose-open();
    callback pick-contact(string);
    callback contact-scan();
    callback start-rename(string, string);
    callback save-rename(string);
    callback cancel-rename();
    callback remove-contact(string);
    callback confirm-remove(string, string);
    callback cancel-remove();
    callback compose-changed();
    callback paste-compose();
    callback compose-send();
    callback change-scan();
    callback toggle-coin(string);
    callback refresh-coins();
    callback set-coin-strategy(int);
    // external funding (PSBT)
    callback toggle-fund-external(bool);
    callback open-funding();       // compose → saved funding-wallets list
    callback add-funding-wallet();     // list → add-wallet entry screen
    callback use-funding-wallet(string);   // pick a saved wallet (scans it)
    callback remove-funding-wallet(string);
    callback refresh-funding-wallet(string);
    callback fund-rename-start(string, string);   // (id, current-label)
    callback fund-rename-save(string);
    callback fund-rename-cancel();
    callback funding-changed(string);
    callback funding-scan();       // scan a descriptor/xpub/UR-account QR
    callback funding-import-ur(string);   // a scanned UR account string → import
    callback funding-file();       // load a descriptor from file
    callback funding-use();        // accept the source, scan its coins, back to compose
    callback funding-clear();      // forget the funding wallet
    callback fund-build();         // build the unsigned PSBT → export screen
    callback psbt-save();          // export the .psbt file
    callback psbt-copy();          // copy PSBT base64
    callback psbt-goto-import();   // export → import screen
    callback psbt-import-file();
    callback psbt-import-scan();
    callback psbt-loaded(string);  // internal: a scanned PSBT string → validate + confirm
    callback psbt-broadcast();     // finalize + broadcast the signed PSBT
    callback settings-open();
    callback set-network(string);
    callback hide-backup();
    callback reset-identity();
    callback open-account-picker();
    callback accounts-page(int);
    callback pick-account(int);
    callback account-cancel();
    callback set-chunk(string);
    callback oversize-bump(); // raise chunk size to Standard from the compose dialog
    callback set-node-preset(int);
    callback set-node-custom(string);
    callback set-explorer-preset(int);
    callback set-explorer-custom(string);
    callback reveal-backup();
    callback go-home();

    // ---------- notebooks (screen 17 = the main list; 4 = one notebook) ----------
    in-out property <[NotebookItem]> notebooks;
    in-out property <[NotebookItem]> archived-notebooks;
    in-out property <bool> show-archived;
    in-out property <string> archived-toggle-label;   // "Archived (2)" — preformatted
    in-out property <bool> can-create-notebook;       // hierarchical identities only
    in-out property <string> notebook-title: "Chain Notes"; // home header = open notebook's name
    // -1 = rename dialog closed · >= 0 = renaming that account. (Creation
    // never dialogs — the picker's inline name field covers it.)
    in-out property <int> nb-rename-account: -1;
    in-out property <string> nb-rename-input;
    // sender filter (home): exclusions persist per notebook, all-on default
    in-out property <[SenderItem]> senders;
    in-out property <bool> filter-expanded;
    in-out property <string> hidden-senders-label;    // "2 senders hidden", empty = none
    // The account picker (screen 9) serves two flows: "switch" = import /
    // settings account change (pick activates), "notebook" = the create-
    // notebook flow (inline name field on top; tapping an address creates
    // the notebook right away — rows already added are disabled).
    in-out property <string> account-pick-mode: "switch";
    in-out property <string> nb-create-name;
    in-out property <string> sweep-dest-note;   // linkage caveat, empty = none
    // wallet-level consolidate (Settings): dest picked on screen 9 in
    // "wconsol" mode, then a confirm modal, then one multi-key tx.
    in-out property <bool> show-wconsol-confirm;
    in-out property <string> wconsol-summary;
    callback consolidate-wallet-open();
    callback wallet-consolidate();
    callback open-notebooks();
    callback open-notebook(int);
    callback create-notebook();
    callback nb-rename-start(int, string);
    callback nb-rename-save(string);
    callback nb-rename-cancel();
    callback nb-archive(int, bool);
    callback toggle-sender(string, bool);

    // ---------- system back (Android hardware/gesture back) ----------
    // slint delivers Android's back button/gesture as Key.Back to whatever
    // has keyboard focus and lets it bubble up from there — so back-scope
    // below wraps every child of the window, and holds focus itself whenever
    // no field does (key events aren't delivered at all while nothing has
    // focus; the changed-handlers below re-take it). Handled = navigate
    // exactly like the current screen's header chevron (single source of
    // truth: the chevrons call nav-back() too); unhandled (onboarding/home)
    // rejects the key so Android's default runs, which moves the task to
    // the background instead of quitting.
    callback back-logged(bool, int); // Rust: `cb: sys-back` log line
    function nav-back() -> bool {
        // Overlays first, topmost (= last window child) before the rest —
        // back closes the same thing a tap on Cancel / the dim would.
        if (root.show-wconsol-confirm) { root.show-wconsol-confirm = false; return true; }
        if (root.show-bump-dialog) { root.show-bump-dialog = false; return true; }
        if (root.show-oversize-modal) { root.show-oversize-modal = false; return true; }
        if (root.show-consolidate-confirm) { root.show-consolidate-confirm = false; return true; }
        if (root.show-sweep-confirm) { root.show-sweep-confirm = false; return true; }
        if (root.show-reset-confirm) { root.show-reset-confirm = false; return true; }
        if (root.confirm-remove-address != "") { root.cancel-remove(); return true; }
        if (root.rename-address != "") { root.cancel-rename(); return true; }
        if (root.fund-rename-id != "") { root.fund-rename-cancel(); return true; }
        if (root.nb-rename-account >= 0) { root.nb-rename-cancel(); return true; }
        if (root.scanning) { root.cancel-scan(); return true; }
        // Screens: one branch per header chevron.
        if (root.screen == 1 || root.screen == 2) { root.screen = 0; return true; }
        if (root.screen == 4) { root.open-notebooks(); return true; }
        if (root.screen == 3) { root.screen = 2; return true; }
        if (root.screen == 5 || root.screen == 8 || root.screen == 11) { root.go-home(); return true; }
        if (root.screen == 6) {
            // Clear the typed address on the way back — it's saved in recents
            // now, so leaving it in the field is redundant. Status too: its
            // message belonged to this screen.
            root.contact-input = "";
            root.status = "";
            root.screen = 7;
            return true;
        }
        if (root.screen == 7) {
            if (root.pick-mode == "sweep") {
                root.pick-mode = "compose";
                root.screen = 8;
            } else {
                root.go-home();
            }
            return true;
        }
        if (root.screen == 9) { root.account-cancel(); return true; }
        if (root.screen == 10) { root.screen = 8; return true; }
        if (root.screen == 12) { root.open-funding(); return true; }
        if (root.screen == 13) { root.screen = root.watch-only ? 8 : 6; return true; }
        if (root.screen == 14) { root.screen = 13; return true; }
        if (root.screen == 15) { root.screen = root.funding-return; return true; }
        if (root.screen == 16) {
            // Clear the typed address + any stale status on the way back —
            // success messages otherwise linger red on the picker. Sweep
            // returns to its destination picker, consolidate to the coins.
            root.contact-input = "";
            root.status = "";
            if (root.sweep-kind == "consolidate") {
                root.screen = 10;
            } else {
                root.pick-mode = "sweep";
                root.screen = 7;
            }
            return true;
        }
        return false; // 0 onboarding / 17 notebook list: nothing to go back to
    }
    // Focus must never be nobody's, or key events (incl. Back) are dropped
    // before they can bubble anywhere: re-take it whenever the focused
    // element may just have been destroyed — a screen change, or one of the
    // two self-focusing rename dialogs closing.
    changed screen => { back-scope.focus(); }
    changed rename-address => { if (root.rename-address == "") { back-scope.focus(); } }
    changed fund-rename-id => { if (root.fund-rename-id == "") { back-scope.focus(); } }
    changed nb-rename-account => { if (root.nb-rename-account < 0) { back-scope.focus(); } }

    back-scope := FocusScope {
        focus-on-click: false; // never steal a tap's focus from a field
        focus-on-tab-navigation: false; // no invisible Tab stop between fields
        init => { self.focus(); }
        // The Down press decides (and navigates); the matching Up must replay
        // the same verdict — Android only runs its own default when it saw
        // the whole tracked down+up pair unhandled. Repeats replay too, so a
        // long-press can't navigate several screens at once.
        property <bool> back-eaten: false;
        key-pressed(event) => {
            if (event.text != Key.Back) { return reject; }
            if (!event.repeat) {
                back-eaten = root.nav-back();
                root.back-logged(back-eaten, root.screen);
            }
            return back-eaten ? accept : reject;
        }
        key-released(event) => {
            return (event.text == Key.Back && back-eaten) ? accept : reject;
        }

    // NOTE: back-scope wraps every window child from here down to its
    // matching closing brace at the bottom of the file; the children keep
    // their original one-level indent (mechanical wrap — slint is
    // whitespace-insensitive, and re-indenting ~2200 lines would bury the
    // file's history).

    // ---------- 0 · onboarding ----------
    if screen == 0: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 24px;
        spacing: 14px;
        alignment: start;
        Rectangle { height: 26px; }
        // SVG, not a typed "₿": Android's Roboto has no U+20BF glyph and
        // skia/femtovg have no font fallback (the icon rule).
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/bitcoin.svg");
                colorize: Pal.accent;
                width: 34px;
                height: 34px;
            }
        }
        H1 { text: "Chain Notes"; horizontal-alignment: center; }
        Caption {
            text: "Personal notes on the bitcoin blockchain — encrypted, permanent, yours.";
            horizontal-alignment: center;
        }
        Rectangle { height: 12px; }
        DoorCard {
            highlight: true;
            title: "Import a key";
            subtitle: "Any mnemonic, xprv, WIF, or 32-byte hex key — e.g. a BIP-85 child from your hardware wallet. An account xpub imports as watch-only. Type, scan, or open a file.";
            clicked => { root.door-import(); }
        }
        DoorCard {
            title: "Create a new 12-word seed";
            subtitle: "Fresh identity, backed up on paper. For everyone without a hardware wallet.";
            clicked => { root.door-create(12); }
        }
        DoorCard {
            title: "Create a new 18-word seed";
            subtitle: "Same, with a longer phrase.";
            clicked => { root.door-create(18); }
        }
        DoorCard {
            title: "Create a new 24-word seed";
            subtitle: "Same, with the longest phrase.";
            clicked => { root.door-create(24); }
        }
        if root.icloud-available: DoorCard {
            highlight: true;
            title: "Restore from iCloud";
            subtitle: "A key you backed up to iCloud Keychain is available — restore it on this device.";
            clicked => { root.restore-icloud(); }
        }
        Rectangle { height: 6px; }
        Caption {
            text: "This app holds a hot key on an online device — fund it with note-fee money only.";
        }
        Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 1 · import ----------
    if screen == 1: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Import key";
            back => { root.nav-back(); }
        }
        Caption { text: "Mnemonic (12/18/24 words), xprv, WIF, 32-byte hex — or an account xpub for a watch-only notebook (public notes and balance; private notes stay sealed, no composing)."; }
        EditArea {
            height: 110px;
            text <=> root.import-text;
            edited => { root.import-changed(self.text); }
        }
        if root.import-suggestions != "": Caption {
            text: root.import-suggestions;
            color: Pal.accent;
        }
        if root.import-feedback != "": Body {
            text: root.import-feedback;
            font-size: 12px;
            // Rust sets the flag alongside the text (string-matching the
            // feedback here rotted once already).
            color: root.import-feedback-ok ? Pal.good : Pal.warn;
        }
        HorizontalLayout {
            spacing: 10px;
            GhostButton { text: "Paste"; clicked => { root.paste-import(); } }
            GhostButton { text: "Scan QR"; clicked => { root.import-scan(); } }
            if root.desktop-platform: GhostButton { text: "From file…"; clicked => { root.import-file(); } }
        }
        if root.apple-platform: Switch {
            text: "Back up to iCloud";
            checked <=> root.icloud-backup;
            toggled => { root.set-icloud-backup(root.icloud-backup); }
        }
        PrimaryButton { text: "Import"; clicked => { root.import-confirm(root.import-text); } }
    }

    // ---------- 2 · backup ----------
    if screen == 2: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Write these words down";
            show-back: true;
            back => { root.nav-back(); }
        }
        Rectangle {
            border-radius: 10px;
            background: Pal.warn.with-alpha(0.12);
            height: warn-t.preferred-height + 20px;
            warn-t := Caption {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                color: Pal.warn;
                text: "This is the ONLY backup. Anyone with these words can spend the funds and read every private note. No screenshots — paper.";
            }
        }
        Card {
            height: words-t.preferred-height + 32px;
            words-t := Mono {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                text: root.backup-words;
                font-size: 13px;
            }
            CopyButton {
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                clicked => { root.copy-text("backup-words", root.backup-words); }
            }
        }
        // Advanced (collapsible, styled like the compose panels so it clearly
        // reads as tappable): optional user-supplied entropy ("salt").
        Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: adv-col.preferred-height;
            adv-col := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Rectangle {
                    height: 22px;
                    TouchArea { clicked => { root.advanced-expanded = !root.advanced-expanded; } }
                    HorizontalLayout {
                        Text {
                            text: "Advanced";
                            font-size: 12px;
                            color: Pal.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        Image {
                            source: root.advanced-expanded
                                ? @image-url("icons/caret-up.svg")
                                : @image-url("icons/caret-down.svg");
                            colorize: Pal.muted;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                        }
                    }
                }
                if root.advanced-expanded: Caption {
                    text: "Add extra entropy — dice rolls, random words, anything. It's hashed with the device's secure RNG, so it can only ADD randomness. Press the reroll button or Enter to reroll.";
                }
                if root.advanced-expanded: HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        placeholder-text: "extra entropy (optional)";
                        text <=> root.entropy-salt;
                        accepted => { root.regenerate-words(); }
                    }
                    SvgIconButton {
                        icon: "refresh";
                        tint: Pal.text;
                        clicked => { root.regenerate-words(); }
                    }
                }
            }
        }
        if root.apple-platform: Switch {
            text: "Back up to iCloud";
            checked <=> root.icloud-backup;
            toggled => { root.set-icloud-backup(root.icloud-backup); }
        }
        if root.apple-platform: Caption {
            text: "Syncs your key to your Apple devices and lets you restore after reinstall. Change anytime in Settings.";
            color: Pal.muted;
        }
        PrimaryButton { text: "I wrote them down"; clicked => { root.backup-continue(); } }
    }

    // ---------- 3 · quiz ----------
    if screen == 3: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Spot check";
            show-back: true;
            back => { root.nav-back(); }
        }
        Body { text: root.quiz-prompt; }
        EditField { text <=> root.quiz-answer; placeholder-text: "word  word  word"; }
        PrimaryButton { text: "Verify"; clicked => { root.quiz-submit(root.quiz-answer); } }
        Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 4 · home ----------
    if screen == 4: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 40px;
            BackButton { clicked => { root.open-notebooks(); } }
            Text {
                text: root.notebook-title;
                font-size: 19px;
                font-weight: 700;
                color: Pal.text;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { }
            SvgIconButton { icon: "refresh"; clicked => { root.refresh(); } }
            SvgIconButton { icon: "activity"; clicked => { root.open-activity(); } }
            IconButton { glyph: "⚙"; clicked => { root.settings-open(); } }
        }
        Card {
            height: 132px;
            HorizontalLayout {
                padding: 12px;
                spacing: 14px;
                Rectangle {
                    width: 100px;
                    height: 100px;
                    background: white;
                    border-radius: 8px;
                    Image {
                        source: root.address-qr;
                        width: 92px;
                        height: 92px;
                        x: 4px;
                        y: 4px;
                        image-rendering: pixelated;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: root.balance-line;
                        font-size: 17px;
                        font-weight: 700;
                        color: Pal.text;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Mono {
                            text: root.address;
                            font-size: 10px;
                            color: Pal.muted;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            CopyButton { clicked => { root.copy-text("address", root.address); } }
                        }
                    }
                    if root.watch-only: HorizontalLayout {
                        alignment: start;
                        Badge { label: "watch-only"; tint: Pal.warn; }
                    }
                    Caption { text: root.status; }
                }
            }
        }
        PrimaryButton { text: "+  Compose note"; clicked => { root.compose-open(); } }
        if root.watch-only: Caption { text: "Watch-only — public notes only, signed on your external wallet. Private notes need the key."; }
        // Sender filter header: tap to expand the per-sender checklist; the
        // warn pill flags a persisted exclusion so hidden notes are never a
        // silent mystery.
        Rectangle {
            height: 24px;
            if root.senders.length > 1: TouchArea { clicked => { root.filter-expanded = !root.filter-expanded; } }
            HorizontalLayout {
                spacing: 8px;
                Caption {
                    text: root.notes.length == 0
                        ? (root.watch-only ? "No notes on this address yet." : "No notes yet — fund the address above, then compose.")
                        : "Notes";
                    vertical-alignment: center;
                }
                if root.hidden-senders-label != "": Badge { label: root.hidden-senders-label; tint: Pal.warn; }
                Rectangle { }
                if root.senders.length > 1: HorizontalLayout {
                    spacing: 6px;
                    Caption { text: "Senders"; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.filter-expanded
                                ? @image-url("icons/caret-up.svg")
                                : @image-url("icons/caret-down.svg");
                            colorize: Pal.muted;
                            width: 12px;
                            height: 12px;
                        }
                    }
                }
            }
        }
        if root.filter-expanded: VerticalLayout {
            spacing: 4px;
            for s in root.senders: Rectangle {
                height: 36px;
                border-radius: 8px;
                background: s-ta.has-hover ? Pal.card-hover : Pal.card;
                border-width: 1px;
                border-color: Pal.line;
                s-ta := TouchArea { clicked => { root.toggle-sender(s.key, !s.excluded); } }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: s.excluded ? Pal.line : Pal.accent;
                            background: s.excluded ? transparent : Pal.accent.with-alpha(0.18);
                            if !s.excluded: Image {
                                source: @image-url("icons/check.svg");
                                colorize: Pal.accent;
                                width: 11px;
                                height: 11px;
                                x: 2.5px;
                                y: 2.5px;
                            }
                        }
                    }
                    Text {
                        text: s.label;
                        font-size: 12px;
                        color: s.excluded ? Pal.muted : Pal.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { }
                    Caption { text: s.sub; vertical-alignment: center; }
                }
            }
        }
        // Notebook list — top-aligned + scrollable (a plain ListView vertically
        // centres a short list). Matches the Settings-screen Flickable pattern.
        Flickable {
            viewport-height: notes-col.preferred-height;
            notes-col := VerticalLayout {
                alignment: start;
                spacing: 6px;
                for note in root.notes: Rectangle {
                height: 62px;
                nt := TouchArea { clicked => { root.open-note(note.id); } }
                Rectangle {
                    y: 2px;
                    height: parent.height - 6px;
                    border-radius: 10px;
                    background: nt.has-hover ? Pal.card-hover : Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    HorizontalLayout {
                        x: 14px;
                        width: note.web-url != "" ? parent.width - 60px : parent.width - 26px;
                        height: parent.height;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            if note.private: Image {
                                source: @image-url("icons/lock.svg");
                                colorize: Pal.muted;
                                width: 13px;
                                height: 13px;
                                x: 0;
                                y: (parent.height - 13px) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: note.title;
                                horizontal-alignment: left;
                                font-size: 13px;
                                color: Pal.text;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 20px;
                                Badge {
                                    label: note.badge;
                                    tint: note.badge == "confirmed" ? Pal.good
                                        : (note.badge == "pending" ? Pal.warn : Pal.bad);
                                }
                                Caption {
                                    text: note.meta;
                                    vertical-alignment: center;
                                    height: 20px;
                                }
                            }
                        }
                    }
                    if note.web-url != "": WebViewButton {
                        x: parent.width - 44px;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.open-note-web-url(note.web-url); }
                    }
                }
            }
            }
        }
    }

    // ---------- 17 · notebooks (the main screen) ----------
    if screen == 17: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 40px;
            Text {
                text: "Chain Notes";
                font-size: 19px;
                font-weight: 700;
                color: Pal.text;
                vertical-alignment: center;
            }
            Rectangle { }
            SvgIconButton { icon: "activity"; clicked => { root.open-activity(); } }
            IconButton { glyph: "⚙"; clicked => { root.settings-open(); } }
        }
        if root.can-create-notebook: PrimaryButton { text: "+  New notebook"; clicked => { root.create-notebook(); } }
        Caption { text: root.status; }
        // Zero active notebooks is a legitimate state (fresh start, or
        // everything archived) — say so instead of showing a blank page.
        if root.notebooks.length == 0: Caption {
            text: root.archived-toggle-label != ""
                ? "All notebooks are archived."
                : (root.can-create-notebook
                    ? "No notebooks yet — create one to start writing."
                    : "No notebooks yet.");
        }
        Flickable {
            viewport-height: nb-col.preferred-height;
            nb-col := VerticalLayout {
                alignment: start;
                spacing: 6px;
                for nb in root.notebooks: Rectangle {
                    height: 86px;
                    nb-ta := TouchArea { clicked => { root.open-notebook(nb.account); } }
                    Rectangle {
                        y: 2px;
                        height: parent.height - 6px;
                        border-radius: 10px;
                        background: nb-ta.has-hover ? Pal.card-hover : Pal.card;
                        border-width: 1px;
                        border-color: nb.active ? Pal.accent.with-alpha(0.55) : Pal.line;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 4px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: nb.name;
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Pal.text;
                                        overflow: elide;
                                    }
                                    if nb.unread != "": Badge { label: nb.unread; tint: Pal.good; }
                                }
                                Caption { text: nb.snippet; overflow: elide; }
                                Caption { text: nb.meta; color: Pal.faint; }
                            }
                            VerticalLayout {
                                alignment: center;
                                PencilButton { clicked => { root.nb-rename-start(nb.account, nb.name); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                SvgIconButton {
                                    icon: "archive";
                                    size: 15px;
                                    width: 32px;
                                    height: 32px;
                                    clicked => { root.nb-archive(nb.account, true); }
                                }
                            }
                        }
                    }
                }
                if root.archived-toggle-label != "": Rectangle {
                    height: 34px;
                    arch-ta := TouchArea { clicked => { root.show-archived = !root.show-archived; } }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Caption { text: root.archived-toggle-label; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: root.show-archived
                                    ? @image-url("icons/caret-up.svg")
                                    : @image-url("icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 12px;
                                height: 12px;
                            }
                        }
                    }
                }
                if root.show-archived: VerticalLayout {
                    spacing: 6px;
                    for nb in root.archived-notebooks: Rectangle {
                        height: 56px;
                        anb-ta := TouchArea { clicked => { root.open-notebook(nb.account); } }
                        Rectangle {
                            y: 2px;
                            height: parent.height - 6px;
                            border-radius: 10px;
                            background: anb-ta.has-hover ? Pal.card-hover : Pal.card;
                            border-width: 1px;
                            border-color: Pal.line;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: nb.name;
                                        font-size: 13px;
                                        color: Pal.muted;
                                        overflow: elide;
                                    }
                                    Caption { text: nb.meta; color: Pal.faint; }
                                }
                                Rectangle { }
                                VerticalLayout {
                                    alignment: center;
                                    GhostButton { text: "Restore"; clicked => { root.nb-archive(nb.account, false); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------- 5 · note view ----------
    if screen == 5: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Note";
            back => { root.nav-back(); }
        }
        Card {
            height: nd.preferred-height + 32px;
            nd := Mono {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                text: root.note-detail;
                font-size: 12px;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            GhostButton { text: "Copy text"; clicked => { root.copy-text("note-text", root.note-detail); } }
            GhostButton { text: "Copy txid"; clicked => { root.copy-text("txid", root.note-txid); } }
        }
        if root.note-pending: Caption {
            text: "Still unconfirmed — speed it up or rebroadcast from Activity (the pulse icon on the home screen).";
        }
        if root.note-web-url != "": GhostButton {
            text: "Open in web viewer";
            clicked => { root.open-note-web(); }
        }
        Caption { text: root.status; }
        if root.note-web-url == "": Caption {
            text: "Web viewer link unavailable on regtest.";
        }
    }

    // ---------- 6 · compose ----------
    if screen == 6: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Compose";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-height: compose-col.preferred-height;
            compose-col := VerticalLayout {
                spacing: 12px;
        Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: 34px;
            Text {
                x: 12px;
                width: parent.width - 24px;
                height: parent.height;
                vertical-alignment: center;
                text: root.to-label;
                font-size: 12px;
                color: Pal.muted;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 16px;
            Text { text: "Note"; font-size: 12px; color: Pal.muted; vertical-alignment: center; }
            Rectangle { }
            Text {
                text: "Paste";
                font-size: 13px;
                color: Pal.accent;
                vertical-alignment: center;
                // paste-clip inserts at the cursor (replacing any selection)
                // via the platform clipboard — the old paste-compose Rust
                // path appended to the end.
                TouchArea { clicked => { note-edit.paste-clip(); } }
            }
            Text {
                text: "Done";
                font-size: 13px;
                color: Pal.accent;
                vertical-alignment: center;
                // Focus moves to back-scope rather than to nobody — same
                // visible effect (field blurs, keyboard hides), but key
                // events keep a destination (see back-scope).
                TouchArea { clicked => { back-scope.focus(); } }
            }
        }
        note-edit := EditArea {
            height: 150px;
            text <=> root.compose-text;
            edited => { root.compose-changed(); }
        }
        if !root.watch-only: HorizontalLayout {
            spacing: 12px;
            Switch {
                text: "Private";
                checked <=> root.compose-private;
                toggled => { root.compose-changed(); }
            }
            Rectangle { }
        }
        if root.watch-only: Caption {
            text: "Watch-only: public notes only — sealing needs the encryption key, which stays on your other device.";
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            SelectPill { text: "economy"; active: root.fee-tier == 0; clicked => { root.set-fee-tier(0); } }
            SelectPill { text: "normal"; active: root.fee-tier == 1; clicked => { root.set-fee-tier(1); } }
            SelectPill { text: "fast"; active: root.fee-tier == 2; clicked => { root.set-fee-tier(2); } }
            SelectPill { text: "custom"; active: root.fee-tier == 3; clicked => { root.fee-tier = 3; } }
        }
        // Custom sat/vB field — revealed only when the Custom tier is
        // selected (the pill above is the toggle); hidden for the presets.
        if root.fee-tier == 3: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            EditField {
                width: 84px;
                text <=> root.rate-text;
                edited => { root.compose-changed(); }
            }
            Caption { text: "sat/vB"; vertical-alignment: center; }
        }
        if root.cost-line != "": Text {
            text: root.cost-line;
            font-size: 13px;
            font-weight: 600;
            color: Pal.accent;
        }
        // ---- gift amount (directed notes only), collapsible ----
        if root.directed: Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: gift-col.preferred-height;
            gift-col := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Rectangle {
                    height: 22px;
                    TouchArea { clicked => { root.gift-expanded = !root.gift-expanded; } }
                    HorizontalLayout {
                        Text {
                            text: "Gift · \{root.gift-sats} sats";
                            font-size: 12px;
                            color: Pal.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        Image {
                            source: root.gift-expanded
                                ? @image-url("icons/caret-up.svg")
                                : @image-url("icons/caret-down.svg");
                            colorize: Pal.muted;
                            width: 16px;
                            height: 16px;
                        }
                    }
                }
                if root.gift-expanded: Caption {
                    text: "Sats sent to the recipient along with your note. Minimum 330 (dust).";
                }
                if root.gift-expanded: EditField {
                    text <=> root.gift-sats;
                    input-type: number;
                    edited => { root.compose-changed(); }
                }
            }
        }
        // ---- pay from another wallet (external PSBT) ----
        HorizontalLayout {
            Switch {
                text: "Pay from another wallet";
                checked <=> root.fund-external;
                toggled => { root.toggle-fund-external(self.checked); }
            }
            Rectangle { }
        }
        if root.fund-external: Rectangle {
            border-radius: 10px;
            background: ftap.has-hover ? Pal.card-hover : Pal.card;
            border-width: 1px;
            border-color: root.funding-ready ? Pal.line : Pal.accent.with-alpha(0.5);
            height: 44px;
            ftap := TouchArea { clicked => { root.funding-return = 6; root.open-funding(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                Text {
                    text: root.funding-summary;
                    font-size: 12px;
                    color: root.funding-ready ? Pal.text : Pal.accent;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text { text: "›"; font-size: 22px; color: Pal.muted; vertical-alignment: center; }
            }
        }
        // ---- coin control (collapsible) ----
        Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: root.spend-enough ? Pal.line : Pal.bad;
            height: spend-col.preferred-height;
            spend-col := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Rectangle {
                    height: 22px;
                    TouchArea { clicked => { root.spend-expanded = !root.spend-expanded; } }
                    HorizontalLayout {
                        Text {
                            text: root.spend-title;
                            font-size: 12px;
                            color: root.spend-enough ? Pal.muted : Pal.bad;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        SvgIconButton {
                            icon: "refresh";
                            size: 14px;
                            width: 28px;
                            height: 22px;
                            clicked => { root.refresh-coins(); }
                        }
                        Image {
                            source: root.spend-expanded
                                ? @image-url("icons/caret-up.svg")
                                : @image-url("icons/caret-down.svg");
                            colorize: Pal.muted;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                        }
                    }
                }
                if root.spend-expanded: Caption {
                    text: "Tap coins to include or exclude. The note spends exactly what's selected.";
                }
                if root.spend-expanded: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    SelectPill {
                        text: "fewest coins";
                        active: root.coin-strategy == 0;
                        clicked => { root.set-coin-strategy(0); }
                    }
                    SelectPill {
                        text: "consolidate";
                        active: root.coin-strategy == 1;
                        clicked => { root.set-coin-strategy(1); }
                    }
                }
                if root.spend-expanded && !root.spend-enough: Caption {
                    text: "Selected coins don't cover the note + fee — select more.";
                    color: Pal.bad;
                }
                if root.spend-expanded: VerticalLayout {
                    spacing: 6px;
                    for c in root.spend-coins: Rectangle {
                        height: 42px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: c.selected ? Pal.accent : Pal.line;
                        background: c.selected ? Pal.accent.with-alpha(0.10) : transparent;
                        cta := TouchArea { clicked => { root.toggle-coin(c.outpoint); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                y: (parent.height - 18px) / 2;
                                border-radius: 4px;
                                border-width: 2px;
                                border-color: c.selected ? Pal.accent : Pal.muted;
                                background: c.selected ? Pal.accent : transparent;
                                if c.selected: Rectangle {
                                    width: 8px; height: 8px;
                                    x: (parent.width - 8px) / 2;
                                    y: (parent.height - 8px) / 2;
                                    background: Pal.on-accent;
                                    border-radius: 2px;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: c.value + " sats";
                                    font-size: 12px;
                                    color: Pal.text;
                                }
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                Badge {
                                    label: c.confirmed ? "confirmed" : "unconfirmed";
                                    tint: c.confirmed ? Pal.good : Pal.warn;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 22px;
                                    width: pillrow.preferred-width + 14px;
                                    border-radius: 11px;
                                    border-width: 1px;
                                    border-color: Pal.line;
                                    background: pta.has-hover && c.explorer != "" ? Pal.card-hover : transparent;
                                    pta := TouchArea {
                                        clicked => { if (c.explorer != "") { root.act-explorer(c.explorer); } }
                                    }
                                    pillrow := HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 7px;
                                        spacing: 4px;
                                        Text {
                                            text: c.txid-short;
                                            font-family: "Menlo";
                                            font-size: 10px;
                                            color: Pal.muted;
                                            vertical-alignment: center;
                                        }
                                        if c.explorer != "": Image {
                                            source: @image-url("icons/external.svg");
                                            colorize: Pal.accent;
                                            width: 11px;
                                            height: 11px;
                                            y: (parent.height - 11px) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // ---- change output (collapsible) ----
        Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: root.change-error != "" ? Pal.bad : Pal.line;
            height: change-col.preferred-height;
            change-col := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Rectangle {
                    height: 22px;
                    TouchArea { clicked => { root.change-expanded = !root.change-expanded; } }
                    HorizontalLayout {
                        Text {
                            text: root.change-amount;
                            font-size: 12px;
                            color: Pal.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        Image {
                            source: root.change-expanded
                                ? @image-url("icons/caret-up.svg")
                                : @image-url("icons/caret-down.svg");
                            colorize: Pal.muted;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                        }
                    }
                }
                if root.change-expanded: Caption {
                    text: root.fund-external
                        ? "Change returns to the funding wallet by default. Send it elsewhere:"
                        : "Change returns to your address by default. Send it somewhere else:";
                }
                if root.change-expanded: HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        text <=> root.change-address;
                        placeholder-text: "change address (blank = back to you)";
                        edited => { root.compose-changed(); }
                    }
                    ScanButton { clicked => { root.change-scan(); } }
                }
                if root.change-error != "": Caption { text: root.change-error; color: Pal.bad; }
            }
        }
        Caption {
            text: root.compose-private
                ? "Encrypted forever on-chain — XChaCha20-Poly1305, 256-bit key; only your key (and a directed recipient) can read it."
                : "⚠  Public notes are world-readable, forever.";
        }
        if !root.fund-external: PrimaryButton {
            text: root.watch-only ? "Build transaction to sign" : "Sign + broadcast";
            tint: root.spend-enough ? Pal.accent : Pal.faint;
            tint-hover: root.spend-enough ? Pal.accent-hover : Pal.faint;
            clicked => { if (root.spend-enough) { root.compose-send(); } }
        }
        if root.fund-external: PrimaryButton {
            text: root.funding-ready ? "Build transaction to sign" : "Set a funding wallet first";
            tint: (root.funding-ready && root.spend-enough) ? Pal.accent : Pal.faint;
            tint-hover: (root.funding-ready && root.spend-enough) ? Pal.accent-hover : Pal.faint;
            clicked => {
                if (!root.funding-ready) {
                    root.open-funding();
                } else if (root.spend-enough) {
                    root.fund-build();
                }
            }
        }
        Caption { text: root.status; color: Pal.bad; }
            }
        }
    }

    // ---------- 7 · contacts ----------
    if screen == 7: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: root.pick-mode == "sweep" ? "Sweep to" : "Send to";
            back => { root.nav-back(); }
        }
        if root.pick-mode != "sweep": DoorCard {
            highlight: true;
            title: "Self — my notebook";
            subtitle: "A private note only you can read back.";
            clicked => { root.pick-contact("self"); }
        }
        // Divider between the Self card and the address-entry section.
        if root.pick-mode != "sweep": Rectangle { height: 1px; background: Pal.line; }
        HorizontalLayout {
            spacing: 10px;
            EditField {
                text <=> root.contact-input;
                placeholder-text: "taproot / segwit address";
                accepted(t) => { root.pick-contact(t); }
            }
            ScanButton { clicked => { root.contact-scan(); } }
            GhostButton { width: 64px; text: "Use"; clicked => { root.pick-contact(root.contact-input); } }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
        // Sweep = leaving the wallet: destinations are EXTERNAL addresses
        // (moving coins between notebooks is Consolidate's job).
        if root.pick-mode == "sweep": Caption {
            text: "The whole wallet — every notebook's coins — goes to this address in one transaction.";
        }
        if root.contacts.length > 0: Caption { text: "Recently used"; }
        // Recents list. A ListView / stretched Flickable vertically CENTRES a
        // short list, leaving a big gap under the "Recently used" separator.
        // Instead: a content-sized column that sits directly under the
        // separator, and a trailing stretch spacer that soaks up the leftover
        // space — so the rows always start at the top and grow downward.
        recents-col := VerticalLayout {
            spacing: 6px;
            for c in root.contacts: Rectangle {
                height: 52px;
                    ct := TouchArea { clicked => { root.pick-contact(c.address); } }
                    Rectangle {
                        y: 2px;
                        height: parent.height - 6px;
                        border-radius: 10px;
                        background: ct.has-hover ? Pal.card-hover : Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 6px;
                            spacing: 2px;
                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;
                                Text {
                                    text: c.name == "" ? c.address : c.name;
                                    font-size: 12px;
                                    color: Pal.text;
                                    overflow: elide;
                                }
                                if c.name != "": Caption { text: c.address; overflow: elide; }
                            }
                            VerticalLayout {
                                alignment: center;
                                PencilButton {
                                    clicked => { root.start-rename(c.address, c.name); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    glyph: "×";
                                    glyph-size: 20px;
                                    width: 32px;
                                    height: 32px;
                                    glyph-color: Pal.bad;
                                    clicked => { root.confirm-remove(c.address, c.name); }
                                }
                            }
                        }
                    }
                }
            }
    }

    // ---------- 8 · settings ----------
    if screen == 8: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Settings";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-height: settings-col.preferred-height;
            settings-col := VerticalLayout {
                spacing: 12px;
                alignment: start;
        SettingsCard {
            title: "Identity";
            subtitle: root.settings-identity;
            Mono {
                text: root.address;
                font-size: 10px;
                color: Pal.muted;
                wrap: no-wrap;
                overflow: elide;
            }
            // (The old "Change account…" row is gone — the notebook list IS
            // the account switcher now.)
            GhostButton {
                text: "Switch identity — new seed or different key…";
                clicked => { root.show-reset-confirm = true; }
            }
        }
        if root.apple-platform: SettingsCard {
            title: "iCloud backup";
            subtitle: "Sync your key to iCloud Keychain — it's restored automatically after a reinstall or on your other Apple devices. Reveal still needs Face ID.";
            Switch {
                text: "Back up to iCloud";
                checked <=> root.icloud-backup;
                toggled => { root.set-icloud-backup(root.icloud-backup); }
            }
        }
        SettingsCard {
            title: "Network";
            subtitle: "Which chain this notebook lives on. Every network keeps its own separate notebook for the same key.";
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill { text: "mainnet"; active: root.settings-network == "mainnet"; clicked => { root.set-network("mainnet"); } }
                SelectPill { text: "testnet4"; active: root.settings-network == "testnet4"; clicked => { root.set-network("testnet4"); } }
                SelectPill { text: "signet"; active: root.settings-network == "signet"; clicked => { root.set-network("signet"); } }
                SelectPill { text: "regtest"; active: root.settings-network == "regtest"; clicked => { root.set-network("regtest"); } }
            }
        }
        SettingsCard {
            title: "Note size limit";
            subtitle: "Largest OP_RETURN chunk per output. Standard suits modern relays (Core v30+). If a broadcast is rejected, switch to 80 compat and recompose.";
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill {
                    text: "Standard";
                    active: !root.chunk-custom && root.chunk-text == "100000";
                    clicked => { root.set-chunk("100000"); }
                }
                SelectPill {
                    text: "80 compat";
                    active: !root.chunk-custom && root.chunk-text == "80";
                    clicked => { root.set-chunk("80"); }
                }
                SelectPill {
                    text: "Custom";
                    active: root.chunk-custom || (root.chunk-text != "100000" && root.chunk-text != "80");
                    clicked => { root.chunk-custom = true; }
                }
            }
            if root.chunk-custom || (root.chunk-text != "100000" && root.chunk-text != "80"): HorizontalLayout {
                spacing: 8px;
                EditField {
                    width: 130px;
                    text <=> root.chunk-text;
                    placeholder-text: "20 – 100000";
                    accepted(t) => { root.set-chunk(t); }
                }
                Caption { text: "bytes · press Return to apply"; vertical-alignment: center; }
            }
        }
        SettingsCard {
            title: "Bitcoin node";
            subtitle: "Scans and broadcasts go through this server — it learns your address and IP. Pick a provider, or point at your own Esplora/mempool-compatible node.";
            Dropdown {
                options: root.node-options;
                current-index: root.node-index;
                selected(i) => { root.node-index = i; root.set-node-preset(i); }
            }
            if root.node-index == root.node-options.length - 1: EditField {
                text <=> root.node-custom-text;
                placeholder-text: "https://mempool.example/api  or  http://127.0.0.1:3002";
                accepted(t) => { root.set-node-custom(t); }
            }
        }
        SettingsCard {
            title: "Block explorer";
            subtitle: "Where the app's Explorer links open a transaction. Pick a site or use your own (e.g. a self-hosted mempool); the link becomes <base>/tx/<txid>.";
            Dropdown {
                options: root.explorer-options;
                current-index: root.explorer-index;
                selected(i) => { root.explorer-index = i; root.set-explorer-preset(i); }
            }
            if root.explorer-index == root.explorer-options.length - 1: EditField {
                text <=> root.explorer-custom-text;
                placeholder-text: "https://your-mempool-host  (no trailing /tx)";
                accepted(t) => { root.set-explorer-custom(t); }
            }
        }
        SettingsCard {
            title: "Coins";
            subtitle: root.coins-summary;
            GhostButton {
                text: "View wallet coins…";
                clicked => { root.open-coins(); }
            }
        }
        SettingsCard {
            title: "Sweep wallet";
            subtitle: root.watch-only
                ? "Leaving this wallet: move everything (minus the fee) to an address you choose. Watch-only: you'll sign on your external wallet."
                : "Leaving this wallet: EVERY notebook's coins go to an address you choose, in one transaction (minus the fee). To move coins between notebooks, use Consolidate instead.";
            GhostButton {
                text: "Sweep wallet…";
                clicked => { root.sweep-open(); }
            }
        }
        SettingsCard {
            title: "Consolidate wallet";
            subtitle: root.watch-only
                ? "Combine this wallet's coins into one. Watch-only: signs on your external wallet."
                : "Gather EVERY notebook's coins into one coin at an address you pick — used or new. One transaction; all source addresses become publicly linked on-chain.";
            GhostButton {
                text: "Consolidate wallet…";
                clicked => { root.consolidate-wallet-open(); }
            }
        }
        SettingsCard {
            title: "Backup";
            subtitle: root.watch-only
                ? "Shows the watch-only key material (xpub) you imported — stored in your keychain, and in iCloud if enabled, like any key. It can't spend and can't read private notes."
                : "Shows the exact key material you imported or created. Anyone who sees it controls the funds and every private note.";
            GhostButton { text: "Reveal backup  ·  asks for \{root.biometric-name}"; clicked => { root.reveal-backup(); } }
            if root.reveal-text != "": VerticalLayout {
                spacing: 8px;
                Rectangle {
                    border-radius: 10px;
                    background: Pal.warn.with-alpha(0.10);
                    border-width: 1px;
                    border-color: Pal.warn.with-alpha(0.4);
                    height: rv.preferred-height + 28px;
                    rv := Mono {
                        x: 14px;
                        y: 14px;
                        width: parent.width - 28px;
                        text: root.reveal-text;
                    }
                }
                GhostButton { text: "Hide"; clicked => { root.hide-backup(); } }
            }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
            }
        }
    }

    // ---------- 9 · account picker ----------
    if screen == 9: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: root.account-pick-mode == "notebook" ? "New notebook"
                : (root.account-pick-mode == "wconsol" ? "Consolidate to" : "Choose account");
            back => { root.nav-back(); }
        }
        Caption {
            text: root.account-pick-mode == "notebook"
                ? "Name it, then pick its address. Used addresses already have on-chain history — picking one adopts its notes."
                : (root.account-pick-mode == "wconsol"
                    ? "Where should every coin end up? Pick one of your notebooks, or a used/new address — it becomes a notebook you can name from the list."
                    : "One seed holds many BIP-86 accounts. Each is a completely separate notebook: its own address, its own encryption key, its own notes.");
        }
        // Create mode only: the name lives right here — tapping an
        // address creates immediately (no second dialog). The consolidate
        // picker deliberately has NO name field: most picks are existing
        // notebooks (a typed name would be dead input); a fresh destination
        // starts as the address short form, renameable from the list.
        if root.account-pick-mode == "notebook": EditField {
            text <=> root.nb-create-name;
            placeholder-text: "name (optional — empty = address short form)";
        }
        for a in root.accounts: Rectangle {
            // Rows already added as notebooks are informational-only when
            // CREATING (can't re-add); as a consolidate DESTINATION they
            // are first-class choices.
            property <bool> row-disabled: a.pill == "notebook" && root.account-pick-mode == "notebook";
            border-radius: 12px;
            border-width: 1px;
            border-color: a.active ? Pal.accent : Pal.line;
            background: at.has-hover && !self.row-disabled ? Pal.card-hover : Pal.card;
            opacity: self.row-disabled ? 0.45 : 1.0;
            height: al.preferred-height;
            at := TouchArea {
                enabled: !parent.row-disabled;
                clicked => { root.pick-account(a.index); }
            }
            al := VerticalLayout {
                padding: 14px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "Account " + a.index;
                        font-size: 14px;
                        font-weight: 700;
                        color: a.active ? Pal.accent : Pal.text;
                    }
                    if a.pill != "": Badge {
                        label: a.pill;
                        tint: a.pill == "new" ? Pal.good
                            : (a.pill == "used" ? Pal.warn : Pal.muted);
                    }
                    Rectangle { }
                    if a.balance != "": Caption { text: a.balance; vertical-alignment: center; }
                    if a.active: Badge { label: "current"; tint: Pal.accent; }
                }
                Mono {
                    text: a.address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            GhostButton {
                width: 90px;
                text: "‹ Prev";
                clicked => { root.accounts-page(-1); }
            }
            Caption {
                text: "accounts " + (root.account-page * 5) + " – " + (root.account-page * 5 + 4);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            GhostButton {
                width: 90px;
                text: "Next ›";
                clicked => { root.accounts-page(1); }
            }
        }
    }

    // ---------- 10 · coins ----------
    if screen == 10: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Coins";
            back => { root.nav-back(); }
            SvgIconButton { icon: "refresh"; clicked => { root.refresh-coins(); } }
        }
        Caption {
            text: root.watch-only
                ? "Every notebook's unspent outputs — a note tx spends from its own notebook's coins. To combine them, use Settings → Consolidate wallet (signs on your external wallet)."
                : "Every notebook's unspent outputs — a note tx spends from its own notebook's coins. To combine them into one coin, use Settings → Consolidate wallet; to move one notebook's funds, Settings → Funds → Sweep.";
        }
        // Pure viewer since consolidation moved to Settings ("Consolidate
        // wallet…" — wallet-level, all notebooks at once).
        Body { text: root.coins-summary; font-size: 12px; }
        Flickable {
            viewport-height: coins-col.preferred-height;
            coins-col := VerticalLayout {
                spacing: 8px;
                alignment: start;
                for c in root.coins: Rectangle {
                    height: cil.preferred-height;
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    cil := VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: c.value + " sats";
                                font-size: 13px;
                                font-weight: 700;
                                color: Pal.text;
                            }
                            if c.notebook != "": Badge { label: c.notebook; tint: Pal.muted; }
                            Rectangle { }
                            Badge {
                                label: c.status;
                                tint: c.status == "confirmed" ? Pal.good : Pal.warn;
                            }
                        }
                        Mono {
                            text: c.outpoint;
                            font-size: 10px;
                            color: Pal.muted;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // ---------- 11 · activity (transactions) ----------
    if screen == 11: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Activity";
            back => { root.nav-back(); }
        }
        Caption { text: root.activity-summary; }
        Flickable {
            viewport-height: act-col.preferred-height;
            act-col := VerticalLayout {
                spacing: 8px;
                alignment: start;
                for a in root.activity: Rectangle {
                    height: ail.preferred-height;
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    ail := VerticalLayout {
                        padding: 12px;
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: a.kind;
                                font-size: 12px;
                                font-weight: 700;
                                color: Pal.text;
                            }
                            if a.notebook != "": Badge { label: a.notebook; tint: Pal.muted; }
                            Rectangle { }
                            if a.replaced != "": Badge { label: a.replaced; tint: Pal.faint; }
                            Badge {
                                label: a.status;
                                tint: a.status == "confirmed" ? Pal.good
                                    : (a.status == "pending" ? Pal.warn : Pal.bad);
                            }
                        }
                        Body { text: a.title; font-size: 12px; overflow: elide; }
                        Caption { text: a.fee-line; }
                        Mono {
                            text: a.txid;
                            font-size: 10px;
                            color: Pal.muted;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if a.pending: GhostButton {
                                width: 96px;
                                height: 30px;
                                text: "Speed up";
                                clicked => { root.act-bump-open(a.ref-id, a.is-note); }
                            }
                            if a.pending: GhostButton {
                                width: 108px;
                                height: 30px;
                                text: "Rebroadcast";
                                clicked => { root.act-retry(a.ref-id, a.is-note); }
                            }
                            if a.explorer != "": GhostButton {
                                width: 92px;
                                height: 30px;
                                text: "Explorer";
                                clicked => { root.act-explorer(a.explorer); }
                            }
                        }
                    }
                }
            }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 12 · funding wallet (external PSBT source) ----------
    if screen == 12: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Add wallet";
            back => { root.nav-back(); }
        }
        Caption {
            text: "Paste or scan an output descriptor / xpub, or scan your hardware wallet's account-export QR. Its key never leaves that wallet — you'll sign there.";
        }
        HorizontalLayout {
            spacing: 8px;
            EditField {
                text <=> root.funding-descriptor;
                placeholder-text: "tr([…]xpub…/<0;1>/*)  or  xpub…";
                edited => { root.funding-changed(self.text); }
            }
            ScanButton { clicked => { root.funding-scan(); } }
        }
        if root.desktop-platform: HorizontalLayout {
            alignment: start;
            GhostButton {
                width: 140px;
                text: "Load from file…";
                clicked => { root.funding-file(); }
            }
        }
        if root.funding-feedback != "": Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: root.funding-valid ? Pal.good.with-alpha(0.5) : Pal.bad.with-alpha(0.5);
            height: fbl.preferred-height;
            fbl := VerticalLayout {
                padding: 14px;
                Body {
                    text: root.funding-feedback;
                    color: root.funding-valid ? Pal.good : Pal.bad;
                }
            }
        }
        PrimaryButton {
            text: "Save & use";
            tint: root.funding-valid ? Pal.accent : Pal.faint;
            tint-hover: root.funding-valid ? Pal.accent-hover : Pal.faint;
            clicked => { if (root.funding-valid) { root.funding-use(); } }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 13 · export PSBT (sign externally) ----------
    if screen == 13: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Sign externally";
            // Funding flow came from compose (6); watch spends from settings (8).
            back => { root.nav-back(); }
        }
        Caption {
            text: root.desktop-platform
                ? "Scan this with your wallet (or save the file), sign it there, then bring the signed PSBT back."
                : "Scan this with your wallet, sign it there, then bring the signed PSBT back.";
        }
        if root.psbt-cost-line != "": Text {
            text: root.psbt-cost-line;
            font-size: 13px;
            font-weight: 600;
            color: Pal.accent;
            horizontal-alignment: center;
        }
        // Square card snug around the code — the old full-width card left
        // walls of white either side of the QR.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 312px;
                height: 312px;
                border-radius: 14px;
                background: #FFFFFF;
                Image {
                    source: root.psbt-qr;
                    width: 288px;
                    height: 288px;
                    x: (parent.width - 288px) / 2;
                    y: (parent.height - 288px) / 2;
                    image-rendering: pixelated;
                }
            }
        }
        if root.psbt-frame-label != "": Caption {
            text: root.psbt-frame-label;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 10px;
            if root.desktop-platform: GhostButton { text: "Save .psbt"; clicked => { root.psbt-save(); } }
            GhostButton { text: "Copy"; clicked => { root.psbt-copy(); } }
        }
        PrimaryButton {
            text: "I've signed it — Review";
            clicked => { root.psbt-goto-import(); }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 14 · import signed PSBT + confirmation ----------
    if screen == 14: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Review + broadcast";
            back => { root.nav-back(); }
        }
        if !root.psbt-signed: Caption {
            text: root.desktop-platform
                ? "Load the signed PSBT from your wallet — file or QR."
                : "Scan the signed PSBT from your wallet.";
        }
        if !root.psbt-signed: HorizontalLayout {
            spacing: 10px;
            if root.desktop-platform: GhostButton { text: "Load .psbt file"; clicked => { root.psbt-import-file(); } }
            GhostButton { text: "Scan QR"; clicked => { root.psbt-import-scan(); } }
        }
        if root.psbt-signed: Flickable {
            viewport-height: conf-col.preferred-height;
            conf-col := VerticalLayout {
                spacing: 10px;
                alignment: start;
                Rectangle {
                    border-radius: 10px;
                    background: Pal.accent.with-alpha(0.08);
                    border-width: 1px;
                    border-color: Pal.accent.with-alpha(0.35);
                    height: ncard.preferred-height;
                    ncard := VerticalLayout {
                        padding: 14px;
                        spacing: 6px;
                        Caption { text: "NOTE"; color: Pal.accent; }
                        Body { text: root.confirm-note; }
                    }
                }
                Caption { text: "INPUTS"; }
                for i in root.confirm-inputs: Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: irow.preferred-height;
                    irow := HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Mono { text: i.title; font-size: 11px; overflow: elide; wrap: no-wrap; }
                            Caption { text: i.subtitle; font-size: 10px; overflow: elide; }
                        }
                        Mono {
                            text: i.amount + " sats";
                            color: Pal.text;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
                Caption { text: "OUTPUTS"; }
                for o in root.confirm-outputs: Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: o.kind == "self" ? Pal.good.with-alpha(0.4)
                        : (o.kind == "recipient" ? Pal.accent.with-alpha(0.4) : Pal.line);
                    height: orow.preferred-height;
                    orow := HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Badge {
                                    label: o.kind;
                                    tint: o.kind == "self" ? Pal.good
                                        : (o.kind == "recipient" ? Pal.accent
                                        : (o.kind == "change" ? Pal.faint
                                        : (o.kind == "note" ? Pal.accent : Pal.muted)));
                                }
                            }
                            if o.title != "": Mono { text: o.title; font-size: 11px; overflow: elide; wrap: no-wrap; }
                            if o.subtitle != "": Caption { text: o.subtitle; font-size: 10px; overflow: elide; }
                        }
                        Mono {
                            text: o.amount + " sats";
                            color: o.kind == "self" ? Pal.good : Pal.text;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: frow.preferred-height;
                    frow := HorizontalLayout {
                        padding: 14px;
                        Text {
                            text: "Network fee";
                            font-size: 13px;
                            color: Pal.muted;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Mono { text: root.confirm-fee-line; color: Pal.text; }
                    }
                }
            }
        }
        if root.psbt-signed: PrimaryButton {
            text: "Broadcast";
            clicked => { root.psbt-broadcast(); }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 15 · funding wallets (manager list) ----------
    if screen == 15: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Funding wallets";
            back => { root.nav-back(); }
        }
        Caption {
            text: "Watch-only wallets that can pay for your notes. Tap one to use it, or add another.";
        }
        if root.funding-wallets.length == 0: Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: 60px;
            Caption {
                text: "No funding wallets yet — add one below.";
                horizontal-alignment: center;
                x: 0; width: parent.width;
                y: (parent.height - self.preferred-height) / 2;
            }
        }
        Flickable {
            viewport-height: fw-col.preferred-height;
            fw-col := VerticalLayout {
                spacing: 8px;
                alignment: start;
                for fw in root.funding-wallets: Rectangle {
                    height: fw-row.preferred-height;
                    border-radius: 10px;
                    background: fwta.has-hover ? Pal.card-hover : Pal.card;
                    border-width: 1px;
                    border-color: fw.active ? Pal.accent : Pal.line;
                    fwta := TouchArea { clicked => { root.use-funding-wallet(fw.id); } }
                    fw-row := HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: fw.label;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Pal.text;
                                    overflow: elide;
                                }
                                if fw.active: Badge { label: "active"; tint: Pal.accent; }
                            }
                            Caption { text: fw.meta; }
                        }
                        PencilButton { clicked => { root.fund-rename-start(fw.id, fw.label); } }
                        SvgIconButton {
                            icon: "refresh";
                            size: 14px;
                            width: 32px;
                            height: 32px;
                            clicked => { root.refresh-funding-wallet(fw.id); }
                        }
                        IconButton {
                            glyph: "×";
                            glyph-size: 18px;
                            glyph-color: Pal.bad;
                            width: 32px;
                            height: 32px;
                            clicked => { root.remove-funding-wallet(fw.id); }
                        }
                    }
                }
            }
        }
        Rectangle { }
        PrimaryButton {
            text: "+  Add wallet";
            clicked => { root.add-funding-wallet(); }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 16 · sweep (compose-like, minus the note text) ----------
    if screen == 16: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: root.sweep-kind == "consolidate" ? "Consolidate" : "Sweep";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-height: sweep-col.preferred-height;
            sweep-col := VerticalLayout {
                spacing: 12px;
                Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: 34px;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: root.sweep-to-label;
                        font-size: 12px;
                        color: Pal.muted;
                        overflow: elide;
                    }
                }
                if root.sweep-dest-note != "": Caption { text: root.sweep-dest-note; color: Pal.warn; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    SelectPill { text: "economy"; active: root.sweep-tier == 0; clicked => { root.set-sweep-tier(0); } }
                    SelectPill { text: "normal"; active: root.sweep-tier == 1; clicked => { root.set-sweep-tier(1); } }
                    SelectPill { text: "fast"; active: root.sweep-tier == 2; clicked => { root.set-sweep-tier(2); } }
                    SelectPill { text: "custom"; active: root.sweep-tier == 3; clicked => { root.sweep-tier = 3; root.sweep-rate-changed(); } }
                }
                if root.sweep-tier == 3: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    EditField {
                        width: 84px;
                        text <=> root.sweep-rate-text;
                        edited => { root.sweep-rate-changed(); }
                    }
                    Caption { text: "sat/vB"; vertical-alignment: center; }
                }
                if root.sweep-cost-line != "": Text {
                    text: root.sweep-cost-line;
                    font-size: 13px;
                    font-weight: 600;
                    color: Pal.accent;
                }
                // ---- pay the fee from another wallet (watch-only: the
                // external signer's full-value transfer needs it; keyed
                // sweeps pay their own fee out of the swept amount) ----
                if root.watch-only: HorizontalLayout {
                    Switch {
                        text: "Pay the fee from another wallet";
                        checked <=> root.sweep-fund-external;
                        toggled => { root.toggle-sweep-fund-external(self.checked); }
                    }
                    Rectangle { }
                }
                if root.sweep-fund-external: Caption {
                    text: "The full balance arrives at the destination. The fee comes out of the funding wallet; its change returns there.";
                }
                if root.sweep-fund-external: Rectangle {
                    border-radius: 10px;
                    background: sftap.has-hover ? Pal.card-hover : Pal.card;
                    border-width: 1px;
                    border-color: root.funding-ready ? Pal.line : Pal.accent.with-alpha(0.5);
                    height: 44px;
                    sftap := TouchArea { clicked => { root.funding-return = 16; root.open-funding(); } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: root.funding-summary;
                            font-size: 12px;
                            color: root.funding-ready ? Pal.text : Pal.accent;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text { text: "›"; font-size: 22px; color: Pal.muted; vertical-alignment: center; }
                    }
                }
                // ---- inputs (read-only: a sweep spends everything) ----
                Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: sw-in-col.preferred-height;
                    sw-in-col := VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Rectangle {
                            height: 22px;
                            TouchArea { clicked => { root.sweep-inputs-expanded = !root.sweep-inputs-expanded; } }
                            HorizontalLayout {
                                Text {
                                    text: root.sweep-inputs-title;
                                    font-size: 12px;
                                    color: Pal.muted;
                                    vertical-alignment: center;
                                }
                                Rectangle { }
                                Image {
                                    source: root.sweep-inputs-expanded
                                        ? @image-url("icons/caret-up.svg")
                                        : @image-url("icons/caret-down.svg");
                                    colorize: Pal.muted;
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - 16px) / 2;
                                }
                            }
                        }
                        if root.sweep-inputs-expanded: Caption {
                            text: "A sweep spends every spendable coin, so the inputs are fixed.";
                        }
                        if root.sweep-inputs-expanded: VerticalLayout {
                            spacing: 6px;
                            for c in root.sweep-coins: Rectangle {
                                height: 42px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Pal.accent;
                                background: Pal.accent.with-alpha(0.10);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: c.value + " sats";
                                            font-size: 12px;
                                            color: Pal.text;
                                        }
                                    }
                                    Rectangle { }
                                    VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            label: c.confirmed ? "confirmed" : "unconfirmed";
                                            tint: c.confirmed ? Pal.good : Pal.warn;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 22px;
                                            width: swpill.preferred-width + 14px;
                                            border-radius: 11px;
                                            border-width: 1px;
                                            border-color: Pal.line;
                                            background: swpta.has-hover && c.explorer != "" ? Pal.card-hover : transparent;
                                            swpta := TouchArea {
                                                clicked => { if (c.explorer != "") { root.act-explorer(c.explorer); } }
                                            }
                                            swpill := HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 7px;
                                                spacing: 4px;
                                                Text {
                                                    text: c.txid-short;
                                                    font-family: "Menlo";
                                                    font-size: 10px;
                                                    color: Pal.muted;
                                                    vertical-alignment: center;
                                                }
                                                if c.explorer != "": Image {
                                                    source: @image-url("icons/external.svg");
                                                    colorize: Pal.accent;
                                                    width: 11px;
                                                    height: 11px;
                                                    y: (parent.height - 11px) / 2;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if !root.sweep-fund-external && !root.watch-only: PrimaryButton {
                    text: root.sweep-kind == "consolidate" ? "Consolidate — sign + broadcast" : "Sweep — sign + broadcast";
                    clicked => { root.sweep-send(); }
                }
                if !root.sweep-fund-external && root.watch-only: PrimaryButton {
                    text: "Build transaction to sign";
                    clicked => { root.sweep-send(); }
                }
                if root.sweep-fund-external: PrimaryButton {
                    text: root.funding-ready ? "Build transaction to sign" : "Set a funding wallet first";
                    clicked => {
                        if (!root.funding-ready) {
                            root.funding-return = 16;
                            root.open-funding();
                        } else {
                            root.sweep-send();
                        }
                    }
                }
                Caption { text: root.status; color: Pal.bad; }
            }
        }
    }

    // ---------- shared camera-scan overlay (live preview) ----------
    if root.scanning: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.86);
        z: 200;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            padding: 24px;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: root.scan-hint;
                    color: Pal.text;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-width: 340px;
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 300px;
                    border-radius: 16px;
                    clip: true;
                    background: #0a0a0a;
                    border-width: 2px;
                    border-color: Pal.accent;
                    Image {
                        source: root.camera-frame;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 6px;
                    border-radius: 3px;
                    background: Pal.line;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: 100%;
                        width: parent.width * clamp(root.scan-progress, 0, 1);
                        background: Pal.accent;
                        border-radius: 3px;
                        animate width { duration: 150ms; }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Caption {
                    text: root.scan-progress > 0.001
                        ? "Collecting frames · \{round(root.scan-progress * 100)}%"
                        : "Hold your phone steady and fill the frame.";
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                alignment: center;
                GhostButton {
                    text: "Cancel";
                    min-width: 220px;
                    clicked => { root.cancel-scan(); }
                }
            }
        }
    }

    // ---------- funding-wallet rename (modal overlay) ----------
    if root.fund-rename-id != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.fund-rename-cancel(); } }
        Rectangle {
            width: 400px;
            height: frl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            frl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this wallet";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                EditField {
                    text <=> root.fund-rename-input;
                    placeholder-text: "wallet name";
                    accepted(t) => { root.fund-rename-save(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.fund-rename-cancel(); } }
                    PrimaryButton { text: "Save"; clicked => { root.fund-rename-save(root.fund-rename-input); } }
                }
            }
        }
    }

    // ---------- rename dialog (modal overlay) ----------
    if root.rename-address != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.cancel-rename(); } }
        Rectangle {
            width: 400px;
            height: dl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { } // swallow clicks on the card body
            dl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this contact";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Mono {
                    text: root.rename-address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
                rename-edit := EditField {
                    text <=> root.rename-input;
                    placeholder-text: "name (empty clears it)";
                    accepted(t) => { root.save-rename(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.cancel-rename(); } }
                    PrimaryButton { text: "Save"; clicked => { root.save-rename(root.rename-input); } }
                }
            }
        }
    }

    // ---------- notebook rename dialog (modal overlay) ----------
    if root.nb-rename-account >= 0: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.nb-rename-cancel(); } }
        Rectangle {
            width: 400px;
            height: nbl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { } // swallow clicks on the card body
            nbl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this notebook";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Caption { text: "The name stays on this device — it is never published."; }
                nb-rename-edit := EditField {
                    text <=> root.nb-rename-input;
                    placeholder-text: "name (empty = address short form)";
                    accepted(t) => { root.nb-rename-save(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.nb-rename-cancel(); } }
                    PrimaryButton { text: "Save"; clicked => { root.nb-rename-save(root.nb-rename-input); } }
                }
            }
        }
    }

    // ---------- remove-contact confirmation (modal overlay) ----------
    if root.confirm-remove-address != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.cancel-remove(); } }
        Rectangle {
            width: 400px;
            height: cl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            cl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Remove this contact?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                if root.confirm-remove-name != "": Body { text: root.confirm-remove-name; }
                Mono {
                    text: root.confirm-remove-address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Caption { text: "Only removes it from recents — sending to this address again re-adds it."; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.cancel-remove(); } }
                    PrimaryButton {
                        text: "Remove";
                        tint: Pal.bad;
                        tint-hover: #ff6b62;
                        clicked => { root.remove-contact(root.confirm-remove-address); }
                    }
                }
            }
        }
    }

    // ---------- wallet-consolidate confirmation (modal overlay) ----------
    if root.show-wconsol-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.show-wconsol-confirm = false; } }
        Rectangle {
            width: 400px;
            height: wcl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            wcl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Consolidate the whole wallet?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body { text: root.wconsol-summary; font-size: 12px; }
                Caption {
                    text: "One transaction spends every notebook's coins — all their addresses become publicly linked on-chain.";
                    color: Pal.warn;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.show-wconsol-confirm = false; } }
                    PrimaryButton { text: "Consolidate"; clicked => { root.wallet-consolidate(); } }
                }
            }
        }
    }

    // ---------- reset-identity confirmation (modal overlay) ----------
    if root.show-reset-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.show-reset-confirm = false; } }
        Rectangle {
            width: 400px;
            height: rl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            rl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Switch identity?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body {
                    text: "This removes the current key from this device and returns to onboarding, where you can create a new seed or import a different key (and pick its account).";
                    font-size: 12px;
                }
                Caption {
                    text: "Your notes and funds stay on-chain. Re-import the same key + account and everything comes back. Make sure the backup is written down — without it, this identity is gone.";
                    color: Pal.warn;
                }
                if root.icloud-backup: Caption {
                    text: "iCloud backup is ON — this also deletes the key from iCloud, so it will NOT return on reinstall. Your written backup is the only recovery.";
                    color: Pal.bad;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.show-reset-confirm = false; } }
                    PrimaryButton {
                        text: "Remove key & switch";
                        tint: Pal.bad;
                        tint-hover: #ff6b62;
                        clicked => { root.reset-identity(); }
                    }
                }
            }
        }
    }

    // ---------- sweep confirmation (modal overlay) ----------
    if root.show-sweep-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.show-sweep-confirm = false; } }
        Rectangle {
            width: 400px;
            height: sl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            sl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Sweep all funds?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body { text: root.balance-line; font-size: 12px; }
                Mono {
                    text: "To " + root.sweep-dest;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Caption { text: "Sends the entire balance (minus the fee). Pending notes' locked inputs are not touched."; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.show-sweep-confirm = false; } }
                    PrimaryButton {
                        text: "Sweep";
                        tint: Pal.bad;
                        tint-hover: #ff6b62;
                        clicked => { root.sweep(); }
                    }
                }
            }
        }
    }

    // ---------- consolidate confirmation (modal overlay) ----------
    if root.show-consolidate-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.show-consolidate-confirm = false; } }
        Rectangle {
            width: 400px;
            height: kl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            kl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Consolidate coins?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body {
                    text: "Combines all spendable coins into a single output back to your own address. Costs a fee now; saves on every future note.";
                    font-size: 12px;
                }
                Caption { text: root.coins-summary; }
                // Exact fee preview: a dry-run of the same tx builder the
                // Consolidate button broadcasts (same inputs → same vsize).
                if root.consolidate-fee-line != "": Text {
                    text: root.consolidate-fee-line;
                    font-size: 13px;
                    font-weight: 600;
                    color: Pal.accent;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.show-consolidate-confirm = false; } }
                    PrimaryButton { text: "Consolidate"; clicked => { root.consolidate(); } }
                }
            }
        }
    }

    // ---------- note-too-large dialog (modal overlay) ----------
    if root.show-oversize-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.show-oversize-modal = false; } }
        Rectangle {
            width: 400px;
            height: ol.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            ol := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Note too large";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body {
                    text: root.oversize-message;
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton {
                        text: root.oversize-offer-bump ? "Cancel" : "OK";
                        clicked => { root.show-oversize-modal = false; }
                    }
                    if root.oversize-offer-bump: PrimaryButton {
                        text: "Switch to Standard";
                        clicked => { root.oversize-bump(); }
                    }
                }
            }
        }
    }

    // ---------- speed-up (RBF bump) dialog ----------
    if root.show-bump-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.show-bump-dialog = false; } }
        Rectangle {
            width: 400px;
            height: bl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            bl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Speed up transaction";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body { text: root.bump-kind; font-size: 12px; }
                Caption { text: root.bump-current; }
                HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        width: 96px;
                        text <=> root.bump-rate;
                        edited => { root.act-bump-rate-changed(self.text); }
                    }
                    Caption { text: "sat/vB"; vertical-alignment: center; }
                }
                Body { text: root.bump-new-fee; font-size: 13px; font-weight: 600; color: Pal.accent; }
                Caption { text: root.bump-min; color: Pal.warn; }
                if root.bump-error != "": Caption { text: root.bump-error; color: Pal.bad; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.show-bump-dialog = false; } }
                    PrimaryButton { text: "Replace & broadcast"; clicked => { root.act-bump-confirm(); } }
                }
            }
        }
    }

    // Splash cover — the topmost child, so it hides everything until Rust
    // flips `ready` (once the safe-area inset is known). Prevents the content
    // from visibly sliding down from under the status bar on cold start.
    if !root.ready: Rectangle {
        width: 100%;
        height: 100%;
        background: Pal.bg;
    }
    } // end back-scope (system back)
}

// M6 screens, designed. Dark theme, bitcoin-orange accent, card-based
// layout. Property/callback names are the contract with main.rs — do
// not rename. Router: `screen` property; every action emits a cb: line
// on the Rust side.
// AboutSlint carries the "Made with Slint" mark. It is REQUIRED, not
// decoration: this app ships under the Slint Royalty-free Desktop, Mobile
// and Web Applications License 2.0, whose section 2 grants the license
// only if the app either shows this widget in an About screen reachable
// from the top level, or carries the attribution badge on its download
// page. We do both -- see THIRD-PARTY.md.
import { ListView, Switch, AboutSlint } from "std-widgets.slint";
import { Pal, Metrics } from "theme.slint";
import { EditOps, EditField, EditArea } from "edit.slint";
import { Screen, NoteItem, NotebookItem, SenderItem, ContactItem, RevealRow, NbPickRow, AccountItem, CoinItem, SpendingCoinItem, SpendCoin, PsbtRow, FundingWalletRow, ActivityItem } from "types.slint";
import { Ui, Modals, Info, Terms, Settings, BackupWords, ImportKey, Quiz, Home, Note, Compose, Change, PayFrom, Sweep, FundingWalletScreen, ExportPsbt, Confirm, Coins, AccountPicker, PublicKeys, PrivateKeys, QuantumKeys, Activity, Onboarding, Dice, EntropySource, Contacts, FundingWallets, ImportSignedPsbt, Notebooks } from "globals.slint";
import { H1, Body, Caption, Mono, Card, PrimaryButton, GhostButton, IconButton, SvgIconButton, SyncButton, BackButton, Header, Badge, CopyButton, QrSpinner, QrArea, PencilButton, WebViewButton, ScanButton, SelectPill, Dropdown, SettingsCard, KvRow, DoorCard, CoinListPanel, TxConfirmView } from "components.slint";
// One Slint file per screen (U3b) — each `if Ui.screen == Screen.<x>:` body
// below now just instantiates the matching component.
import { OnboardingScreen } from "screens/onboarding.slint";
import { ImportKeyScreen } from "screens/import-key.slint";
import { BackupWordsScreen } from "screens/backup-words.slint";
import { QuizScreen } from "screens/quiz.slint";
import { HomeScreen } from "screens/home.slint";
import { NoteScreen } from "screens/note.slint";
import { ComposeScreen } from "screens/compose.slint";
import { ContactsScreen } from "screens/contacts.slint";
import { SettingsScreen } from "screens/settings.slint";
import { AccountPickerScreen } from "screens/account-picker.slint";
import { CoinsScreen } from "screens/coins.slint";
import { ActivityScreen } from "screens/activity.slint";
import { FundingWalletDetailScreen } from "screens/funding-wallet.slint";
import { ExportPsbtScreen } from "screens/export-psbt.slint";
import { ImportSignedPsbtScreen } from "screens/import-signed-psbt.slint";
import { FundingWalletsScreen } from "screens/funding-wallets.slint";
import { SweepScreen } from "screens/sweep.slint";
// Rust (src/lib.rs, via slint::include_modules!()) needs these re-exported
// from the entry-point file.
export { Metrics, EditOps, Screen, NoteItem, NotebookItem, SenderItem, ContactItem, RevealRow, NbPickRow, AccountItem, CoinItem, SpendingCoinItem, SpendCoin, PsbtRow, FundingWalletRow, ActivityItem, Ui, Modals, Info, Terms, Settings, BackupWords, ImportKey, Quiz, Home, Note, Compose, Change, PayFrom, Sweep, FundingWalletScreen, ExportPsbt, Confirm, Coins, AccountPicker, PublicKeys, PrivateKeys, QuantumKeys, Activity, Onboarding, Dice, EntropySource, Contacts, FundingWallets, ImportSignedPsbt, Notebooks }

export component AppWindow inherits Window {
    preferred-width: 480px;
    preferred-height: 780px;
    min-width: 440px;
    min-height: 620px;
    title: "Graffito";
    background: Pal.bg;
    init => { EditOps.win-width = self.width; }
    changed width => { EditOps.win-width = self.width; }
















    function nav-back() -> bool {
        // Overlays first, topmost (= last window child) before the rest —
        // back closes the same thing a tap on Cancel / the dim would.
        if (Ui.show-dice-clear-confirm) { Ui.show-dice-clear-confirm = false; return true; }
        if (Ui.qr-zoom-open) { Ui.qr-zoom-open = false; return true; }
        if (Ui.show-bump-dialog) { Ui.show-bump-dialog = false; return true; }
        if (Ui.show-oversize-modal) { Ui.show-oversize-modal = false; return true; }
        if (Ui.show-reset-confirm) { Ui.show-reset-confirm = false; return true; }
        if (Ui.confirm-remove-address != "") { Ui.cancel-remove(); return true; }
        if (Ui.rename-address != "") { Ui.cancel-rename(); return true; }
        if (Ui.fund-rename-id != "") { Ui.fund-rename-cancel(); return true; }
        if (Ui.nb-rename-index >= 0) { Ui.nb-rename-cancel(); return true; }
        if (Ui.scanning) { Ui.cancel-scan(); return true; }
        // Screens: one branch per header chevron.
        if (Ui.screen == Screen.import-key || Ui.screen == Screen.backup-words) { Ui.screen = Screen.onboarding; return true; }
        // Entropy-source door → back to onboarding; dice entry → back to the
        // door (so "This device" is still one tap away mid-roll).
        if (Ui.screen == Screen.entropy-source) { Ui.screen = Screen.onboarding; return true; }
        if (Ui.screen == Screen.dice) { Ui.screen = Screen.entropy-source; return true; }
        if (Ui.screen == Screen.home) { Ui.open-notebooks(); return true; }
        if (Ui.screen == Screen.quiz) { Ui.screen = Screen.backup-words; return true; }
        if (Ui.screen == Screen.note) { Ui.go-home(); return true; }
        if (Ui.screen == Screen.settings || Ui.screen == Screen.activity) {
            // Back to wherever settings/activity was opened from.
            if (Ui.return-screen == Screen.notebooks) { Ui.open-notebooks(); } else { Ui.go-home(); }
            return true;
        }
        if (Ui.screen == Screen.compose) {
            // Clear the typed address on the way back — it's saved in recents
            // now, so leaving it in the field is redundant. Status too: its
            // message belonged to this screen.
            Ui.contact-input = "";
            Ui.status = "";
            Ui.screen = Ui.compose-return;
            return true;
        }
        if (Ui.screen == Screen.contacts) {
            if (Ui.pick-mode == "sweep") {
                Ui.pick-mode = "compose";
                Ui.screen = Screen.settings;
            } else if (Ui.picking-extra) {
                // "+ Add recipient" reopened the picker on top of compose —
                // back returns to compose, not home.
                Ui.picking-extra = false;
                Ui.screen = Screen.compose;
            } else {
                Ui.go-home();
            }
            return true;
        }
        if (Ui.screen == Screen.account-picker) { Ui.account-cancel(); return true; }
        if (Ui.screen == Screen.coins) { Ui.screen = Screen.settings; return true; }
        if (Ui.screen == Screen.funding-wallet) { Ui.open-funding(); return true; }
        if (Ui.screen == Screen.export-psbt) { Ui.screen = Ui.watch-only ? Screen.settings : Screen.compose; return true; }
        if (Ui.screen == Screen.import-signed-psbt) { Ui.screen = Screen.export-psbt; return true; }
        if (Ui.screen == Screen.funding-wallets) { Ui.screen = Ui.funding-return; return true; }
        if (Ui.screen == Screen.sweep) {
            // Clear the typed address + any stale status on the way back —
            // success messages otherwise linger red on the picker. Sweep
            // returns to its destination picker, consolidate to the coins.
            Ui.contact-input = "";
            Ui.status = "";
            if (Ui.sweep-kind == "consolidate") {
                Ui.screen = Screen.coins;
            } else {
                Ui.pick-mode = "sweep";
                Ui.screen = Screen.contacts;
            }
            return true;
        }
        // Pay-from (screen 20): reached only from compose's compact row —
        // back always returns to compose, draft untouched (no field wipes,
        // unlike screen 6's own back-to-picker branch above).
        if (Ui.screen == Screen.pay-from) { Ui.screen = Screen.compose; return true; }
        // Change (screen 21): reached only from compose's second nav row —
        // back returns to compose too (a sibling of the Pay-from row, not
        // nested under screen 20).
        if (Ui.screen == Screen.change) { Ui.screen = Screen.compose; return true; }
        if (Ui.screen == Screen.public-keys || Ui.screen == Screen.private-keys) {
            Ui.reveal-hide();
            Ui.screen = Screen.settings;
            return true;
        }
        if (Ui.screen == Screen.quantum-keys) {
            Ui.pq-show-backup-confirm = false;
            Ui.pq-show-replace-confirm = false;
            if (Ui.pq-show-export-private-confirm) {
                Ui.pq-imported-hide-private();
            }
            Ui.pq-show-export-private-confirm = false;
            Ui.screen = Screen.settings;
            return true;
        }
        // Terms & disclaimer: the first-run accept gate can't be skipped with
        // back; the read-only re-view returns to Settings.
        if (Ui.screen == Screen.terms) {
            if (Ui.terms-accept-mode) { return false; }
            Ui.screen = Screen.settings;
            return true;
        }
        if (Ui.screen == Screen.info) { Ui.screen = Screen.settings; return true; } // info → Settings
        // Universal confirm screen: back always cancels (never a bare nav —
        // Rust's on_confirm_cancel clears the pending broadcast + props and
        // picks the return screen), so Android back can't quit from here.
        if (Ui.screen == Screen.confirm) { Ui.confirm-cancel(); return true; }
        return false; // 0 onboarding / 17 notebook list: nothing to go back to
    }

    back-scope := FocusScope {
        focus-on-click: false; // never steal a tap's focus from a field
        focus-on-tab-navigation: false; // no invisible Tab stop between fields
        init => { self.focus(); }
        // The Down press decides (and navigates); the matching Up must replay
        // the same verdict — Android only runs its own default when it saw
        // the whole tracked down+up pair unhandled. Repeats replay too, so a
        // long-press can't navigate several screens at once.
        property <bool> back-eaten: false;
        // Focus must never be nobody's, or key events (incl. Back) are dropped
        // before they can bubble anywhere: re-take it whenever the focused
        // element may just have been destroyed -- a screen change, or one of the
        // two self-focusing rename dialogs closing. (Bridged from Ui via
        // two-way mirror properties: a global cannot call `self.focus()` on this
        // AppWindow-local FocusScope, so the `changed` observers that used to
        // live directly on AppWindow live here instead, watching mirrors of the
        // now-global properties.)
        property <Screen> mirror-screen <=> Ui.screen;
        property <string> mirror-rename-address <=> Ui.rename-address;
        property <string> mirror-fund-rename-id <=> Ui.fund-rename-id;
        property <int> mirror-nb-rename-index <=> Ui.nb-rename-index;
        // U3b: same mirror trick for the two nonces extracted screens/modals
        // bump instead of calling `back-scope.focus()` / `root.nav-back()`
        // directly (see Ui.focus-back-scope-nonce / Ui.nav-back-nonce).
        property <int> mirror-focus-nonce <=> Ui.focus-back-scope-nonce;
        property <int> mirror-nav-back-nonce <=> Ui.nav-back-nonce;
        changed mirror-screen => { self.focus(); }
        changed mirror-rename-address => { if (mirror-rename-address == "") { self.focus(); } }
        changed mirror-fund-rename-id => { if (mirror-fund-rename-id == "") { self.focus(); } }
        changed mirror-nb-rename-index => { if (mirror-nb-rename-index < 0) { self.focus(); } }
        changed mirror-focus-nonce => { self.focus(); }
        changed mirror-nav-back-nonce => { root.nav-back(); }
        key-pressed(event) => {
            if (event.text != Key.Back) { return reject; }
            if (!event.repeat) {
                back-eaten = root.nav-back();
                Ui.back-logged(back-eaten, Ui.screen);
            }
            return back-eaten ? accept : reject;
        }
        key-released(event) => {
            return (event.text == Key.Back && back-eaten) ? accept : reject;
        }

    // NOTE: back-scope wraps every window child from here down to its
    // matching closing brace at the bottom of the file; the children keep
    // their original one-level indent (mechanical wrap — slint is
    // whitespace-insensitive, and re-indenting ~2200 lines would bury the
    // file's history).

    // GLOBAL keyboard-dismiss layer (Sal 2026-08-01: "keyboard should always
    // be dismissable when tapping other parts of the app"). It is the FIRST
    // child of back-scope, so it fills the window and sits UNDER every screen
    // — later siblings win input in slint, so any interactive child (field,
    // button, pill, modal) still grabs its own tap and this only ever fires
    // on genuinely empty space. Moving focus to back-scope is what drops the
    // on-screen keyboard; never clear-focus(), which would leave Android's
    // Back key undeliverable (see the system-back note above).
    //
    // This covers every screen whose root is a plain VerticalLayout — screen
    // 2's extra-entropy field and screen 3's quiz answer among them. It does
    // NOT reach inside a Flickable, which intercepts pointer events across
    // its own region, so each Flickable holding a text field carries its own
    // copy of this layer (screens 6, 8, 16, 21 — search "dismiss layer").
    TouchArea { clicked => { back-scope.focus(); } }

    if Ui.screen == Screen.onboarding: OnboardingScreen { }

    if Ui.screen == Screen.import-key: ImportKeyScreen { }

    if Ui.screen == Screen.backup-words: BackupWordsScreen { }

    if Ui.screen == Screen.quiz: QuizScreen { }

    if Ui.screen == Screen.home: HomeScreen { }

    // ---------- 17 · notebooks (the main screen) ----------
    if Ui.screen == Screen.notebooks: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 40px;
            Text {
                text: "Graffito";
                font-size: 19px;
                font-weight: 700;
                color: Pal.text;
                vertical-alignment: center;
            }
            Rectangle { }
            SyncButton {
                net-busy: Ui.net-busy;
                sync => { Ui.refresh-notebooks(); }
                busy-tapped => { Ui.sync-busy-toast(); }
            }
            SvgIconButton { icon: "activity"; clicked => { Ui.open-activity(); } }
            IconButton { glyph: "⚙"; clicked => { Notebooks.settings-open(); } }
        }
        if Notebooks.can-create-notebook: PrimaryButton { text: "+  New notebook"; clicked => { Notebooks.create-notebook(); } }
        Caption { text: Ui.status; }
        // Zero active notebooks is a legitimate state (fresh start, or
        // everything archived) — say so instead of showing a blank page.
        if Ui.notebooks.length == 0: Caption {
            text: Notebooks.archived-toggle-label != ""
                ? "All notebooks are archived."
                : (Notebooks.can-create-notebook
                    ? "No notebooks yet — create one to start writing."
                    : "No notebooks yet.");
        }
        Flickable {
            viewport-height: nb-col.preferred-height;
            nb-col := VerticalLayout {
                alignment: start;
                spacing: 6px;
                for nb in Ui.notebooks: Rectangle {
                    height: 86px;
                    nb-ta := TouchArea { clicked => { Notebooks.open-notebook(nb.index); } }
                    Rectangle {
                        y: 2px;
                        height: parent.height - 6px;
                        border-radius: 10px;
                        background: nb-ta.has-hover ? Pal.card-hover : Pal.card;
                        border-width: 1px;
                        border-color: nb.active ? Pal.accent.with-alpha(0.55) : Pal.line;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 4px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: nb.name;
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Pal.text;
                                        overflow: elide;
                                    }
                                    if nb.unread != "": Badge { label: nb.unread; tint: Pal.good; }
                                }
                                Caption { text: nb.snippet; overflow: elide; }
                                Caption { text: nb.meta; color: Pal.faint; }
                            }
                            VerticalLayout {
                                alignment: center;
                                PencilButton { clicked => { Notebooks.nb-rename-start(nb.index, nb.name); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                SvgIconButton {
                                    icon: "archive";
                                    size: 15px;
                                    width: 32px;
                                    height: 32px;
                                    clicked => { Notebooks.nb-archive(nb.index, true); }
                                }
                            }
                        }
                    }
                }
                if Notebooks.archived-toggle-label != "": Rectangle {
                    height: 34px;
                    arch-ta := TouchArea { clicked => { Notebooks.show-archived = !Notebooks.show-archived; } }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Caption { text: Notebooks.archived-toggle-label; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: Notebooks.show-archived
                                    ? @image-url("icons/caret-up.svg")
                                    : @image-url("icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 12px;
                                height: 12px;
                            }
                        }
                    }
                }
                if Notebooks.show-archived: VerticalLayout {
                    spacing: 6px;
                    for nb in Notebooks.archived-notebooks: Rectangle {
                        height: 56px;
                        anb-ta := TouchArea { clicked => { Notebooks.open-notebook(nb.index); } }
                        Rectangle {
                            y: 2px;
                            height: parent.height - 6px;
                            border-radius: 10px;
                            background: anb-ta.has-hover ? Pal.card-hover : Pal.card;
                            border-width: 1px;
                            border-color: Pal.line;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: nb.name;
                                        font-size: 13px;
                                        color: Pal.muted;
                                        overflow: elide;
                                    }
                                    Caption { text: nb.meta; color: Pal.faint; }
                                }
                                Rectangle { }
                                VerticalLayout {
                                    alignment: center;
                                    GhostButton { text: "Restore"; clicked => { Notebooks.nb-archive(nb.index, false); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    if Ui.screen == Screen.note: NoteScreen { }

    if Ui.screen == Screen.compose: ComposeScreen { }

    if Ui.screen == Screen.contacts: ContactsScreen { }

    if Ui.screen == Screen.settings: SettingsScreen { }

    if Ui.screen == Screen.account-picker: AccountPickerScreen { }

    if Ui.screen == Screen.coins: CoinsScreen { }

    if Ui.screen == Screen.activity: ActivityScreen { }

    if Ui.screen == Screen.funding-wallet: FundingWalletDetailScreen { }

    if Ui.screen == Screen.export-psbt: ExportPsbtScreen { }

    if Ui.screen == Screen.import-signed-psbt: ImportSignedPsbtScreen { }

    if Ui.screen == Screen.funding-wallets: FundingWalletsScreen { }

    if Ui.screen == Screen.sweep: SweepScreen { }

    // ---------- 20 · pay from (funding-unification: picker + coin control +
    // custom change, moved off compose wholesale — Sal 2026-07-16 iPhone
    // build-8 review). Reached only from compose's compact "Pay from" row;
    // back (nav-back, screen == Screen.pay-from) always returns to compose with the
    // draft untouched. Independent-expand rework (2026-07-18, Sal's iPhone
    // feedback): Notebook/Spending/each external wallet expand and collapse
    // on their own — a header tap ONLY shows/hides a section, it never
    // selects coins (that needs an actual coin tap, or the on-open
    // auto-selection); a pinned summary card up top shows required vs.
    // selected sats (reusing the exact figures the compose flow already
    // computes) so the totals stay visible while the wallet list scrolls
    // beneath it (no `alignment: start` + the Flickable gets
    // `vertical-stretch: 1`, same pattern as the universal confirm screen,
    // commit c3ec2d5). ----------
    if Ui.screen == Screen.pay-from: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Pay from";
            show-sync: true;
            net-busy: Ui.net-busy;
            back => { root.nav-back(); }
            sync => { PayFrom.funding-refresh(); }
            busy-tapped => { Ui.sync-busy-toast(); }
        }
        Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Ui.spend-enough ? Pal.line : Pal.warn;
            height: pf-summary.preferred-height;
            pf-summary := VerticalLayout {
                padding: 12px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Required"; font-size: 11px; color: Pal.muted; vertical-alignment: center; }
                    Text {
                        text: PayFrom.payfrom-required-line;
                        font-size: 13px;
                        font-weight: 600;
                        color: Ui.spend-enough ? Pal.text : Pal.warn;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Selected"; font-size: 11px; color: Pal.muted; vertical-alignment: center; }
                    Text {
                        text: Ui.payfrom-selected-line;
                        font-size: 13px;
                        font-weight: 600;
                        color: Ui.spend-enough ? Pal.good : Pal.warn;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
                // ONE insufficiency message for the whole screen (Sal's
                // iPhone bug cluster, 2026-07-18: this used to render inside
                // EVERY expanded wallet panel — now it lives here, under the
                // summary card that carries the global verdict; panel
                // captions/borders stay neutral always, see `CoinListPanel`).
                if !Ui.spend-enough: Caption {
                    text: "Selected coins don't cover the note + fee — select more.";
                    color: Pal.warn;
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            viewport-height: payfrom-scr-col.preferred-height;
            payfrom-scr-col := VerticalLayout {
                spacing: 10px;
                alignment: start;
                // ---- Notebook: expands/collapses independently of every
                // other section — a header tap ONLY toggles visibility. ----
                VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: PayFrom.nb-expanded ? Pal.accent : Pal.line;
                        background: PayFrom.nb-expanded ? Pal.accent.with-alpha(0.10) : Pal.card;
                        TouchArea { clicked => { PayFrom.payfrom-expand("notebook"); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text {
                                text: "Notebook";
                                font-size: 12px;
                                color: PayFrom.nb-expanded ? Pal.accent : Pal.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: PayFrom.funding-notebook-balance;
                                font-size: 11px;
                                color: Pal.muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Image {
                                source: PayFrom.nb-expanded
                                    ? @image-url("icons/caret-up.svg")
                                    : @image-url("icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 14px;
                                height: 14px;
                                y: (parent.height - 14px) / 2;
                            }
                        }
                    }
                    if PayFrom.nb-expanded: Rectangle {
                        border-radius: 10px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        height: nb20panel.preferred-height;
                        nb20panel := CoinListPanel {
                            coins: PayFrom.nb-panel-coins;
                            title: PayFrom.nb-panel-title;
                            strategy: PayFrom.coin-strategy;
                            pick-strategy(i) => { PayFrom.set-coin-strategy(i); }
                            toggle(op) => { PayFrom.toggle-coin("notebook", op); }
                            refresh() => { Ui.refresh-coins(); }
                            explorer(u) => { Ui.act-explorer(u); }
                        }
                    }
                }
                // ---- Spending wallet: independent of Notebook + wallets. ----
                if Ui.spending-capable && Ui.spending-enabled: VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: PayFrom.sp-expanded ? Pal.accent : Pal.line;
                        background: PayFrom.sp-expanded ? Pal.accent.with-alpha(0.10) : Pal.card;
                        TouchArea { clicked => { PayFrom.payfrom-expand("spending"); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text {
                                text: "Spending wallet";
                                font-size: 12px;
                                color: PayFrom.sp-expanded ? Pal.accent : Pal.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: PayFrom.spending-summary;
                                font-size: 11px;
                                color: Pal.muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Image {
                                source: PayFrom.sp-expanded
                                    ? @image-url("icons/caret-up.svg")
                                    : @image-url("icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 14px;
                                height: 14px;
                                y: (parent.height - 14px) / 2;
                            }
                        }
                    }
                    if PayFrom.sp-expanded: Rectangle {
                        border-radius: 10px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        height: sp20panel.preferred-height;
                        sp20panel := CoinListPanel {
                            coins: PayFrom.sp-panel-coins;
                            title: PayFrom.sp-panel-title;
                            strategy: PayFrom.coin-strategy;
                            pick-strategy(i) => { PayFrom.set-coin-strategy(i); }
                            toggle(op) => { PayFrom.toggle-coin("spending", op); }
                            refresh() => { Ui.refresh-coins(); }
                            explorer(u) => { Ui.act-explorer(u); }
                        }
                    }
                }
                // ---- External wallets: an accordion among THEMSELVES only
                // (this app keeps one external wallet's coins scanned/cached
                // live at a time) — independent of Notebook/Spending. ----
                for fw in Ui.funding-wallets: VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: fw20-row.preferred-height;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: fw.expanded ? Pal.accent : Pal.line;
                        background: fw.expanded ? Pal.accent.with-alpha(0.10) : Pal.card;
                        TouchArea { clicked => { PayFrom.payfrom-expand("wallet:" + fw.id); } }
                        fw20-row := VerticalLayout {
                            padding: 8px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            Text {
                                text: fw.label;
                                font-size: 12px;
                                color: fw.expanded ? Pal.accent : Pal.text;
                                overflow: elide;
                            }
                            Caption { text: "watch-only"; }
                        }
                    }
                    if fw.expanded: Rectangle {
                        border-radius: 10px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        height: fwpanel.preferred-height;
                        fwpanel := CoinListPanel {
                            coins: fw.coins;
                            title: fw.coin-title;
                            strategy: PayFrom.coin-strategy;
                            pick-strategy(i) => { PayFrom.set-coin-strategy(i); }
                            toggle(op) => { PayFrom.toggle-coin("wallet:" + fw.id, op); }
                            refresh() => { Ui.refresh-coins(); }
                            explorer(u) => { Ui.act-explorer(u); }
                        }
                    }
                }
                GhostButton {
                    text: "+ External wallet…";
                    clicked => { Ui.funding-return = Screen.pay-from; Ui.open-funding(); }
                }
                if Ui.mixed-linkage-hint: Caption {
                    text: "This note spends coins from more than one wallet — their addresses become publicly linked on-chain.";
                    color: Pal.warn;
                }
                if Ui.status != "": Caption { text: Ui.status; color: Pal.bad; }
            }
        }
    }

    // ---------- 21 · change destination (funding-unification UI rework) ----------
    // Moved off the Pay-from screen onto its own screen, reached from a
    // second compose nav row. Single-select rows; "Custom address…" reveals
    // the existing validated text input. Defaults (never overridden once an
    // explicit pick is made this session) come from app-core's
    // `mixed::resolve_change_default`.
    if Ui.screen == Screen.change: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Change";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-height: change-scr-col.preferred-height;
            // Dismiss layer (see the global one under back-scope) — the
            // custom change-address field lives in here.
            TouchArea {
                width: parent.width;
                height: change-scr-col.preferred-height;
                clicked => { back-scope.focus(); }
            }
            change-scr-col := VerticalLayout {
                spacing: 10px;
                alignment: start;
                if Ui.spending-capable && Ui.spending-enabled: Rectangle {
                    height: chg-sp-row.preferred-height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Ui.change-choice == "spending" ? Pal.accent : Pal.line;
                    background: Ui.change-choice == "spending" ? Pal.accent.with-alpha(0.10) : Pal.card;
                    TouchArea { clicked => { Change.change-pick("spending"); } }
                    chg-sp-row := VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "Spending wallet · fresh change";
                                font-size: 12px;
                                font-weight: 600;
                                color: Ui.change-choice == "spending" ? Pal.accent : Pal.text;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if Change.change-default-choice == "spending": Badge { label: "default"; tint: Pal.accent; }
                        }
                        if Change.change-spending-line != "": Caption { text: Change.change-spending-line; }
                        if Change.change-default-choice == "spending": Caption { text: Change.change-default-reason; }
                        Caption { text: "Never used before — keeps your funds unlinked."; }
                    }
                }
                Rectangle {
                    height: chg-nb-row.preferred-height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Ui.change-choice == "notebook" ? Pal.accent : Pal.line;
                    background: Ui.change-choice == "notebook" ? Pal.accent.with-alpha(0.10) : Pal.card;
                    TouchArea { clicked => { Change.change-pick("notebook"); } }
                    chg-nb-row := VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "Notebook";
                                font-size: 12px;
                                font-weight: 600;
                                color: Ui.change-choice == "notebook" ? Pal.accent : Pal.text;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if Change.change-default-choice == "notebook": Badge { label: "default"; tint: Pal.accent; }
                        }
                        if Change.change-notebook-line != "": Caption { text: Change.change-notebook-line; }
                        if Change.change-default-choice == "notebook": Caption { text: Change.change-default-reason; }
                        Caption { text: "Reuses your public notebook address."; }
                    }
                }
                for fw in Ui.funding-wallets: Rectangle {
                    height: chg-fw-row.preferred-height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Ui.change-choice == "wallet:" + fw.id ? Pal.accent : Pal.line;
                    background: Ui.change-choice == "wallet:" + fw.id ? Pal.accent.with-alpha(0.10) : Pal.card;
                    TouchArea { clicked => { Change.change-pick("wallet:" + fw.id); } }
                    chg-fw-row := VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: fw.label + " change";
                                font-size: 12px;
                                font-weight: 600;
                                color: Ui.change-choice == "wallet:" + fw.id ? Pal.accent : Pal.text;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if Change.change-default-choice == "wallet:" + fw.id: Badge { label: "default"; tint: Pal.accent; }
                        }
                        if fw.change-addr != "": Caption { text: fw.change-addr; }
                        if Change.change-default-choice == "wallet:" + fw.id: Caption { text: Change.change-default-reason; }
                        Caption { text: fw.label + "'s change chain."; }
                    }
                }
                Rectangle {
                    height: chg-custom-row.preferred-height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Ui.change-choice == "custom" ? Pal.accent : Pal.line;
                    background: Ui.change-choice == "custom" ? Pal.accent.with-alpha(0.10) : Pal.card;
                    TouchArea { clicked => { Change.change-pick("custom"); } }
                    chg-custom-row := VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        Text {
                            text: "Custom address…";
                            font-size: 12px;
                            font-weight: 600;
                            color: Ui.change-choice == "custom" ? Pal.accent : Pal.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
                if Ui.change-choice == "custom": HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        text <=> Ui.change-address;
                        placeholder-text: "change address";
                        edited => { Ui.compose-changed(); }
                    }
                    ScanButton { clicked => { Change.change-scan(); } }
                }
                if Ui.change-choice == "custom": Caption {
                    text: "Leaves this wallet — the coin won't be tracked here.";
                    color: Pal.warn;
                }
                if Change.change-error != "": Caption { text: Change.change-error; color: Pal.bad; }
                Caption { text: "Current: " + Ui.change-dest-label; }
            }
        }
    }

    // ---------- 18 · public keys (watch-only-safe, no re-auth) ----------
    if Ui.screen == Screen.public-keys: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Public keys";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-width: self.width;
            viewport-height: pub-col.preferred-height;
            pub-col := VerticalLayout {
                width: parent.width;
                spacing: 14px;
                alignment: start;
                Caption {
                    text: "Watch-only — these can't spend your funds or read a private note. But an xpub or descriptor reveals every address in this notebook, so anyone you share it with can see its full balance and transaction history and track your activity. Share only with people you trust.";
                    color: Pal.warn;
                }
                if Ui.reveal-fingerprint != "": Mono {
                    text: Ui.reveal-fingerprint;
                    color: Pal.muted;
                }
                if Ui.reveal-public-hint != "": Caption { text: Ui.reveal-public-hint; color: Pal.warn; }
                // Collapsed by default — tap a row header to expand its value +
                // QR; both can be open at once.
                for row[idx] in PublicKeys.reveal-public-rows: VerticalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 46px;
                        border-radius: 10px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Text {
                                text: row.label;
                                color: Pal.text;
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Image {
                                source: row.expanded ? @image-url("icons/caret-up.svg") : @image-url("icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 16px;
                                height: 16px;
                            }
                        }
                        TouchArea {
                            clicked => {
                                PublicKeys.reveal-public-rows[idx].expanded = !PublicKeys.reveal-public-rows[idx].expanded;
                            }
                        }
                    }
                    if row.expanded: VerticalLayout {
                        spacing: 6px;
                        Rectangle {
                            border-radius: 10px;
                            background: Pal.card;
                            border-width: 1px;
                            border-color: Pal.line;
                            height: pkv.preferred-height + 24px;
                            pkv := Mono {
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                                text: row.value;
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 176px;
                                height: 176px;
                                QrArea {
                                    img: row.qr;
                                    qr-size: 176px;
                                }
                                TouchArea {
                                    clicked => {
                                        Ui.qr-zoom-image = row.qr;
                                        Ui.qr-zoom-open = true;
                                    }
                                }
                            }
                        }
                        GhostButton { text: "Copy"; clicked => { Ui.copy-value(row.value); } }
                    }
                }
            }
        }
    }

    // ---------- 19 · private keys (fresh Touch ID before entry) ----------
    if Ui.screen == Screen.private-keys: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Private keys";
            back => { root.nav-back(); }
        }
        Rectangle {
            border-radius: 10px;
            background: Pal.bad.with-alpha(0.12);
            height: priv-warn.preferred-height + 20px;
            priv-warn := Caption {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                color: Pal.bad;
                text: "Make sure no cameras or onlookers — anyone who captures a private key below controls the funds and can read every private note.";
            }
        }
        if Ui.reveal-fingerprint != "": Mono {
            text: Ui.reveal-fingerprint;
            color: Pal.muted;
        }
        Flickable {
            viewport-width: self.width;
            viewport-height: priv-col.preferred-height;
            priv-col := VerticalLayout {
                width: parent.width;
                spacing: 14px;
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    if PrivateKeys.reveal-has-recovery: SelectPill {
                        text: "BIP-39";
                        active: Ui.reveal-private-format == "recovery";
                        clicked => { PrivateKeys.private-select("recovery"); }
                    }
                    if PrivateKeys.reveal-has-xprv: SelectPill {
                        text: "xprv";
                        active: Ui.reveal-private-format == "xprv";
                        clicked => { PrivateKeys.private-select("xprv"); }
                    }
                    if PrivateKeys.reveal-has-hex: SelectPill {
                        text: "hex";
                        active: Ui.reveal-private-format == "hex";
                        clicked => { PrivateKeys.private-select("hex"); }
                    }
                    if PrivateKeys.reveal-has-wif: SelectPill {
                        text: "WIF";
                        active: Ui.reveal-private-format == "wif";
                        clicked => { PrivateKeys.private-select("wif"); }
                    }
                }
                if Ui.reveal-private-format == "": Caption {
                    text: "Tap a format to reveal it. Only one is ever shown at a time.";
                    color: Pal.muted;
                }

                // ---- Notebook picker: hex/WIF only (seed/account-level
                // formats don't vary per notebook) ----
                if Ui.reveal-private-format == "hex" || Ui.reveal-private-format == "wif": VerticalLayout {
                    spacing: 6px;
                    Caption { text: "Notebook:"; color: Pal.muted; }
                    for nb in PrivateKeys.reveal-nb-rows: Rectangle {
                        height: 44px;
                        nbp-ta := TouchArea { clicked => { PrivateKeys.private-pick-notebook(nb.index); } }
                        Rectangle {
                            border-radius: 10px;
                            background: nb.index == PrivateKeys.reveal-nb-index
                                ? Pal.accent.with-alpha(0.18)
                                : (nbp-ta.has-hover ? Pal.card-hover : Pal.card);
                            border-width: 1px;
                            border-color: nb.index == PrivateKeys.reveal-nb-index ? Pal.accent.with-alpha(0.55) : Pal.line;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text {
                                    text: nb.name;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Pal.text;
                                    overflow: elide;
                                    horizontal-stretch: 2;
                                    vertical-alignment: center;
                                }
                                Mono {
                                    text: nb.addr;
                                    color: Pal.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    wrap: no-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }

                // ---- Recovery phrase: word grid + SeedQR toggle ----
                if Ui.reveal-private-format == "recovery": VerticalLayout {
                    spacing: 10px;
                    if !PrivateKeys.reveal-show-seedqr: HorizontalLayout {
                        spacing: 16px;
                        Mono { text: PrivateKeys.reveal-words-col1; horizontal-stretch: 1; }
                        Mono { text: PrivateKeys.reveal-words-col2; horizontal-stretch: 1; }
                    }
                    if PrivateKeys.reveal-show-seedqr: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 200px;
                            height: 200px;
                            QrArea {
                                img: PrivateKeys.reveal-seedqr-image;
                                qr-size: 200px;
                            }
                            TouchArea {
                                clicked => {
                                    Ui.qr-zoom-image = PrivateKeys.reveal-seedqr-image;
                                    Ui.qr-zoom-open = true;
                                }
                            }
                        }
                    }
                    GhostButton {
                        text: PrivateKeys.reveal-show-seedqr ? "Show words" : "Show as SeedQR";
                        clicked => { PrivateKeys.reveal-show-seedqr = !PrivateKeys.reveal-show-seedqr; }
                    }
                }

                // ---- xprv / hex / WIF: a single red-tinted value box ----
                if Ui.reveal-private-format == "xprv" || Ui.reveal-private-format == "hex" || Ui.reveal-private-format == "wif": VerticalLayout {
                    spacing: 10px;
                    Rectangle {
                        border-radius: 10px;
                        background: Pal.warn.with-alpha(0.10);
                        border-width: 1px;
                        border-color: Pal.warn.with-alpha(0.4);
                        height: pvv.preferred-height + 24px;
                        pvv := Mono {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            text: PrivateKeys.reveal-private-value;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 176px;
                            height: 176px;
                            QrArea {
                                img: PrivateKeys.reveal-private-qr;
                                qr-size: 176px;
                            }
                            TouchArea {
                                clicked => {
                                    Ui.qr-zoom-image = PrivateKeys.reveal-private-qr;
                                    Ui.qr-zoom-open = true;
                                }
                            }
                        }
                    }
                }

                if Ui.reveal-private-format != "": GhostButton {
                    text: "Copy";
                    clicked => { PrivateKeys.copy-secret(PrivateKeys.reveal-private-value); }
                }
            }
        }
    }

    // ---------- 29 · quantum keys (Settings -> ML-KEM receive key + import) ----------
    if Ui.screen == Screen.quantum-keys: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Quantum keys";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-width: self.width;
            viewport-height: pq-keys-col.preferred-height;
            // Dismiss layer (see the global one under back-scope): this
            // Flickable holds text fields (paste box), so it needs its own
            // copy — same pattern screens 6/8/16/21 already use.
            TouchArea {
                width: parent.width;
                height: pq-keys-col.preferred-height;
                clicked => { back-scope.focus(); }
            }
            pq-keys-col := VerticalLayout {
                width: parent.width;
                spacing: 14px;
                alignment: start;
                Caption {
                    text: "A post-quantum receive key for this notebook, layered on top of your normal note encryption. Share the public half so others can seal directed notes to you with quantum-resistant protection — it recovers automatically from your seed phrase.";
                }
                Text { text: "Parameter level"; font-size: 13px; font-weight: 700; color: Pal.text; }
                VerticalLayout {
                    spacing: 8px;
                    DoorCard {
                        title: "ML-KEM-512";
                        subtitle: QuantumKeys.pq-desc-512;
                        highlight: QuantumKeys.pq-key-level == "512";
                        clicked => { QuantumKeys.pq-set-level("512"); }
                    }
                    DoorCard {
                        title: "ML-KEM-768";
                        subtitle: QuantumKeys.pq-desc-768;
                        highlight: QuantumKeys.pq-key-level == "768";
                        clicked => { QuantumKeys.pq-set-level("768"); }
                    }
                    DoorCard {
                        title: "ML-KEM-1024";
                        subtitle: QuantumKeys.pq-desc-1024;
                        highlight: QuantumKeys.pq-key-level == "1024";
                        clicked => { QuantumKeys.pq-set-level("1024"); }
                    }
                }
                Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: pq-key-col.preferred-height;
                    pq-key-col := VerticalLayout {
                        padding: 12px;
                        spacing: 6px;
                        Text { text: "Your notebook's quantum key"; font-size: 13px; font-weight: 700; color: Pal.text; }
                        Mono { text: QuantumKeys.pq-key-fingerprint; color: Pal.muted; }
                        Caption { text: "Derived from your seed — recovers with your seed phrase; backup is optional."; }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Share your public key"; font-size: 13px; font-weight: 700; color: Pal.text; }
                    HorizontalLayout {
                        spacing: 10px;
                        GhostButton { text: "Copy public key"; clicked => { QuantumKeys.pq-copy-public(); } }
                        if Ui.desktop-platform: GhostButton { text: "Save public key…"; clicked => { QuantumKeys.pq-save-public(); } }
                    }
                }
                VerticalLayout {
                    spacing: 8px;
                    Text { text: "Backup"; font-size: 13px; font-weight: 700; color: Pal.text; }
                    Caption { text: "Optional — this key already recovers from your seed phrase. Only do this if you want a separate copy outside the app."; }
                    GhostButton { text: "Backup private key…"; clicked => { Ui.pq-show-backup-confirm = true; } }
                }
                Rectangle { height: 1px; background: Pal.line; }
                Text { text: "My quantum key"; font-size: 13px; font-weight: 700; color: Pal.text; }
                Caption { text: "A personal ML-KEM key that does NOT come from your seed phrase — generate one here, or import one (a Graffito private-key export, or an OpenPGP key with an RFC 9980 ML-KEM-768+X25519 component). Self-notes sealed with quantum protection use THIS key, never the seed-derived one above."; }

                // ---- Current key: fingerprint + share/export/remove ----
                if Ui.pq-import-fp != "": VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        border-radius: 10px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        height: myk-col.preferred-height;
                        myk-col := VerticalLayout {
                            padding: 12px;
                            spacing: 4px;
                            Caption { text: Ui.pq-import-fp; color: Pal.good; }
                            if Ui.pq-import-source != "": Caption { text: Ui.pq-import-source; color: Pal.muted; wrap: word-wrap; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        GhostButton { text: "Share public key"; clicked => { QuantumKeys.pq-imported-copy-public(); } }
                        GhostButton {
                            text: "Export private key…";
                            clicked => { Ui.pq-show-export-private-confirm = true; }
                        }
                    }
                    if QuantumKeys.pq-imported-public-qr.width > 0: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 160px;
                            height: 160px;
                            QrArea {
                                img: QuantumKeys.pq-imported-public-qr;
                                qr-size: 160px;
                            }
                            TouchArea {
                                clicked => {
                                    Ui.qr-zoom-image = QuantumKeys.pq-imported-public-qr;
                                    Ui.qr-zoom-open = true;
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Pal.line; }
                    Caption { text: "Removing this key permanently loses access to any notes sealed to it, unless you exported it first."; color: Pal.warn; wrap: word-wrap; }
                    GhostButton { text: "Remove my quantum key"; clicked => { QuantumKeys.pq-import-remove(); } }
                    Rectangle { height: 1px; background: Pal.line; }
                }

                // ---- Generate a fresh key ----
                Text { text: "Generate a new key"; font-size: 13px; font-weight: 700; color: Pal.text; }
                HorizontalLayout {
                    spacing: 8px;
                    SelectPill { text: "ML-KEM-512"; active: QuantumKeys.pq-gen-level == "512"; clicked => { QuantumKeys.pq-gen-level = "512"; } }
                    SelectPill { text: "ML-KEM-768"; active: QuantumKeys.pq-gen-level == "768"; clicked => { QuantumKeys.pq-gen-level = "768"; } }
                    SelectPill { text: "ML-KEM-1024"; active: QuantumKeys.pq-gen-level == "1024"; clicked => { QuantumKeys.pq-gen-level = "1024"; } }
                }
                Caption { text: "768 is the standard recommendation for general use."; }
                Text { text: "Extra entropy (optional)"; font-size: 12px; font-weight: 600; color: Pal.text; }
                Caption { text: "Type anything — a passphrase, dice rolls. Mixed WITH the system's randomness, it can only add strength, never replace it."; }
                EditField {
                    placeholder-text: "e.g. a passphrase or dice rolls";
                    text <=> QuantumKeys.pq-gen-extra;
                }
                GhostButton { text: "Generate"; clicked => { QuantumKeys.pq-generate(); } }

                Rectangle { height: 1px; background: Pal.line; }

                // ---- Import an existing key ----
                Text { text: "Import a key"; font-size: 13px; font-weight: 700; color: Pal.text; }
                Caption { text: "Import someone else's — or your own already-exported — ML-KEM SECRET key so this device can use it: a Graffito private-key export, or an OpenPGP key with an RFC 9980 ML-KEM-768+X25519 component."; }
                EditArea {
                    height: 90px;
                    text <=> QuantumKeys.pq-import-text;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Paste"; clicked => { QuantumKeys.pq-import-paste(); } }
                    if Ui.desktop-platform: GhostButton { text: "From file…"; clicked => { QuantumKeys.pq-import-file(); } }
                    GhostButton { text: "Import"; clicked => { QuantumKeys.pq-import-submit(); } }
                }
                if QuantumKeys.pq-import-error != "": Caption { text: QuantumKeys.pq-import-error; color: Pal.bad; wrap: word-wrap; }
            }
        }
        Caption { text: Ui.status; color: Pal.bad; }
    }

    // ---------- 24 · terms & disclaimer (first-run accept gate + re-view) ----------
    if Ui.screen == Screen.terms: VerticalLayout { padding-top: Ui.safe-top + 20px; padding-bottom: Ui.safe-bottom + 10px;
        padding: 24px;
        spacing: 16px;
        // View mode (opened from Settings) gets a normal header + back chevron.
        // Accept mode has NO back chevron — it must be accepted to proceed.
        if !Ui.terms-accept-mode: Header {
            title: "Terms & disclaimer";
            back => { root.nav-back(); }
        }
        Rectangle { }  // stretch — vertically centers the block on tall screens
        if Ui.terms-accept-mode: HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/bitcoin.svg");
                colorize: Pal.accent;
                width: 42px;
                height: 42px;
            }
        }
        if Ui.terms-accept-mode: H1 {
            text: "Before you begin";
            horizontal-alignment: center;
        }
        Body {
            text: Terms.disclaimer-body;
            font-size: 17px;
        }
        Rectangle { }  // stretch
        if Ui.terms-accept-mode: PrimaryButton {
            text: "I understand and accept";
            clicked => { Terms.accept-terms(); }
        }
    }

    // ---------- 25 · info (About / Privacy / Help / Q&A) ----------
    if Ui.screen == Screen.info: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: Info.info-title;
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-width: self.width;
            viewport-height: info-body-t.preferred-height;
            info-body-t := Body {
                width: parent.width;
                text: Info.info-body;
                font-size: 17px;
            }
        }
        if Info.info-show-slint: AboutSlint {
            height: 110px;
        }
    }

    // ---------- 27 · where does the entropy come from? ----------
    // Two doors, same pattern as onboarding. Reached from every "Create a new
    // N-word seed" door — creation no longer generates immediately, because
    // "the device rolled it for you, trust us" is exactly the thing a bitcoin
    // user may not want to trust.
    if Ui.screen == Screen.entropy-source: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "New " + Ui.new-word-count + "-word seed";
            back => { root.nav-back(); }
        }
        Caption {
            text: "Your seed is just a very large random number. Choose where that randomness comes from.";
        }
        Rectangle { height: 6px; }
        DoorCard {
            highlight: true;
            title: "This device";
            subtitle: "Uses the device's secure random number generator.";
            clicked => { EntropySource.pick-entropy-source("device"); }
        }
        DoorCard {
            title: "Dice rolls";
            subtitle: "You roll a real die and enter each result. The seed is built from your rolls alone — nothing from this device is mixed in — so you can reproduce it yourself with any SHA-256 tool and check it matches.";
            clicked => { EntropySource.pick-entropy-source("dice"); }
        }
        Rectangle { height: 4px; }
        Caption {
            color: Pal.muted;
            text: "Dice take a few minutes, and they are more responsibility: the seed rests entirely on your rolls rather than on this device's randomness, so a fair die and honest rolls are what keep it strong.";
        }
    }

    // ---------- 28 · dice entry ----------
    // The roll counter and the LIVE hash are the point of this screen: the
    // same two things a hardware signer shows while you roll, for the same
    // reason — at any moment you can check the number on screen against
    // `echo -n <rolls> | shasum -a 256` and see the device isn't inventing
    // anything.
    if Ui.screen == Screen.dice: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 10px;
        alignment: start;
        Header {
            title: "Roll the dice";
            back => { root.nav-back(); }
        }
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Text {
                text: Ui.dice-count;
                font-size: 40px;
                font-weight: 700;
                color: Dice.dice-ready ? Pal.accent : Pal.text;
                vertical-alignment: center;
            }
            Text {
                text: Ui.dice-count == 1 ? "roll" : "rolls";
                font-size: 15px;
                color: Pal.muted;
                vertical-alignment: center;
            }
        }
        Caption {
            horizontal-alignment: center;
            color: Dice.dice-ready ? Pal.muted : Pal.warn;
            text: Dice.dice-ready
                ? "Enough for " + Ui.new-word-count + " words. Keep going if you like — more rolls never hurt."
                : (Dice.dice-needed - Ui.dice-count) + " more needed for " + Ui.new-word-count + " words";
        }
        if Dice.dice-warning != "": Caption {
            horizontal-alignment: center;
            color: Pal.warn;
            text: Dice.dice-warning;
        }
        // Live entropy. Two lines of 32 hex chars, exactly how a hardware
        // signer renders it, so a side-by-side comparison is easy.
        Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: hl.preferred-height;
            hl := VerticalLayout {
                padding: 12px;
                spacing: 2px;
                Text {
                    text: "SHA-256 of your rolls so far";
                    font-size: 11px;
                    color: Pal.muted;
                }
                Text { text: Ui.dice-hash; font-size: 12px; color: Pal.text; }
                Text { text: Dice.dice-hash2; font-size: 12px; color: Pal.text; }
            }
        }
        // Keypad of actual die faces (icons/die-N.svg). These are the ONE
        // place we deliberately don't `colorize`: a die reads as a die
        // because the face is light and the pips are dark, and tinting it
        // flat would just give six indistinguishable blobs. Row height is
        // unchanged from the digits version so the calibrated e2e taps in
        // ui-automation still land.
        for row in [[1, 2, 3], [4, 5, 6]]: HorizontalLayout {
            spacing: 8px;
            for n in row: Rectangle {
                height: 54px;
                border-radius: 10px;
                border-width: 1px;
                border-color: Pal.line;
                background: dta.pressed ? Pal.accent.with-alpha(0.25)
                          : (dta.has-hover ? Pal.card-hover : Pal.card);
                dta := TouchArea { clicked => { Ui.dice-roll(n); } }
                Image {
                    width: 34px;
                    height: 34px;
                    image-fit: contain;
                    source: n == 1 ? @image-url("icons/die-1.svg")
                          : n == 2 ? @image-url("icons/die-2.svg")
                          : n == 3 ? @image-url("icons/die-3.svg")
                          : n == 4 ? @image-url("icons/die-4.svg")
                          : n == 5 ? @image-url("icons/die-5.svg")
                          :          @image-url("icons/die-6.svg");
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            GhostButton {
                text: "Undo";
                clicked => { Dice.dice-undo(); }
            }
            GhostButton {
                text: "Start over";
                clicked => {
                    if (Ui.dice-count > 5) { Ui.show-dice-clear-confirm = true; }
                    else { Ui.dice-clear(); }
                }
            }
        }
        // Gated the same way compose gates Sign: faint tint + an inert
        // handler, rather than a disabled property PrimaryButton doesn't have.
        PrimaryButton {
            text: "Create seed from these rolls";
            tint: Dice.dice-ready ? Pal.accent : Pal.faint;
            tint-hover: Dice.dice-ready ? Pal.accent-hover : Pal.faint;
            clicked => { if (Dice.dice-ready) { Dice.dice-continue(); } }
        }
        Caption {
            color: Pal.muted;
            text: "Check it yourself: put the same digits through any SHA-256 tool — the result is the number above, and that number is your seed.";
        }
    }

    // ---------- 26 · Confirm & broadcast (universal) ----------
    // Every broadcast path (compose/spending/mixed/signed-PSBT) lands here
    // before anything hits the wire — full decoded tx, Broadcast is the
    // only way out besides Cancel. Funding-unification follow-up,
    // 2026-07-17.
    if Ui.screen == Screen.confirm: VerticalLayout { padding-top: Ui.safe-top + 14px; padding-bottom: Ui.safe-bottom;
        padding: 20px;
        spacing: 12px;
        // No `alignment: start` here: the detail view stretches to fill so
        // the Broadcast button stays PINNED at the bottom — a long tx
        // (mixed sweep, many inputs) scrolls inside TxConfirmView instead
        // of pushing Broadcast off-screen (and the e2e tap point is one
        // constant, not per-tx-shape).
        Header {
            title: "Confirm & broadcast";
            back => { Ui.confirm-cancel(); }
        }
        if Confirm.confirm-context != "": Caption { text: Confirm.confirm-context; }
        TxConfirmView {
            vertical-stretch: 1;
            note: Confirm.confirm-note;
            inputs: Confirm.confirm-inputs;
            outputs: Confirm.confirm-outputs;
            fee-line: Confirm.confirm-fee-line;
            lock-time-line: Confirm.confirm-locktime-line;
            warn: Ui.confirm-warn;
            txid: Confirm.confirm-txid;
        }
        Rectangle {
            height: 46px;
            PrimaryButton {
                width: 100%;
                height: 100%;
                text: Confirm.wallet-tx-busy ? "Broadcasting…" : "Broadcast";
                tint: Confirm.wallet-tx-busy ? Pal.faint : Pal.accent;
                clicked => { if (!Confirm.wallet-tx-busy) { Confirm.confirm-broadcast(); } }
            }
            // A label swap alone was too subtle on a slow/dying connection
            // (Sal 2026-07-18: the button "did nothing" for several seconds
            // on weak cellular before the error landed) — pair it with the
            // same rotating spinner.svg QrSpinner already used elsewhere for
            // in-flight work, plus the reassurance caption below.
            if Confirm.wallet-tx-busy: QrSpinner {
                width: 22px;
                height: 22px;
                x: parent.width - self.width - 14px;
                y: (parent.height - self.height) / 2;
            }
        }
        if Confirm.wallet-tx-busy: Caption {
            text: "Sending to your node — a weak connection can take up to 30 seconds.";
        }
        if Ui.status != "": Caption { text: Ui.status; color: Pal.bad; }
    }

    // ---------- shared camera-scan overlay (live preview) ----------
    if Ui.scanning: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.86);
        z: 200;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            padding: 24px;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: Modals.scan-hint;
                    color: Pal.text;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-width: 340px;
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 300px;
                    border-radius: 16px;
                    clip: true;
                    background: #0a0a0a;
                    border-width: 2px;
                    border-color: Pal.accent;
                    Image {
                        source: Modals.camera-frame;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 6px;
                    border-radius: 3px;
                    background: Pal.line;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: 100%;
                        width: parent.width * clamp(Modals.scan-progress, 0, 1);
                        background: Pal.accent;
                        border-radius: 3px;
                        animate width { duration: 150ms; }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Caption {
                    text: Modals.scan-progress > 0.001
                        ? "Collecting frames · \{round(Modals.scan-progress * 100)}%"
                        : "Hold your phone steady and fill the frame.";
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                alignment: center;
                GhostButton {
                    text: "Cancel";
                    min-width: 220px;
                    clicked => { Ui.cancel-scan(); }
                }
            }
        }
    }

    // ---------- funding-wallet rename (modal overlay) ----------
    if Ui.fund-rename-id != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.fund-rename-cancel(); } }
        Rectangle {
            width: 400px;
            height: frl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            // Swallow clicks on the card body so they don't reach the dim
            // (which cancels) — and drop the keyboard while we're here.
            TouchArea { clicked => { back-scope.focus(); } }
            frl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this wallet";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                EditField {
                    text <=> Modals.fund-rename-input;
                    placeholder-text: "wallet name";
                    accepted(t) => { Modals.fund-rename-save(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.fund-rename-cancel(); } }
                    PrimaryButton { text: "Save"; clicked => { Modals.fund-rename-save(Modals.fund-rename-input); } }
                }
            }
        }
    }

    // ---------- rename dialog (modal overlay) ----------
    if Ui.rename-address != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.cancel-rename(); } }
        Rectangle {
            width: 400px;
            height: dl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            // Swallow clicks on the card body; also drops the keyboard.
            TouchArea { clicked => { back-scope.focus(); } }
            dl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this contact";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Mono {
                    text: Ui.rename-address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
                rename-edit := EditField {
                    text <=> Modals.rename-input;
                    placeholder-text: "name (empty clears it)";
                    accepted(t) => { Modals.save-rename(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                if Ui.apple-platform: Rectangle {
                    height: 30px;
                    cbta := TouchArea { clicked => { Modals.rename-synced = !Modals.rename-synced; } }
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        Rectangle {
                            width: 20px; height: 20px;
                            y: (parent.height - 20px) / 2;
                            border-radius: 4px;
                            border-width: 2px;
                            border-color: Modals.rename-synced ? Pal.accent : Pal.muted;
                            background: Modals.rename-synced ? Pal.accent : transparent;
                            if Modals.rename-synced: Image {
                                source: @image-url("icons/check.svg");
                                colorize: Pal.on-accent;
                                width: 14px; height: 14px;
                                x: (parent.width - 14px) / 2;
                                y: (parent.height - 14px) / 2;
                            }
                        }
                        Text {
                            text: "Save to iCloud";
                            font-size: 13px;
                            color: Pal.text;
                            vertical-alignment: center;
                        }
                    }
                }
                Rectangle { height: 1px; background: Pal.line; }
                Text { text: "Quantum key"; font-size: 13px; font-weight: 700; color: Pal.text; }
                if Ui.rename-pq-display != "": HorizontalLayout {
                    spacing: 8px;
                    Caption { text: Ui.rename-pq-display; horizontal-stretch: 1; wrap: word-wrap; }
                    IconButton {
                        glyph: "×";
                        glyph-size: 18px;
                        width: 28px;
                        height: 28px;
                        glyph-color: Pal.bad;
                        clicked => { Ui.contact-pq-remove(); }
                    }
                }
                if Ui.rename-pq-display == "": HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        horizontal-stretch: 1;
                        text <=> Modals.rename-pq-input;
                        placeholder-text: "paste their quantum public key";
                        accepted(t) => { Ui.contact-pq-set(t); }
                    }
                    GhostButton { text: "Set"; width: 64px; clicked => { Ui.contact-pq-set(Modals.rename-pq-input); } }
                }
                if Ui.desktop-platform && Ui.rename-pq-display == "": GhostButton {
                    text: "From file…";
                    clicked => { Modals.contact-pq-file(); }
                }
                if Modals.rename-pq-error != "": Caption { text: Modals.rename-pq-error; color: Pal.bad; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.cancel-rename(); } }
                    PrimaryButton { text: "Save"; clicked => { Modals.save-rename(Modals.rename-input); } }
                }
            }
        }
    }

    // ---------- notebook rename dialog (modal overlay) ----------
    if Ui.nb-rename-index >= 0: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.nb-rename-cancel(); } }
        Rectangle {
            width: 400px;
            height: nbl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            // Swallow clicks on the card body; also drops the keyboard.
            TouchArea { clicked => { back-scope.focus(); } }
            nbl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this notebook";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Caption { text: "The name stays on this device — it is never published."; }
                nb-rename-edit := EditField {
                    text <=> Modals.nb-rename-input;
                    placeholder-text: "name (empty = address short form)";
                    accepted(t) => { Modals.nb-rename-save(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.nb-rename-cancel(); } }
                    PrimaryButton { text: "Save"; clicked => { Modals.nb-rename-save(Modals.nb-rename-input); } }
                }
            }
        }
    }

    // ---------- remove-contact confirmation (modal overlay) ----------
    if Ui.confirm-remove-address != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.cancel-remove(); } }
        Rectangle {
            width: 400px;
            height: cl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            cl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Remove this contact?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                if Modals.confirm-remove-name != "": Body { text: Modals.confirm-remove-name; }
                Mono {
                    text: Ui.confirm-remove-address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Caption { text: "Only removes it from recents — sending to this address again re-adds it."; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.cancel-remove(); } }
                    PrimaryButton {
                        text: "Remove";
                        tint: Pal.bad;
                        tint-hover: #ff6b62;
                        clicked => { Modals.remove-contact(Ui.confirm-remove-address); }
                    }
                }
            }
        }
    }

    // ---------- reset-identity confirmation (modal overlay) ----------
    // Clearing dice rolls is unrecoverable and can throw away several minutes
    // of physical rolling, so it confirms — same rule as every other
    // destructive action here. Only armed above a handful of rolls; nagging
    // about discarding three of them would just be noise.
    if Ui.show-dice-clear-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.show-dice-clear-confirm = false; } }
        Rectangle {
            width: 400px;
            height: dcl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { clicked => { back-scope.focus(); } }
            dcl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Discard " + Ui.dice-count + " rolls?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body {
                    text: "You'll start again from zero and have to re-roll them.";
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton {
                        text: "Keep rolling";
                        clicked => { Ui.show-dice-clear-confirm = false; }
                    }
                    PrimaryButton {
                        text: "Discard";
                        tint: Pal.bad;
                        clicked => {
                            Ui.show-dice-clear-confirm = false;
                            Ui.dice-clear();
                        }
                    }
                }
            }
        }
    }

    // ---------- backup quantum private key confirmation (modal overlay) ----------
    if Ui.pq-show-backup-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.pq-show-backup-confirm = false; } }
        Rectangle {
            width: 400px;
            height: pqbl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { clicked => { back-scope.focus(); } }
            pqbl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Back up your quantum private key?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Caption {
                    text: "Anyone who gets this key can read notes sealed to it. It already recovers from your seed phrase — only do this if you want a separate copy.";
                    color: Pal.warn;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.pq-show-backup-confirm = false; } }
                    GhostButton { text: "Copy"; clicked => { Modals.pq-copy-private(); } }
                    if Ui.desktop-platform: GhostButton { text: "Save…"; clicked => { Modals.pq-save-private(); } }
                }
            }
        }
    }

    // ---- Replace guard: Generate/Import over an existing "My quantum
    // key" (screen 29) ----
    if Ui.pq-show-replace-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Modals.pq-replace-cancel(); } }
        Rectangle {
            width: 400px;
            height: pqrepl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { clicked => { back-scope.focus(); } }
            pqrepl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Replace your quantum key?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Caption {
                    text: "Notes sealed to your CURRENT key become permanently unreadable unless you exported it first. This cannot be undone.";
                    color: Pal.warn;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Modals.pq-replace-cancel(); } }
                    GhostButton { text: "Replace"; clicked => { Ui.pq-replace-confirm(); } }
                }
            }
        }
    }

    // ---- Export "My quantum key" private armor (screen 29): a warning
    // step, then the QR/copy reveal — never shown without the warning
    // first. Copy uses the CONCEALED/expiring clipboard (never the plain
    // one) — same path spending material uses elsewhere.
    if Ui.pq-show-export-private-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea {
            clicked => {
                Ui.pq-imported-hide-private();
                Ui.pq-show-export-private-confirm = false;
            }
        }
        Rectangle {
            width: 400px;
            height: pqexp.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 180px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { clicked => { back-scope.focus(); } }
            pqexp := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                if Modals.pq-imported-private-value == "": VerticalLayout {
                    spacing: 12px;
                    Text {
                        text: "Export your quantum private key?";
                        font-size: 16px;
                        font-weight: 700;
                        color: Pal.text;
                    }
                    Caption {
                        text: "Anyone who gets this can read every quantum-sealed note you have. Use this to back it up, or to mirror the key onto another device — the Prime app imports this same armor.";
                        color: Pal.warn;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        GhostButton { text: "Cancel"; clicked => { Ui.pq-show-export-private-confirm = false; } }
                        GhostButton { text: "Reveal"; clicked => { Modals.pq-imported-reveal-private(); } }
                    }
                }
                if Modals.pq-imported-private-value != "": VerticalLayout {
                    spacing: 12px;
                    Text {
                        text: "Your quantum private key";
                        font-size: 16px;
                        font-weight: 700;
                        color: Pal.text;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 176px;
                            height: 176px;
                            QrArea {
                                img: Modals.pq-imported-private-qr;
                                qr-size: 176px;
                            }
                            TouchArea {
                                clicked => {
                                    Ui.qr-zoom-image = Modals.pq-imported-private-qr;
                                    Ui.qr-zoom-open = true;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        GhostButton { text: "Copy"; clicked => { Modals.pq-imported-copy-private(); } }
                        GhostButton {
                            text: "Done";
                            clicked => {
                                Ui.pq-imported-hide-private();
                                Ui.pq-show-export-private-confirm = false;
                            }
                        }
                    }
                }
            }
        }
    }

    if Ui.show-reset-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.show-reset-confirm = false; } }
        Rectangle {
            width: 400px;
            height: rl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            rl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Switch identity?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body {
                    text: "This removes the current key from this device and returns to onboarding, where you can create a new seed or import a different key (and pick its account).";
                    font-size: 12px;
                }
                Caption {
                    text: "Your notes and funds stay on-chain. Re-import the same key + account and everything comes back. Make sure the backup is written down — without it, this identity is gone.";
                    color: Pal.warn;
                }
                if Ui.icloud-backup: Caption {
                    text: "iCloud backup is ON — this also deletes the key from iCloud, so it will NOT return on reinstall. Your written backup is the only recovery.";
                    color: Pal.bad;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.show-reset-confirm = false; } }
                    PrimaryButton {
                        text: "Remove key & switch";
                        tint: Pal.bad;
                        tint-hover: #ff6b62;
                        clicked => { Modals.reset-identity(); }
                    }
                }
            }
        }
    }

    // ---------- note-too-large dialog (modal overlay) ----------
    if Ui.show-oversize-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.show-oversize-modal = false; } }
        Rectangle {
            width: 400px;
            height: ol.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            ol := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Note too large";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body {
                    text: Modals.oversize-message;
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton {
                        text: Modals.oversize-offer-bump ? "Cancel" : "OK";
                        clicked => { Ui.show-oversize-modal = false; }
                    }
                    if Modals.oversize-offer-bump: PrimaryButton {
                        text: "Switch to Standard";
                        clicked => { Modals.oversize-bump(); }
                    }
                }
            }
        }
    }

    // ---------- speed-up (RBF bump) dialog ----------
    if Ui.show-bump-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { Ui.show-bump-dialog = false; } }
        Rectangle {
            width: 400px;
            height: bl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            // Swallow clicks on the card body; also drops the keyboard.
            TouchArea { clicked => { back-scope.focus(); } }
            bl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Speed up transaction";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body { text: Modals.bump-kind; font-size: 12px; }
                Caption { text: Modals.bump-current; }
                HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        width: 96px;
                        text <=> Modals.bump-rate;
                        edited => { Modals.act-bump-rate-changed(self.text); }
                    }
                    Caption { text: "sat/vB"; vertical-alignment: center; }
                }
                Body { text: Modals.bump-new-fee; font-size: 13px; font-weight: 600; color: Pal.accent; }
                Caption { text: Modals.bump-min; color: Pal.warn; }
                if Modals.bump-error != "": Caption { text: Modals.bump-error; color: Pal.bad; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { Ui.show-bump-dialog = false; } }
                    PrimaryButton { text: "Sign…"; clicked => { Modals.act-bump-confirm(); } }
                }
            }
        }
    }

    // ---------- QR zoom overlay (tap any QR to enlarge it for scanning) ----------
    // Any small on-card QR (address, SeedQR, key export) opens this; a tap
    // anywhere — the dim OR the enlarged code — closes it. The QR image is
    // native module resolution + `pixelated`, so blowing it up stays crisp.
    if Ui.qr-zoom-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.82);
        qr-zoom-card := Rectangle {
            width: min(root.width - 48px, min(root.height - 168px, 380px));
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 16px;
            QrArea {
                img: Ui.qr-zoom-image;
                qr-size: parent.width - 36px;
                x: 18px;
                y: 18px;
            }
        }
        Text {
            text: "Tap to close";
            x: (parent.width - self.width) / 2;
            y: qr-zoom-card.y + qr-zoom-card.height + 18px;
            color: white;
            font-size: 14px;
        }
        // Dismiss layer on TOP so a tap anywhere — including on the enlarged
        // QR — closes it (non-TouchArea siblings above would otherwise swallow
        // the click).
        TouchArea { clicked => { Ui.qr-zoom-open = false; } }
    }

    // ---------- Copy toast ("Copied") ----------
    // Every copy affordance (backup words, address, note text/txid, key-export
    // rows, PSBT base64) funnels through Rust's on-copy-text/on-copy-value/
    // on-psbt-copy, which set toast-text + bump toast-nonce + open toast-open.
    // Non-interactive (no TouchArea) so it never blocks taps underneath. The
    // timer just ticks a countdown (toast-ticks, reset by the toast-nonce
    // changed-handler above) while open, so it auto-dismisses ~1.5s after the
    // LAST copy — see the note on toast-ticks for why this isn't a simple
    // running-toggle restart.
    toast-timer := Timer {
        interval: 250ms;
        running: Ui.toast-open;
        triggered => {
            Ui.toast-ticks -= 1;
            if (Ui.toast-ticks <= 0) {
                Ui.toast-open = false;
            }
        }
    }
    if Ui.toast-open: Rectangle {
        width: 100%;
        height: 100%;
        toast-pill := Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 64px;
            width: toast-label.preferred-width + 32px;
            height: 36px;
            border-radius: 18px;
            background: Pal.card.with-alpha(0.96);
            border-width: 1px;
            border-color: Pal.line;
            toast-label := Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: Ui.toast-text;
                color: Pal.text;
                font-size: 13px;
                font-weight: 600;
            }
        }
    }

    // Splash cover — the topmost child, so it hides everything until Rust
    // flips `ready` (once the safe-area inset is known). Prevents the content
    // from visibly sliding down from under the status bar on cold start.
    if !Modals.ready: Rectangle {
        width: 100%;
        height: 100%;
        background: Pal.bg;
    }
    } // end back-scope (system back)
}

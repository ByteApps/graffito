    Image {
        source: @image-url("icons/pencil.svg");
        colorize: Pal.muted;
        width: 16px;
        height: 16px;
        x: (parent.width - 16px) / 2;
        y: (parent.height - 16px) / 2;
    }
}

component WebViewButton inherits Rectangle {
    callback clicked;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: ta.has-hover ? Pal.card-hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Image {
        source: @image-url("icons/external.svg");
        colorize: Pal.muted;
        width: 15px;
        height: 15px;
        x: (parent.width - 15px) / 2;

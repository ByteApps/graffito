    Text {
        text: root.value;
        font-size: 13px;
        font-weight: 600;
        color: root.value-color;
        vertical-alignment: center;
        horizontal-stretch: 1;
        horizontal-alignment: right;
        overflow: elide;
    }
}

component DoorCard inherits Rectangle {

// M6 screens. Router: screen property. Every user action fires a
// callback whose Rust side emits a `cb:` log-contract line.
import { Button, LineEdit, TextEdit, CheckBox, ListView } from "std-widgets.slint";

export struct NoteItem { id: string, title: string, meta: string }
export struct ContactItem { address: string, name: string }

component Title inherits Text { font-size: 20px; color: #e8eef4; }
component Label inherits Text { font-size: 12px; color: #9ab0c4; wrap: word-wrap; }
component Body inherits Text { font-size: 13px; color: #cfe0ee; wrap: word-wrap; }

export component AppWindow inherits Window {
    width: 480px;
    height: 760px;
    title: "Chain Notes";
    background: #101418;

    // 0 onboard · 1 import · 2 backup · 3 quiz · 4 home · 5 note ·
    // 6 compose · 7 contacts · 8 settings
    in-out property <int> screen: 0;
    in property <string> status;

    in-out property <string> import-text;
    in property <string> import-feedback;
    in property <string> import-suggestions;

    in property <string> backup-words;
    in property <string> quiz-prompt;
    in-out property <string> quiz-answer;

    in property <string> address;
    in property <image> address-qr;
    in property <string> balance-line;
    in property <[NoteItem]> notes;
    in property <string> note-detail;

    in property <string> to-label;
    in-out property <string> compose-text;
    in-out property <bool> compose-private: true;
    in-out property <string> rate-text;
    in property <string> cost-line;
    in property <[ContactItem]> contacts;
    in-out property <string> contact-input;

    in property <string> settings-network;
    in-out property <string> chunk-text;
    in-out property <string> esplora-text;
    in property <string> reveal-text;

    callback door-import();
    callback door-create(int);
    callback import-changed(string);
    callback import-confirm(string);
    callback import-scan();
    callback import-file();
    callback quiz-submit(string);
    callback backup-continue();
    callback refresh();
    callback open-note(string);
    callback compose-open();
    callback pick-contact(string);
    callback contact-scan();
    callback compose-changed();
    callback compose-send();
    callback settings-open();
    callback cycle-network();
    callback set-chunk(string);
    callback set-esplora(string);
    callback reveal-backup();
    callback go-home();

    VerticalLayout {
        padding: 16px;
        spacing: 10px;

        if screen == 0: VerticalLayout {
            spacing: 12px;
            Title { text: "Chain Notes"; }
            Label { text: "Personal notes on the bitcoin blockchain. Pick a door:"; }
            Button { text: "Import from Prime / BIP-85 or other key (recommended)"; clicked => { root.door-import(); } }
            Button { text: "Create new 12-word seed"; clicked => { root.door-create(12); } }
            Button { text: "Create new 24-word seed"; clicked => { root.door-create(24); } }
            Label { text: "This app holds a HOT key on an online computer — fund it with note-fee money only. A BIP-85 child from your Prime is the recommended identity."; }
            Label { text: root.status; }
        }

        if screen == 1: VerticalLayout {
            spacing: 8px;
            Title { text: "Import key"; }
            Label { text: "Mnemonic (12/24 words) · xprv · WIF · 32-byte hex. Typed, scanned, or from a file."; }
            TextEdit {
                height: 110px;
                text <=> root.import-text;
                edited => { root.import-changed(self.text); }
            }
            Label { text: root.import-suggestions; }
            Body { text: root.import-feedback; }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Scan QR"; clicked => { root.import-scan(); } }
                Button { text: "From file…"; clicked => { root.import-file(); } }
            }
            Button { text: "Import"; primary: true; clicked => { root.import-confirm(root.import-text); } }
            Button { text: "Back"; clicked => { root.screen = 0; } }
        }

        if screen == 2: VerticalLayout {
            spacing: 8px;
            Title { text: "Write these words down"; }
            Label { text: "This is the ONLY backup. Anyone with these words can spend the funds and read every private note. No screenshots."; }
            Body { text: root.backup-words; }
            Button { text: "I wrote them down"; primary: true; clicked => { root.backup-continue(); } }
        }

        if screen == 3: VerticalLayout {
            spacing: 8px;
            Title { text: "Spot check"; }
            Body { text: root.quiz-prompt; }
            LineEdit { text <=> root.quiz-answer; placeholder-text: "word1 word2 word3"; }
            Button { text: "Verify"; primary: true; clicked => { root.quiz-submit(root.quiz-answer); } }
            Label { text: root.status; }
        }

        if screen == 4: VerticalLayout {
            spacing: 8px;
            Title { text: "Chain Notes"; }
            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    background: white;
                    width: 150px;
                    height: 150px;
                    border-radius: 6px;
                    Image { source: root.address-qr; width: 140px; height: 140px; image-rendering: pixelated; }
                }
                VerticalLayout {
                    spacing: 6px;
                    Body { text: root.address; }
                    Body { text: root.balance-line; }
                    Button { text: "Refresh"; clicked => { root.refresh(); } }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button { text: "Compose note"; primary: true; clicked => { root.compose-open(); } }
                Button { text: "Settings"; clicked => { root.settings-open(); } }
            }
            Label { text: root.status; }
            ListView {
                for note in root.notes: Rectangle {
                    height: 52px;
                    background: #16202a;
                    border-radius: 6px;
                    TouchArea { clicked => { root.open-note(note.id); } }
                    VerticalLayout {
                        padding: 6px;
                        Body { text: note.title; }
                        Label { text: note.meta; }
                    }
                }
            }
        }

        if screen == 5: VerticalLayout {
            spacing: 8px;
            Title { text: "Note"; }
            Body { text: root.note-detail; }
            Button { text: "Back"; clicked => { root.go-home(); } }
        }

        if screen == 6: VerticalLayout {
            spacing: 8px;
            Title { text: "Compose"; }
            Label { text: root.to-label; }
            TextEdit {
                height: 140px;
                text <=> root.compose-text;
                edited => { root.compose-changed(); }
            }
            HorizontalLayout {
                spacing: 8px;
                CheckBox {
                    text: "Private (encrypted)";
                    checked <=> root.compose-private;
                    toggled => { root.compose-changed(); }
                }
                LineEdit {
                    width: 90px;
                    text <=> root.rate-text;
                    edited => { root.compose-changed(); }
                }
                Label { text: "sat/vB"; vertical-alignment: center; }
            }
            Body { text: root.cost-line; }
            Label { text: "Public notes are world-readable forever; private notes are permanent ciphertext. Either costs a real fee."; }
            Button { text: "Sign + broadcast"; primary: true; clicked => { root.compose-send(); } }
            Button { text: "Back"; clicked => { root.screen = 7; } }
        }

        if screen == 7: VerticalLayout {
            spacing: 8px;
            Title { text: "Send to"; }
            Button { text: "To: Self (my notebook)"; primary: true; clicked => { root.pick-contact("self"); } }
            HorizontalLayout {
                spacing: 8px;
                LineEdit { text <=> root.contact-input; placeholder-text: "taproot or segwit address"; }
                Button { text: "Use"; clicked => { root.pick-contact(root.contact-input); } }
            }
            Button { text: "Scan address QR"; clicked => { root.contact-scan(); } }
            Label { text: root.status; }
            ListView {
                for c in root.contacts: Rectangle {
                    height: 44px;
                    background: #16202a;
                    border-radius: 6px;
                    TouchArea { clicked => { root.pick-contact(c.address); } }
                    VerticalLayout {
                        padding: 6px;
                        Body { text: c.name == "" ? c.address : c.name; }
                        Label { text: c.name == "" ? "" : c.address; }
                    }
                }
            }
            Button { text: "Back"; clicked => { root.go-home(); } }
        }

        if screen == 8: VerticalLayout {
            spacing: 8px;
            Title { text: "Settings"; }
            HorizontalLayout {
                spacing: 8px;
                Body { text: "Network: " + root.settings-network; vertical-alignment: center; }
                Button { text: "Cycle"; clicked => { root.cycle-network(); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Chunk bytes"; vertical-alignment: center; }
                LineEdit { text <=> root.chunk-text; accepted(t) => { root.set-chunk(t); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Label { text: "Esplora URL"; vertical-alignment: center; }
                LineEdit { text <=> root.esplora-text; accepted(t) => { root.set-esplora(t); } }
            }
            Button { text: "Reveal backup"; clicked => { root.reveal-backup(); } }
            Body { text: root.reveal-text; }
            Label { text: root.status; }
            Button { text: "Back"; clicked => { root.go-home(); } }
        }
    }
}

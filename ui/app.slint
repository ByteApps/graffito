// M6 screens, designed. Dark theme, bitcoin-orange accent, card-based
// layout. Property/callback names are the contract with main.rs — do
// not rename. Router: `screen` property; every action emits a cb: line
// on the Rust side.
// AboutSlint carries the "Made with Slint" mark. It is REQUIRED, not
// decoration: this app ships under the Slint Royalty-free Desktop, Mobile
// and Web Applications License 2.0, whose section 2 grants the license
// only if the app either shows this widget in an About screen reachable
// from the top level, or carries the attribution badge on its download
// page. We do both -- see THIRD-PARTY.md.
import { ListView, Switch, AboutSlint } from "std-widgets.slint";
import { Pal, Metrics } from "theme.slint";
import { EditOps, EditField, EditArea } from "edit.slint";
import { Screen, NoteItem, NotebookItem, SenderItem, ContactItem, RevealRow, NbPickRow, AccountItem, CoinItem, SpendingCoinItem, SpendCoin, PsbtRow, FundingWalletRow, ActivityItem } from "types.slint";
import { Ui, Modals, Info, Terms, Settings, BackupWords, ImportKey, Quiz, Home, Note, Compose, Change, PayFrom, Sweep, FundingWalletScreen, ExportPsbt, Confirm, Coins, AccountPicker, PublicKeys, PrivateKeys, QuantumKeys, Activity, Onboarding, Dice, EntropySource, Contacts, FundingWallets, ImportSignedPsbt, Notebooks } from "globals.slint";
import { H1, Body, Caption, Mono, Card, PrimaryButton, GhostButton, IconButton, SvgIconButton, SyncButton, BackButton, Header, Badge, CopyButton, QrSpinner, QrArea, PencilButton, WebViewButton, ScanButton, SelectPill, Dropdown, SettingsCard, KvRow, DoorCard, CoinListPanel, TxConfirmView } from "components.slint";
// One Slint file per screen (U3b) — each `if Ui.screen == Screen.<x>:` body
// below now just instantiates the matching component.
import { OnboardingScreen } from "screens/onboarding.slint";
import { ImportKeyScreen } from "screens/import-key.slint";
import { BackupWordsScreen } from "screens/backup-words.slint";
import { QuizScreen } from "screens/quiz.slint";
import { HomeScreen } from "screens/home.slint";
import { NoteScreen } from "screens/note.slint";
import { ComposeScreen } from "screens/compose.slint";
import { ContactsScreen } from "screens/contacts.slint";
import { SettingsScreen } from "screens/settings.slint";
import { AccountPickerScreen } from "screens/account-picker.slint";
import { CoinsScreen } from "screens/coins.slint";
import { ActivityScreen } from "screens/activity.slint";
import { FundingWalletDetailScreen } from "screens/funding-wallet.slint";
import { ExportPsbtScreen } from "screens/export-psbt.slint";
import { ImportSignedPsbtScreen } from "screens/import-signed-psbt.slint";
import { FundingWalletsScreen } from "screens/funding-wallets.slint";
import { SweepScreen } from "screens/sweep.slint";
import { NotebooksScreen } from "screens/notebooks.slint";
import { PublicKeysScreen } from "screens/public-keys.slint";
import { PrivateKeysScreen } from "screens/private-keys.slint";
import { PayFromScreen } from "screens/pay-from.slint";
import { ChangeScreen } from "screens/change.slint";
import { TermsScreen } from "screens/terms.slint";
import { InfoScreen } from "screens/info.slint";
import { ConfirmScreen } from "screens/confirm.slint";
import { EntropySourceScreen } from "screens/entropy-source.slint";
import { DiceScreen } from "screens/dice.slint";
import { QuantumKeysScreen } from "screens/quantum-keys.slint";
import { ScanningModal, FundRenameModal, RenameAddressModal, NbRenameModal, ConfirmRemoveAddressModal, DiceClearConfirmModal, PqBackupConfirmModal, PqReplaceConfirmModal, PqExportPrivateConfirmModal, ResetConfirmModal, OversizeModal, BumpDialogModal, QrZoomModal, ToastModal, SplashModal } from "modals.slint";
// Rust (src/lib.rs, via slint::include_modules!()) needs these re-exported
// from the entry-point file.
export { Metrics, EditOps, Screen, NoteItem, NotebookItem, SenderItem, ContactItem, RevealRow, NbPickRow, AccountItem, CoinItem, SpendingCoinItem, SpendCoin, PsbtRow, FundingWalletRow, ActivityItem, Ui, Modals, Info, Terms, Settings, BackupWords, ImportKey, Quiz, Home, Note, Compose, Change, PayFrom, Sweep, FundingWalletScreen, ExportPsbt, Confirm, Coins, AccountPicker, PublicKeys, PrivateKeys, QuantumKeys, Activity, Onboarding, Dice, EntropySource, Contacts, FundingWallets, ImportSignedPsbt, Notebooks }

export component AppWindow inherits Window {
    preferred-width: 480px;
    preferred-height: 780px;
    min-width: 440px;
    min-height: 620px;
    title: "Graffito";
    background: Pal.bg;
    init => { EditOps.win-width = self.width; }
    changed width => { EditOps.win-width = self.width; }
















    function nav-back() -> bool {
        // Overlays first, topmost (= last window child) before the rest —
        // back closes the same thing a tap on Cancel / the dim would.
        if (Ui.show-dice-clear-confirm) { Ui.show-dice-clear-confirm = false; return true; }
        if (Ui.qr-zoom-open) { Ui.qr-zoom-open = false; return true; }
        if (Ui.show-bump-dialog) { Ui.show-bump-dialog = false; return true; }
        if (Ui.show-oversize-modal) { Ui.show-oversize-modal = false; return true; }
        if (Ui.show-reset-confirm) { Ui.show-reset-confirm = false; return true; }
        if (Ui.confirm-remove-address != "") { Ui.cancel-remove(); return true; }
        if (Ui.rename-address != "") { Ui.cancel-rename(); return true; }
        if (Ui.fund-rename-id != "") { Ui.fund-rename-cancel(); return true; }
        if (Ui.nb-rename-index >= 0) { Ui.nb-rename-cancel(); return true; }
        if (Ui.scanning) { Ui.cancel-scan(); return true; }
        // Screens: one branch per header chevron.
        if (Ui.screen == Screen.import-key || Ui.screen == Screen.backup-words) { Ui.screen = Screen.onboarding; return true; }
        // Entropy-source door → back to onboarding; dice entry → back to the
        // door (so "This device" is still one tap away mid-roll).
        if (Ui.screen == Screen.entropy-source) { Ui.screen = Screen.onboarding; return true; }
        if (Ui.screen == Screen.dice) { Ui.screen = Screen.entropy-source; return true; }
        if (Ui.screen == Screen.home) { Ui.open-notebooks(); return true; }
        if (Ui.screen == Screen.quiz) { Ui.screen = Screen.backup-words; return true; }
        if (Ui.screen == Screen.note) { Ui.go-home(); return true; }
        if (Ui.screen == Screen.settings || Ui.screen == Screen.activity) {
            // Back to wherever settings/activity was opened from.
            if (Ui.return-screen == Screen.notebooks) { Ui.open-notebooks(); } else { Ui.go-home(); }
            return true;
        }
        if (Ui.screen == Screen.compose) {
            // Clear the typed address on the way back — it's saved in recents
            // now, so leaving it in the field is redundant. Status too: its
            // message belonged to this screen.
            Ui.contact-input = "";
            Ui.status = "";
            Ui.screen = Ui.compose-return;
            return true;
        }
        if (Ui.screen == Screen.contacts) {
            if (Ui.pick-mode == "sweep") {
                Ui.pick-mode = "compose";
                Ui.screen = Screen.settings;
            } else if (Ui.picking-extra) {
                // "+ Add recipient" reopened the picker on top of compose —
                // back returns to compose, not home.
                Ui.picking-extra = false;
                Ui.screen = Screen.compose;
            } else {
                Ui.go-home();
            }
            return true;
        }
        if (Ui.screen == Screen.account-picker) { Ui.account-cancel(); return true; }
        if (Ui.screen == Screen.coins) { Ui.screen = Screen.settings; return true; }
        if (Ui.screen == Screen.funding-wallet) { Ui.open-funding(); return true; }
        if (Ui.screen == Screen.export-psbt) { Ui.screen = Ui.watch-only ? Screen.settings : Screen.compose; return true; }
        if (Ui.screen == Screen.import-signed-psbt) { Ui.screen = Screen.export-psbt; return true; }
        if (Ui.screen == Screen.funding-wallets) { Ui.screen = Ui.funding-return; return true; }
        if (Ui.screen == Screen.sweep) {
            // Clear the typed address + any stale status on the way back —
            // success messages otherwise linger red on the picker. Sweep
            // returns to its destination picker, consolidate to the coins.
            Ui.contact-input = "";
            Ui.status = "";
            if (Ui.sweep-kind == "consolidate") {
                Ui.screen = Screen.coins;
            } else {
                Ui.pick-mode = "sweep";
                Ui.screen = Screen.contacts;
            }
            return true;
        }
        // Pay-from (screen 20): reached only from compose's compact row —
        // back always returns to compose, draft untouched (no field wipes,
        // unlike screen 6's own back-to-picker branch above).
        if (Ui.screen == Screen.pay-from) { Ui.screen = Screen.compose; return true; }
        // Change (screen 21): reached only from compose's second nav row —
        // back returns to compose too (a sibling of the Pay-from row, not
        // nested under screen 20).
        if (Ui.screen == Screen.change) { Ui.screen = Screen.compose; return true; }
        if (Ui.screen == Screen.public-keys || Ui.screen == Screen.private-keys) {
            Ui.reveal-hide();
            Ui.screen = Screen.settings;
            return true;
        }
        if (Ui.screen == Screen.quantum-keys) {
            Ui.pq-show-backup-confirm = false;
            Ui.pq-show-replace-confirm = false;
            if (Ui.pq-show-export-private-confirm) {
                Ui.pq-imported-hide-private();
            }
            Ui.pq-show-export-private-confirm = false;
            Ui.screen = Screen.settings;
            return true;
        }
        // Terms & disclaimer: the first-run accept gate can't be skipped with
        // back; the read-only re-view returns to Settings.
        if (Ui.screen == Screen.terms) {
            if (Ui.terms-accept-mode) { return false; }
            Ui.screen = Screen.settings;
            return true;
        }
        if (Ui.screen == Screen.info) { Ui.screen = Screen.settings; return true; } // info → Settings
        // Universal confirm screen: back always cancels (never a bare nav —
        // Rust's on_confirm_cancel clears the pending broadcast + props and
        // picks the return screen), so Android back can't quit from here.
        if (Ui.screen == Screen.confirm) { Ui.confirm-cancel(); return true; }
        return false; // 0 onboarding / 17 notebook list: nothing to go back to
    }

    back-scope := FocusScope {
        focus-on-click: false; // never steal a tap's focus from a field
        focus-on-tab-navigation: false; // no invisible Tab stop between fields
        init => { self.focus(); }
        // The Down press decides (and navigates); the matching Up must replay
        // the same verdict — Android only runs its own default when it saw
        // the whole tracked down+up pair unhandled. Repeats replay too, so a
        // long-press can't navigate several screens at once.
        property <bool> back-eaten: false;
        // Focus must never be nobody's, or key events (incl. Back) are dropped
        // before they can bubble anywhere: re-take it whenever the focused
        // element may just have been destroyed -- a screen change, or one of the
        // two self-focusing rename dialogs closing. (Bridged from Ui via
        // two-way mirror properties: a global cannot call `self.focus()` on this
        // AppWindow-local FocusScope, so the `changed` observers that used to
        // live directly on AppWindow live here instead, watching mirrors of the
        // now-global properties.)
        property <Screen> mirror-screen <=> Ui.screen;
        property <string> mirror-rename-address <=> Ui.rename-address;
        property <string> mirror-fund-rename-id <=> Ui.fund-rename-id;
        property <int> mirror-nb-rename-index <=> Ui.nb-rename-index;
        // U3b: same mirror trick for the two nonces extracted screens/modals
        // bump instead of calling `back-scope.focus()` / `root.nav-back()`
        // directly (see Ui.focus-back-scope-nonce / Ui.nav-back-nonce).
        property <int> mirror-focus-nonce <=> Ui.focus-back-scope-nonce;
        property <int> mirror-nav-back-nonce <=> Ui.nav-back-nonce;
        changed mirror-screen => { self.focus(); }
        changed mirror-rename-address => { if (mirror-rename-address == "") { self.focus(); } }
        changed mirror-fund-rename-id => { if (mirror-fund-rename-id == "") { self.focus(); } }
        changed mirror-nb-rename-index => { if (mirror-nb-rename-index < 0) { self.focus(); } }
        changed mirror-focus-nonce => { self.focus(); }
        changed mirror-nav-back-nonce => { root.nav-back(); }
        key-pressed(event) => {
            if (event.text != Key.Back) { return reject; }
            if (!event.repeat) {
                back-eaten = root.nav-back();
                Ui.back-logged(back-eaten, Ui.screen);
            }
            return back-eaten ? accept : reject;
        }
        key-released(event) => {
            return (event.text == Key.Back && back-eaten) ? accept : reject;
        }

    // NOTE: back-scope wraps every window child from here down to its
    // matching closing brace at the bottom of the file; the children keep
    // their original one-level indent (mechanical wrap — slint is
    // whitespace-insensitive, and re-indenting ~2200 lines would bury the
    // file's history).

    // GLOBAL keyboard-dismiss layer (Sal 2026-08-01: "keyboard should always
    // be dismissable when tapping other parts of the app"). It is the FIRST
    // child of back-scope, so it fills the window and sits UNDER every screen
    // — later siblings win input in slint, so any interactive child (field,
    // button, pill, modal) still grabs its own tap and this only ever fires
    // on genuinely empty space. Moving focus to back-scope is what drops the
    // on-screen keyboard; never clear-focus(), which would leave Android's
    // Back key undeliverable (see the system-back note above).
    //
    // This covers every screen whose root is a plain VerticalLayout — screen
    // 2's extra-entropy field and screen 3's quiz answer among them. It does
    // NOT reach inside a Flickable, which intercepts pointer events across
    // its own region, so each Flickable holding a text field carries its own
    // copy of this layer (screens 6, 8, 16, 21 — search "dismiss layer").
    TouchArea { clicked => { back-scope.focus(); } }

    if Ui.screen == Screen.onboarding: OnboardingScreen { }

    if Ui.screen == Screen.import-key: ImportKeyScreen { }

    if Ui.screen == Screen.backup-words: BackupWordsScreen { }

    if Ui.screen == Screen.quiz: QuizScreen { }

    if Ui.screen == Screen.home: HomeScreen { }

    if Ui.screen == Screen.notebooks: NotebooksScreen { }

    if Ui.screen == Screen.note: NoteScreen { }

    if Ui.screen == Screen.compose: ComposeScreen { }

    if Ui.screen == Screen.contacts: ContactsScreen { }

    if Ui.screen == Screen.settings: SettingsScreen { }

    if Ui.screen == Screen.account-picker: AccountPickerScreen { }

    if Ui.screen == Screen.coins: CoinsScreen { }

    if Ui.screen == Screen.activity: ActivityScreen { }

    if Ui.screen == Screen.funding-wallet: FundingWalletDetailScreen { }

    if Ui.screen == Screen.export-psbt: ExportPsbtScreen { }

    if Ui.screen == Screen.import-signed-psbt: ImportSignedPsbtScreen { }

    if Ui.screen == Screen.funding-wallets: FundingWalletsScreen { }

    if Ui.screen == Screen.sweep: SweepScreen { }

    if Ui.screen == Screen.pay-from: PayFromScreen { }

    if Ui.screen == Screen.change: ChangeScreen { }

    if Ui.screen == Screen.public-keys: PublicKeysScreen { }

    if Ui.screen == Screen.private-keys: PrivateKeysScreen { }

    if Ui.screen == Screen.quantum-keys: QuantumKeysScreen { }

    if Ui.screen == Screen.terms: TermsScreen { }

    if Ui.screen == Screen.info: InfoScreen { }

    if Ui.screen == Screen.entropy-source: EntropySourceScreen { }

    if Ui.screen == Screen.dice: DiceScreen { }

    if Ui.screen == Screen.confirm: ConfirmScreen { }

    if Ui.scanning: ScanningModal { }

    if Ui.fund-rename-id != "": FundRenameModal { }

    if Ui.rename-address != "": RenameAddressModal { }

    if Ui.nb-rename-index >= 0: NbRenameModal { }

    if Ui.confirm-remove-address != "": ConfirmRemoveAddressModal { }

    if Ui.show-dice-clear-confirm: DiceClearConfirmModal { }

    if Ui.pq-show-backup-confirm: PqBackupConfirmModal { }

    if Ui.pq-show-replace-confirm: PqReplaceConfirmModal { }

    if Ui.pq-show-export-private-confirm: PqExportPrivateConfirmModal { }

    if Ui.show-reset-confirm: ResetConfirmModal { }

    if Ui.show-oversize-modal: OversizeModal { }

    if Ui.show-bump-dialog: BumpDialogModal { }

    if Ui.qr-zoom-open: QrZoomModal { }

    // ---------- Copy toast ("Copied") ----------
    // Every copy affordance (backup words, address, note text/txid, key-export
    // rows, PSBT base64) funnels through Rust's on-copy-text/on-copy-value/
    // on-psbt-copy, which set toast-text + bump toast-nonce + open toast-open.
    // Non-interactive (no TouchArea) so it never blocks taps underneath. The
    // timer just ticks a countdown (toast-ticks, reset by the toast-nonce
    // changed-handler above) while open, so it auto-dismisses ~1.5s after the
    // LAST copy — see the note on toast-ticks for why this isn't a simple
    // running-toggle restart.
    toast-timer := Timer {
        interval: 250ms;
        running: Ui.toast-open;
        triggered => {
            Ui.toast-ticks -= 1;
            if (Ui.toast-ticks <= 0) {
                Ui.toast-open = false;
            }
        }
    }
    if Ui.toast-open: ToastModal { }

    if !Modals.ready: SplashModal { }
    } // end back-scope (system back)
}

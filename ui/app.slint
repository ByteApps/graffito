}

// Back chevron, shifted off the button's geometric center onto the title's
// visual center by the per-platform Metrics.back-dy (see the global above).
component BackButton inherits Rectangle {
    callback clicked;
    width: 44px;
    height: 40px;
    border-radius: 10px;
    background: ta.has-hover ? Pal.card-hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Image {
        source: @image-url("icons/chevron-left.svg");
        colorize: Pal.text;
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + Metrics.back-dy;
    }
}


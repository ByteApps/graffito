// Nested coin-control list under a wallet row on the Pay-from screen
// (funding-unification UI rework, 2026-07-16): checkbox-style coin rows,
// content driven entirely by `in` properties so the SAME AppWindow-level
// `spend-coins`/`spend-title` state (recomputed in Rust for whichever
// source is expanded) renders under whichever wallet row is currently
// expanded — the "Coins" section is no longer a page-level block.
// Deliberately NEUTRAL always (Sal's iPhone bug cluster, 2026-07-18,
// defect #3): a panel with 0 selected coins is a normal state, not an
// error, and the insufficiency verdict is now a WHOLE-SCREEN concern shown
// once under the summary card — so this component no longer takes an
// `enough` input or renders its own copy of the warning.
component CoinListPanel inherits VerticalLayout {
    in property <[SpendCoin]> coins;
    in property <string> title;
    in property <int> strategy;
    callback pick-strategy(int);
    callback toggle(string);
    callback refresh();
    callback explorer(string);
    padding: 10px;
    spacing: 8px;
    HorizontalLayout {
        Text {
            text: root.title;
            font-size: 12px;
            color: Pal.muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        SvgIconButton {
            icon: "refresh";
            size: 14px;
            width: 28px;
            height: 22px;
            clicked => { root.refresh(); }
        }
    }
    Caption { text: "Tap coins to include or exclude. The note spends exactly what's selected."; }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        SelectPill { text: "fewest coins"; active: root.strategy == 0; clicked => { root.pick-strategy(0); } }
        SelectPill { text: "consolidate"; active: root.strategy == 1; clicked => { root.pick-strategy(1); } }
    }
    for c in root.coins: Rectangle {
        height: 42px;
        border-radius: 8px;
        border-width: 1px;
        border-color: c.selected ? Pal.accent : Pal.line;
        background: c.selected ? Pal.accent.with-alpha(0.10) : transparent;
        TouchArea { clicked => { root.toggle(c.outpoint); } }
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 10px;
            Rectangle {
                width: 18px;
                height: 18px;
                y: (parent.height - 18px) / 2;
                border-radius: 4px;
                border-width: 2px;
                border-color: c.selected ? Pal.accent : Pal.muted;
                background: c.selected ? Pal.accent : transparent;
                if c.selected: Rectangle {
                    width: 8px; height: 8px;
                    x: (parent.width - 8px) / 2;
                    y: (parent.height - 8px) / 2;
                    background: Pal.on-accent;
                    border-radius: 2px;
                }
            }
            VerticalLayout {
                alignment: center;
                Text { text: c.value + " sats"; font-size: 12px; color: Pal.text; }
            }
            Rectangle { }
            VerticalLayout {
                alignment: center;
                Badge { label: c.confirmed ? "confirmed" : "unconfirmed"; tint: c.confirmed ? Pal.good : Pal.warn; }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 22px;
                    width: cplpill.preferred-width + 14px;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: Pal.line;
                    background: cplta.has-hover && c.explorer != "" ? Pal.card-hover : transparent;
                    cplta := TouchArea { clicked => { if (c.explorer != "") { root.explorer(c.explorer); } } }
                    cplpill := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 7px;
                        spacing: 4px;
                        Text {
                            text: c.txid-short;
                            font-family: "Menlo";
                            font-size: 10px;
                            color: Pal.muted;
                            vertical-alignment: center;
                        }
                        if c.explorer != "": Image {
                            source: @image-url("icons/external.svg");
                            colorize: Pal.accent;
                            width: 11px;
                            height: 11px;
                            y: (parent.height - 11px) / 2;
                        }
                    }
                }
            }
        }
    }
}

// The universal "Confirm & broadcast" screen's decoded-tx view (extracted
// out of the old screen 14 inline confirm block, funding-unification
// follow-up 2026-07-17): a paranoid-bitcoiner readout of the SIGNED tx
// about to hit the wire — every fact here comes from `app_core::confirm::
// summarize_signed_tx` decoding the actual raw bytes, never from the app's
// own intent. Screen 26 is the only user of this; screen 14 now stops at
// loading + validating the signed PSBT.
component TxConfirmView inherits Flickable {
    in property <string> note;
    in property <[PsbtRow]> inputs;
    in property <[PsbtRow]> outputs;
    in property <string> fee-line;
    in property <string> warn;
    in property <string> txid;
    viewport-height: conf-col.preferred-height;
    conf-col := VerticalLayout {
        spacing: 10px;
        alignment: start;
        if root.warn != "": Rectangle {
            border-radius: 10px;
            background: Pal.warn.with-alpha(0.12);
            border-width: 1px;
            border-color: Pal.warn.with-alpha(0.4);
            height: warn-t.preferred-height + 20px;
            warn-t := Caption {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                color: Pal.warn;
                text: root.warn;
            }
        }
        if root.txid != "": Mono {
            text: "txid " + root.txid;
            font-size: 10px;
            color: Pal.muted;
            overflow: elide;
            wrap: no-wrap;
        }
        if root.note != "": Rectangle {
            border-radius: 10px;
            background: Pal.accent.with-alpha(0.08);
            border-width: 1px;
            border-color: Pal.accent.with-alpha(0.35);
            height: ncard.preferred-height;
            ncard := VerticalLayout {
                padding: 14px;
                spacing: 6px;
                Caption { text: "NOTE"; color: Pal.accent; }
                Body { text: root.note; }
            }
        }
        Caption { text: "INPUTS"; }
        for i in root.inputs: Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: irow.preferred-height;
            irow := HorizontalLayout {
                padding: 12px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    Mono { text: i.title; font-size: 11px; overflow: elide; wrap: no-wrap; }
                    Caption { text: i.subtitle; font-size: 10px; overflow: elide; }
                }
                Mono {
                    text: i.amount + " sats";
                    color: Pal.text;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
        Caption { text: "OUTPUTS"; }
        for o in root.outputs: Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: o.kind == "self" ? Pal.good.with-alpha(0.4)
                : (o.kind == "recipient" ? Pal.accent.with-alpha(0.4)
                : (o.kind == "other" ? Pal.bad.with-alpha(0.4) : Pal.line));
            height: orow.preferred-height;
            orow := HorizontalLayout {
                padding: 12px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Badge {
                            label: o.kind;
                            tint: o.kind == "self" ? Pal.good
                                : (o.kind == "recipient" ? Pal.accent
                                : (o.kind == "change" ? Pal.faint
                                : (o.kind == "note" ? Pal.accent
                                : (o.kind == "other" ? Pal.bad : Pal.muted))));
                        }
                    }
                    if o.title != "": Mono { text: o.title; font-size: 11px; overflow: elide; wrap: no-wrap; }
                    if o.subtitle != "": Caption { text: o.subtitle; font-size: 10px; overflow: elide; }
                }
                Mono {
                    // A 0-value OP_RETURN row has an empty amount — no
                    // orphaned "sats" suffix (Sal, testnet4 build-14 review).
                    text: o.amount == "" ? "" : o.amount + " sats";
                    color: o.kind == "self" ? Pal.good : Pal.text;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: frow.preferred-height;
            frow := HorizontalLayout {
                padding: 14px;
                Text {
                    text: "Network fee";
                    font-size: 13px;
                    color: Pal.muted;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Mono { text: root.fee-line; color: Pal.text; }
            }
        }
    }
}

export component AppWindow inherits Window {
    preferred-width: 480px;
    preferred-height: 780px;
    min-width: 440px;
    min-height: 620px;
    title: "Chain Notes";
    background: Pal.bg;
    init => { EditOps.win-width = self.width; }
    changed width => { EditOps.win-width = self.width; }

    // 0 onboard · 1 import · 2 backup · 3 quiz · 4 home · 5 note ·
    // 6 compose · 7 contacts · 8 settings
    in-out property <int> screen: 0;
    in-out property <string> status; // in-out: back buttons clear stale messages

    // Transient "Copied" toast (auto-dismisses ~1.5s after the LAST copy).
    // Every copy affordance (copy-text/copy-value/psbt-copy) funnels here from
    // Rust; toast-nonce bumps on each show. toast-ticks is a countdown (in
    // toast-timer intervals) decremented by the timer and reset by the
    // toast-nonce changed-handler below — a repeat copy while the toast is
    // still open just pushes the countdown back out, no timer restart needed
    // (toggling a running Timer's `running` off/on within one callback does
    // NOT reset its elapsed time in Slint: the net value is unchanged within
    // the same evaluation, so the runtime never sees a rising edge to restart
    // from — confirmed empirically 2026-07-15, don't reintroduce that pattern).
    in-out property <string> toast-text;
    in-out property <bool> toast-open;
    in-out property <int> toast-nonce;
    in-out property <int> toast-ticks;

    // Safe-area insets (set from Rust on iOS: status bar / Dynamic Island /
    // home indicator). 0 on macOS. Applied as padding on each screen root.
    in property <length> safe-top: 0px;
    in property <length> safe-bottom: 0px;
    // Set true by Rust once the safe-area inset is known; until then a splash
    // cover hides the content so it never slides down from under the status
    // bar on cold start.
    in property <bool> ready: false;

    // iCloud Keychain backup opt-in (current stored state) + restore-availability.
    in-out property <bool> icloud-backup: false;
    // A synced backup EXISTS (offer a restore door in onboarding).
    in property <bool> icloud-available: false;
    // iCloud is available on this device (signed in) so backup CAN work — gates
    // the "Back up to iCloud" toggle; when false we disable it and say so.
    in property <bool> icloud-enabled: false;

    // Info screens (25) — About / Privacy / Help / Q&A share one screen; Rust
    // sets the title + body. Terms & disclaimer (24) is its own screen: it's the
    // first-run accept gate (terms-accept-mode = true → shows Accept, no back)
    // and, from Settings, a read-only re-view (terms-accept-mode = false).
    in property <string> info-title;
    in property <string> info-body;
    in property <string> disclaimer-body;
    in property <bool> terms-accept-mode;
    // Settings scroll position, preserved across sub-screen visits (Rust resets
    // it to 0 on a fresh open from the list; nav-back keeps it).
    in-out property <length> settings-scroll-y: 0;
    // Apple-only UI (iCloud Keychain sync) — hidden on Android, where the
    // keystore is device-bound and there is no iCloud.
    in property <bool> apple-platform: true;
    // Desktop-only UI (native file dialogs via rfd) — hidden on iOS/Android,
    // where platform::pick_file/save_file return None and the QR + clipboard
    // paths carry the flows instead.
    in property <bool> desktop-platform: true;
    // What the reveal prompt authenticates with, per platform ("Touch ID" /
    // "Face ID" / "biometrics") — copy only, the gating is in keychain.rs.
    in property <string> biometric-name: "Touch ID";

    // Backup screen: "Advanced" collapsible + optional user entropy ("salt").
    in-out property <bool> advanced-expanded: false;
    in-out property <string> entropy-salt;

    in-out property <string> import-text;
    in property <string> import-feedback;
    in property <bool> import-feedback-ok;
    in property <string> import-suggestions;

    in property <string> backup-words;
    in property <string> quiz-prompt;
    in-out property <string> quiz-answer;

    in property <string> address;
    in property <image> address-qr;
    in property <string> balance-line;
    in property <[NoteItem]> notes;
    in property <string> note-detail;
    in property <string> note-web-url;
    in-out property <string> note-view-id;
    in property <bool> note-pending;
    in property <string> note-txid;
    in property <string> note-reply-address;   // the note's single counterparty (received: the sender; own directed: its sole recipient); "" hides Reply
    // Reply-all (multi-recipient): {sender} ∪ recipients minus me, sender
    // first (notes-core's `reply_set`), contact names resolved. Hidden
    // whenever length <= 1 — nothing to add beyond what plain Reply covers.
    in property <[ContactItem]> note-reply-set;

    // The primary recipient's contact name / address, or "Self (my
    // notebook)" — NO "To: " prefix (Sal, 2026-07-19: the compose screen's
    // "To" section caption carries that now; see the uniform To rows).
    in property <string> to-label;
    // Multi-recipient directed notes: removable To-chips beyond the
    // primary recipient (`to-label`) — the compose screen's "+ Add
    // recipient" flow. Empty = today's ordinary single-recipient compose.
    in property <[ContactItem]> to-chips;
    // True while the send-to picker (screen 7) is collecting an EXTRA
    // recipient (opened via "+ Add recipient") rather than picking the
    // primary one.
    in-out property <bool> picking-extra: false;
    in-out property <string> compose-text;
    in-out property <bool> compose-private: true;
    in-out property <string> rate-text;
    in-out property <int> fee-tier: 1;
    // Plain accent text under the rate box — ERROR/status messaging only
    // since the structured cost card (build-17 follow-up, Sal 2026-07-18:
    // "use sections key: value so it's more clear"): "Too large to
    // broadcast…", "~N sats fee minimum", "funded from the external
    // wallet". Rendered only while the structured props below are empty.
    in property <string> cost-line;
    // Structured cost breakdown card (key:value rows). An empty string
    // hides that row; all-empty hides the whole card. `cost-fold`/
    // `cost-total` only populate when the dust-rule fold prediction fires
    // (Total == Fee otherwise — the row would be noise).
    in property <string> cost-size;   // "1 chunk · ~151 vB"
    in property <string> cost-fee;    // "~151 sats (~$0.00)" — NOMINAL fee
    in property <string> cost-gift;   // "+330 sats" (directed: recipient output)
    in property <string> cost-dust;   // "+330 sats" (funded shapes: dust-to-self)
    in property <string> cost-fold;   // "+227 sats" (dust-rule leftover)
    in property <string> cost-total;  // "~330 sats" (fee + leftover, fold only)
    // Async sign+broadcast (2026-07-16): true while a compose send
    // (notebook/spending/mixed) is building or broadcasting — disables the
    // Sign button and swaps its caption; compose-stage names the phase.
    in property <bool> compose-sending;
    in property <string> compose-stage; // "signing" | "broadcasting" | ""
    out property <string> compose-progress-label: root.compose-stage == "broadcasting" ? "Broadcasting…" : "Signing…";
    // Directed-note gift: is the current note directed, the sats to gift, and
    // whether the collapsible gift section is open.
    in property <bool> directed;
    in-out property <string> gift-sats;
    in-out property <bool> gift-expanded;
    // "Note too large to broadcast" dialog (per-tx ~100 kB ceiling).
    in-out property <bool> show-oversize-modal;
    in property <bool> oversize-offer-bump; // true → offer to switch to Standard
    in property <string> oversize-message;
    in-out property <string> change-address;
    in-out property <bool> change-expanded;
    in property <string> change-amount;
    in property <string> change-error;
    in property <[SpendCoin]> spend-coins;
    in property <string> spend-title;
    in-out property <bool> spend-expanded;
    in-out property <int> coin-strategy;
    in property <bool> spend-enough: true;
    // ---- external funding (pay a note from another wallet via PSBT) ----
    in-out property <bool> fund-external;      // compose toggle
    in property <bool> funding-ready;          // a valid source with coins is loaded
    in property <string> funding-summary;      // one-line source summary (or a call to action)
    in-out property <string> funding-descriptor;
    in property <string> funding-feedback;     // parse feedback on the entry screen
    in property <bool> funding-valid;
    in property <image> psbt-qr;               // current animated-UR frame
    in property <string> psbt-frame-label;     // "frame 2 / 5" or "" for a single frame
    in property <string> psbt-cost-line;       // "fee 240 sats · 1 input · 187 vB"
    in property <bool> psbt-signed;            // an imported signed PSBT validated
    in property <[PsbtRow]> confirm-inputs;
    in property <[PsbtRow]> confirm-outputs;
    in property <string> confirm-note;         // decoded note text (public) or placeholder
    in property <string> confirm-fee-line;
    // ---- universal confirm screen (26), funding-unification follow-up ----
    in property <string> confirm-warn;         // amber warning banner text, "" = none
    in property <string> confirm-txid;         // decoded from the signed raw tx
    in property <string> confirm-context;      // one-liner under the header, e.g. "Public note · testnet4"
    in property <[FundingWalletRow]> funding-wallets;   // saved wallet manager
    in-out property <string> fund-rename-id;            // non-empty = rename modal open
    in-out property <string> fund-rename-input;
    // ---- internal spending wallet (funding-unification M3, PLAN-chain-notes-funding-unification.md) ----
    // Same BIP-84 branch of the SAME seed as the notebook's BIP-86 leaf,
    // signed fully in-app — no PSBT round trip. HD identities only.
    in property <bool> spending-capable;      // material can derive m/84' (mnemonic / master xprv)
    in-out property <bool> spending-enabled;  // the persisted Settings toggle
    in property <string> spending-summary;    // "12,340 sats · 2 coins" or a call to action
    in property <string> spending-balance-line;
    in property <string> spending-address;    // next unused receive address
    in property <image> spending-qr;
    in property <[SpendingCoinItem]> spending-coins-list;   // Coins screen "Spending" segment
    in-out property <string> coins-segment: "notebook";      // "notebook" | "spending"
    // Compose "Pay from" picker: "notebook" (default) | "spending" | "wallet"
    // (an external funding wallet — `fund-external` still drives its own
    // panel/flow, unchanged; `pay-from` only decides which pill is lit and
    // the header label).
    in-out property <string> pay-from: "notebook";
    in-out property <bool> payfrom-expanded;
    in property <string> pay-from-label: "Notebook";
    // Short "<n> sats" figure for the compose compact row AND the funding
    // screen's Notebook row — always fits, always elided (never widens the
    // row). Updated whenever the selected source's balance changes.
    in property <string> pay-from-balance;
    in property <string> funding-notebook-balance;
    in-out property <bool> spend-from-wallet;   // internal spending-wallet compose mode
    // ---- multi-wallet coin selection (funding-unification UI rework) ----
    // Coins nest under each wallet row on screen 20. Independent-expand
    // rework (2026-07-18, Sal's iPhone feedback): Notebook and Spending
    // expand/collapse independently via their own booleans below — opening
    // one never hides another's selection, and a header tap ONLY toggles
    // visibility (never selection). External wallets stay an accordion
    // AMONG THEMSELVES (this app only ever keeps one external wallet's
    // coins scanned/cached live at a time) — `payfrom-expanded-source` now
    // tracks ONLY that slot: "" = none, "wallet:<id>" otherwise.
    in-out property <bool> nb-expanded;
    in-out property <bool> sp-expanded;
    in-out property <string> payfrom-expanded-source: "";
    // Each section's OWN coin list + caption (independent-expand rework) —
    // NOT the legacy singular `spend-coins`/`spend-title` below (those stay
    // driven by whichever source is the compose engine's active pay-from,
    // feeding the live fee/change preview; external wallets carry their own
    // `coins`/`coin-title` directly on `FundingWalletRow` since they're a
    // dynamic list).
    in property <[SpendCoin]> nb-panel-coins;
    in property <string> nb-panel-title;
    in property <[SpendCoin]> sp-panel-coins;
    in property <string> sp-panel-title;
    // Pay-from screen summary card + compose row (Sal's iPhone bug cluster,
    // 2026-07-18): ONE global verdict computed by Rust's `payfrom_state` from
    // the TRUE cross-wallet selection — never a separately invented estimate,
    // and never dependent on which panel is `payfrom-active-source`/expanded.
    // "Selected" spans every source; "Required" is that selection's exact
    // shape-appropriate fee estimate (always non-empty); "source-label" is
    // the truthful "Notebook" / "Spending wallet" / <wallet label> / "N
    // wallets" the compose row and summary card both render; tint by
    // `spend-enough` everywhere (the SAME verdict gates Sign).
    in property <string> payfrom-required-line;
    in property <string> payfrom-selected-line;
    in property <string> payfrom-source-label: "Notebook";
    // Selected coins span more than one wallet — shows the linkage-hint line.
    in property <bool> mixed-linkage-hint: false;
    // Resolved change destination (default or explicit pick), for the
    // compose nav row and the Change screen header — always elided.
    in property <string> change-dest-label: "Notebook";
    // Explicit change pick made this compose session; "" = default resolution
    // applies (see app-core's resolve_change_default). Never reset by a
    // refresh once the user has chosen — only a fresh compose clears it.
    in-out property <string> change-choice: "";
    // The ACTUAL default resolution (see app-core's resolve_change_default) —
    // "spending" | "notebook" | "wallet:<id>" — independent of `change-choice`,
    // which may be a user override; drives which row gets the "default" pill.
    in property <string> change-default-choice: "";
    // Human-readable reason the default row is the default, e.g. "the
    // spending wallet is paying" / "no spending wallet enabled" / "<label>
    // is paying".
    in property <string> change-default-reason: "";
    // Truncated notebook (identity) address, for the Notebook row's subtitle.
    in property <string> change-notebook-line: "";
    // Truncated fresh spending-wallet change address + index, e.g.
    // "tb1p2ylq…q7ax · change #3" — "" when not derivable.
    in property <string> change-spending-line: "";
    // shared camera-scan overlay (every "Scan QR" path uses it)
    in-out property <bool> scanning;
    in-out property <image> camera-frame;
    in-out property <float> scan-progress;   // 0..1 multi-frame reassembly
    in property <string> scan-hint: "Point the QR code at the camera";
    callback cancel-scan();
    in property <[ContactItem]> contacts;
    in-out property <string> contact-input;
    in-out property <string> rename-address;
    in-out property <string> rename-input;
    in-out property <string> confirm-remove-address;
    in property <string> confirm-remove-name;

    in property <string> settings-network;
    in property <string> settings-identity;
    in property <bool> settings-hierarchical;
    // Watch-only identity (account-xpub import): no signing key, no private
    // notes — compose/sweep/consolidate/bump are hidden everywhere.
    in property <bool> watch-only;
    in property <[AccountItem]> accounts;
    in-out property <int> account-page;
    in-out property <bool> show-reset-confirm;
    // Tap-to-enlarge QR overlay: any QR sets qr-zoom-image + opens it, so a
    // small on-card QR can be scanned by another device. One shared overlay.
    in-out property <bool> qr-zoom-open;
    in-out property <image> qr-zoom-image;
    in-out property <string> chunk-text;
    in-out property <bool> chunk-custom;
    // Bitcoin node picker (URLs must be Esplora/mempool-compatible): option
    // labels (last = "Custom…"), selected index, custom-URL text when active.
    in property <[string]> node-options;
    in-out property <int> node-index;
    in-out property <string> node-custom-text;
    // Block-explorer picker: same shape.
    in property <[string]> explorer-options;
    in-out property <int> explorer-index;
    in-out property <string> explorer-custom-text;
    // ---- Reveal keys (Settings "Dangerous area" -> screens 18/19) ----
    // Shared header: "<xfp> · account N" (or just "account N" when the
    // fingerprint isn't known — an account-level xprv import).
    in property <string> reveal-fingerprint;
    // Public keys (18): derived from the cached session material, NO
    // fresh biometric. Both rows (xpub + descriptor) shown at once, each
    // with its own QR. `reveal-public-hint` explains an empty list (no
    // cached material, or a derive error) instead of a blank screen.
    in property <bool> reveal-can-public;   // false for single-key (wif/hex) imports — no xpub/descriptor
    in-out property <[RevealRow]> reveal-public-rows;   // in-out: rows toggle their own `expanded`
    in property <string> reveal-public-hint;
    // Private keys (19): ALWAYS behind a fresh biometric (triggered from
    // Settings, before navigating here). Adaptive availability — only
    // formats this identity actually supports get a pill. Progressive
    // disclosure: `reveal-private-format` is "" until the user taps a
    // pill, and only that ONE format's value is ever on screen.
    in property <bool> reveal-has-recovery;
    in property <bool> reveal-has-xprv;
    in property <bool> reveal-has-hex;
    in property <bool> reveal-has-wif;
    in property <string> reveal-private-format;   // "" | recovery | xprv | hex | wif
    in property <string> reveal-private-value;    // Mono value / Copy payload
    in property <image> reveal-private-qr;        // xprv/hex/wif QR
    in property <string> reveal-words-col1;       // recovery phrase, first half
    in property <string> reveal-words-col2;       // recovery phrase, second half
    in-out property <bool> reveal-show-seedqr;    // recovery: words vs SeedQR toggle
    in property <image> reveal-seedqr-image;
    // Notebook picker for the hex/WIF single-key views only (Recovery
    // phrase/Account xprv are index-independent — no picker). Populated
    // whenever Private keys is (re)opened; default selection = the active
    // notebook. Picking re-derives hex/WIF for THAT notebook, no re-auth.
    in property <[NbPickRow]> reveal-nb-rows;
    in-out property <int> reveal-nb-index;
    in property <[CoinItem]> coins;
    in property <string> coins-summary;
    // Settings Coins card only: aggregates notebook + spending pools (the
    // card has no segments); the Coins screen's segmented views keep the
    // per-pool `coins-summary` above.
    in property <string> coins-summary-settings;
    in property <[ActivityItem]> activity;
    in property <string> activity-summary;
    in-out property <bool> show-bump-dialog;
    in-out property <string> bump-ref;
    in-out property <bool> bump-is-note;
    in property <string> bump-kind;
    in property <string> bump-current;
    in property <string> bump-min;
    in property <string> bump-error;
    in property <string> bump-new-fee;
    in-out property <string> bump-rate;
    // CHANGE 4 (async wallet-tx broadcast, 2026-07-17): true while a
    // sweep/consolidate/wallet-consolidate/spending-consolidate/psbt-
    // broadcast has a POST in flight on a worker thread (build+sign stays
    // synchronous) — the universal confirm screen's Broadcast button shows
    // a busy caption and disables, and every entry point re-enters early.
    in-out property <bool> wallet-tx-busy;
    in-out property <string> sweep-dest;
    in-out property <string> sweep-rate: "1";
    // Sweep flow (picker → dedicated screen 15, compose-like): the send-to
    // picker doubles as the sweep destination picker via pick-mode.
    in-out property <string> pick-mode: "compose";   // "compose" | "sweep"
    in property <string> sweep-to-label;
    in-out property <int> sweep-tier: 1;
    in-out property <string> sweep-rate-text: "1";
    in property <string> sweep-cost-line;
    in property <string> sweep-inputs-title;
    in-out property <bool> sweep-inputs-expanded;
    in property <[SpendCoin]> sweep-coins;
    in-out property <bool> sweep-fund-external;
    // Screen 16 serves both flows: "sweep" (dest from the picker) and
    // "consolidate" (dest = self, opened from the Coins screen).
    in-out property <string> sweep-kind: "sweep";
    // Which screen the funding-wallet manager returns to (6 compose, 16 sweep).
    in-out property <int> funding-return: 6;
    // Where compose (screen 6) returns on back: 7 = picker (default/normal
    // flow), 5 = note view (opened via Reply).
    in-out property <int> compose-return: 7;

    callback door-import();
    callback door-create(int);
    callback import-changed(string);
    callback import-confirm(string);
    callback import-scan();
    callback import-file();
    callback paste-import();
    callback quiz-submit(string);
    callback backup-continue();
    callback regenerate-words();
    callback set-icloud-backup(bool);
    callback restore-icloud();
    callback refresh();
    callback refresh-notebooks();   // notebook-list header: rescan every notebook
    callback accept-terms();        // first-run disclaimer gate → proceed
    callback open-info(string);     // "about" | "privacy" | "help" | "faq" | "terms"
    callback open-source();         // Settings → About & help → opens the GitHub repo
    callback open-note(string);
    callback open-note-web-url(string);
    callback open-note-web();
    callback reply-to-note();
    callback reply-all-to-note();
    callback add-recipient-open();   // compose "+ Add recipient" → picker
    callback remove-chip(string);    // compose To-chip's × button
    callback copy-text(string, string);
    callback set-fee-tier(int);
    callback sweep-open();                 // settings → destination picker
    callback consolidate-open();           // coins → consolidate screen (16)
    callback set-sweep-tier(int);
    callback sweep-rate-changed();
    callback toggle-sweep-fund-external(bool);
    callback sweep-send();                 // screen 15 primary action
    callback open-coins();
    callback open-activity();
    callback act-retry(string, bool);
    callback act-bump-open(string, bool);
    callback act-bump-rate-changed(string);
    callback act-bump-confirm();
    callback act-explorer(string);
    callback compose-open();
    callback pick-contact(string);
    callback contact-scan();
    callback start-rename(string, string);
    callback save-rename(string);
    callback cancel-rename();
    callback remove-contact(string);
    callback confirm-remove(string, string);
    callback cancel-remove();
    callback compose-changed();
    callback paste-compose();
    callback compose-send();
    callback change-scan();
    // (source, "txid:vout") — `source` is now passed explicitly by the
    // tapped panel itself (independent-expand rework, 2026-07-18): multiple
    // Pay-from sections can be expanded at once, so there's no longer a
    // single "currently expanded" source to infer it from.
    callback toggle-coin(string, string);
    callback refresh-coins();
    callback set-coin-strategy(int);
    // external funding (PSBT)
    callback toggle-fund-external(bool);
    callback open-funding();       // compose → saved funding-wallets list
    callback add-funding-wallet();     // list → add-wallet entry screen
    callback use-funding-wallet(string);   // pick a saved wallet (scans it)
    callback remove-funding-wallet(string);
    callback refresh-funding-wallet(string);
    callback fund-rename-start(string, string);   // (id, current-label)
    callback fund-rename-save(string);
    callback fund-rename-cancel();
    callback funding-changed(string);
    callback funding-scan();       // scan a descriptor/xpub/UR-account QR
    callback funding-import-ur(string);   // a scanned UR account string → import
    callback funding-file();       // load a descriptor from file
    callback funding-use();        // accept the source, scan its coins, back to compose
    callback funding-clear();      // forget the funding wallet
    callback fund-build();         // build the unsigned PSBT → export screen
    // internal spending wallet (funding-unification M3)
    callback set-spending-enabled(bool);   // Settings toggle
    callback spending-refresh();           // manual refresh (Settings card + Coins segment)
    callback spending-sweep-here();        // Settings card "Sweep notebook funds here"
    callback set-pay-from(string);         // compose picker: "notebook" | "spending"
    callback set-coins-segment(string);    // Coins screen: "notebook" | "spending"
    callback spending-compose-send();      // compose picker "spending" primary action
    // funding-unification: dedicated "Pay from" screen (20) — compose's
    // picker/coin-control/change-address moved here wholesale, reached from
    // a single compact row on compose.
    callback open-funding-screen();        // compose row → screen 20
    callback funding-refresh();            // screen 20 header ↻ — async re-scan
    // Multi-wallet coin selection (funding-unification UI rework): tapping a
    // wallet row on screen 20 selects it AND expands its nested coin list.
    callback payfrom-expand(string);
    // Change now lives on its own screen (21), reached from a second compose
    // nav row below "Pay from".
    callback change-open();                // compose → screen 21
    callback change-pick(string);          // screen 21 row tap: an explicit choice
    // Sign when the selection spans more than one wallet in one tx.
    callback compose-send-mixed();
    // Internal: a background spending-wallet scan finished — same
    // trampoline pattern as apply-pending-refresh.
    callback apply-pending-spending-refresh();
    callback psbt-save();          // export the .psbt file
    callback psbt-copy();          // copy PSBT base64
    callback psbt-goto-import();   // export → import screen
    callback psbt-import-file();
    callback psbt-import-scan();
    callback psbt-loaded(string);  // internal: a scanned PSBT string → validate + confirm
    callback psbt-broadcast();     // finalize + broadcast the signed PSBT
    callback confirm-broadcast();  // universal confirm screen (26) — Broadcast tap
    callback confirm-cancel();     // universal confirm screen (26) — back/Cancel
    callback settings-open();
    callback set-network(string);
    callback reset-identity();
    callback open-account-picker();
    callback accounts-page(int);
    callback pick-account(int);
    callback account-cancel();
    callback set-chunk(string);
    callback oversize-bump(); // raise chunk size to Standard from the compose dialog
    callback set-node-preset(int);
    callback set-node-custom(string);
    callback set-explorer-preset(int);
    callback set-explorer-custom(string);
    callback reveal-public();          // Settings entry: derive from cached material, no auth, -> screen 18
    callback reveal-private();         // Settings entry: FRESH biometric, only navigates (-> screen 19) on success
    callback private-select(string);   // pick which single format is shown: recovery | xprv | hex | wif
    callback private-pick-notebook(int);  // hex/WIF only: re-derive for a different notebook, no re-auth
    callback reveal-hide();            // back/Done from 18 or 19: wipes every revealed value
    callback copy-value(string);       // copy a revealed format to the clipboard
    callback go-home();
    // Internal: a background scan finished — Rust invokes this from the
    // event loop to apply the result (never called from UI elements).
    callback apply-pending-refresh();
    // Internal: a notebook gap-discovery walk finished (seed re-import) —
    // same trampoline pattern as apply-pending-refresh.
    callback apply-pending-discovery();
    // Create-notebook picker: used/new address probes finished on a worker
    // thread; fill in the pills without blocking the tap that opened it.
    callback apply-pending-picker-probe();
    // Async sign+broadcast (2026-07-16): a compose send's build+broadcast
    // finished on a worker thread — same trampoline pattern.
    callback apply-pending-compose();
    // A Rebroadcast (act-retry) finished on a worker thread.
    callback apply-pending-act-retry();
    // A Rebroadcast's own raw-hex fetch (sub-case (b): chain-recovered/
    // watch record, no locally cached hex) finished on a worker thread —
    // enters the universal confirm screen on success.
    callback apply-pending-rebroadcast-fetch();
    // A Speed-up (RBF bump) broadcast finished on a worker thread.
    callback apply-pending-act-bump();
    // CHANGE 4: a consolidate/sweep/wallet-consolidate/psbt broadcast
    // finished on a worker thread — same trampoline pattern, one callback
    // draining all four result queues (mirrors apply-pending-compose).
    callback apply-pending-wallet-tx();
    // Where settings/activity return on back: the screen they were opened
    // from (the notebook list or a notebook's home). Set by their open
    // callbacks in Rust.
    in-out property <int> return-screen: 4;

    // ---------- notebooks (screen 17 = the main list; 4 = one notebook) ----------
    in-out property <[NotebookItem]> notebooks;
    in-out property <[NotebookItem]> archived-notebooks;
    in-out property <bool> show-archived;
    in-out property <string> archived-toggle-label;   // "Archived (2)" — preformatted
    in-out property <bool> can-create-notebook;       // hierarchical identities only
    in-out property <string> notebook-title: "Chain Notes"; // home header = open notebook's name
    // -1 = rename dialog closed · >= 0 = renaming that account. (Creation
    // never dialogs — the picker's inline name field covers it.)
    in-out property <int> nb-rename-index: -1;
    in-out property <string> nb-rename-input;
    // sender filter (home): exclusions persist per notebook, all-on default
    in-out property <[SenderItem]> senders;
    in-out property <bool> filter-expanded;
    in-out property <string> hidden-senders-label;    // "2 senders hidden", empty = none
    // The account picker (screen 9) serves two flows: "switch" = import /
    // settings account change (pick activates), "notebook" = the create-
    // notebook flow (inline name field on top; tapping an address creates
    // the notebook right away — rows already added are disabled).
    in-out property <string> account-pick-mode: "switch";
    in-out property <string> nb-create-name;
    in-out property <string> sweep-dest-note;   // linkage caveat, empty = none
    // wallet-level consolidate (Settings): dest picked on screen 9 in
    // "wconsol" mode — picking a destination row IS the trigger (build +
    // sign + universal confirm screen), no separate confirm tap.
    callback consolidate-wallet-open();
    // CHANGE 3 (2026-07-17): the Coins screen's spending segment gets its
    // own consolidate — merges every spending coin into ONE at the next
    // fresh spending receive address (signs in-app, no external wallet).
    // The button tap IS the trigger (build + sign + universal confirm
    // screen), no separate confirm tap.
    callback spending-consolidate-open();
    callback open-notebooks();
    callback open-notebook(int);
    callback create-notebook();
    callback nb-rename-start(int, string);
    callback nb-rename-save(string);
    callback nb-rename-cancel();
    callback nb-archive(int, bool);
    callback toggle-sender(string, bool);

    // ---------- system back (Android hardware/gesture back) ----------
    // slint delivers Android's back button/gesture as Key.Back to whatever
    // has keyboard focus and lets it bubble up from there — so back-scope
    // below wraps every child of the window, and holds focus itself whenever
    // no field does (key events aren't delivered at all while nothing has
    // focus; the changed-handlers below re-take it). Handled = navigate
    // exactly like the current screen's header chevron (single source of
    // truth: the chevrons call nav-back() too); unhandled (onboarding/home)
    // rejects the key so Android's default runs, which moves the task to
    // the background instead of quitting.
    callback back-logged(bool, int); // Rust: `cb: sys-back` log line
    function nav-back() -> bool {
        // Overlays first, topmost (= last window child) before the rest —
        // back closes the same thing a tap on Cancel / the dim would.
        if (root.qr-zoom-open) { root.qr-zoom-open = false; return true; }
        if (root.show-bump-dialog) { root.show-bump-dialog = false; return true; }
        if (root.show-oversize-modal) { root.show-oversize-modal = false; return true; }
        if (root.show-reset-confirm) { root.show-reset-confirm = false; return true; }
        if (root.confirm-remove-address != "") { root.cancel-remove(); return true; }
        if (root.rename-address != "") { root.cancel-rename(); return true; }
        if (root.fund-rename-id != "") { root.fund-rename-cancel(); return true; }
        if (root.nb-rename-index >= 0) { root.nb-rename-cancel(); return true; }
        if (root.scanning) { root.cancel-scan(); return true; }
        // Screens: one branch per header chevron.
        if (root.screen == 1 || root.screen == 2) { root.screen = 0; return true; }
        if (root.screen == 4) { root.open-notebooks(); return true; }
        if (root.screen == 3) { root.screen = 2; return true; }
        if (root.screen == 5) { root.go-home(); return true; }
        if (root.screen == 8 || root.screen == 11) {
            // Back to wherever settings/activity was opened from.
            if (root.return-screen == 17) { root.open-notebooks(); } else { root.go-home(); }
            return true;
        }
        if (root.screen == 6) {
            // Clear the typed address on the way back — it's saved in recents
            // now, so leaving it in the field is redundant. Status too: its
            // message belonged to this screen.
            root.contact-input = "";
            root.status = "";
            root.screen = root.compose-return;
            return true;
        }
        if (root.screen == 7) {
            if (root.pick-mode == "sweep") {
                root.pick-mode = "compose";
                root.screen = 8;
            } else if (root.picking-extra) {
                // "+ Add recipient" reopened the picker on top of compose —
                // back returns to compose, not home.
                root.picking-extra = false;
                root.screen = 6;
            } else {
                root.go-home();
            }
            return true;
        }
        if (root.screen == 9) { root.account-cancel(); return true; }
        if (root.screen == 10) { root.screen = 8; return true; }
        if (root.screen == 12) { root.open-funding(); return true; }
        if (root.screen == 13) { root.screen = root.watch-only ? 8 : 6; return true; }
        if (root.screen == 14) { root.screen = 13; return true; }
        if (root.screen == 15) { root.screen = root.funding-return; return true; }
        if (root.screen == 16) {
            // Clear the typed address + any stale status on the way back —
            // success messages otherwise linger red on the picker. Sweep
            // returns to its destination picker, consolidate to the coins.
            root.contact-input = "";
            root.status = "";
            if (root.sweep-kind == "consolidate") {
                root.screen = 10;
            } else {
                root.pick-mode = "sweep";
                root.screen = 7;
            }
            return true;
        }
        // Pay-from (screen 20): reached only from compose's compact row —
        // back always returns to compose, draft untouched (no field wipes,
        // unlike screen 6's own back-to-picker branch above).
        if (root.screen == 20) { root.screen = 6; return true; }
        // Change (screen 21): reached only from compose's second nav row —
        // back returns to compose too (a sibling of the Pay-from row, not
        // nested under screen 20).
        if (root.screen == 21) { root.screen = 6; return true; }
        if (root.screen == 18 || root.screen == 19) {
            root.reveal-hide();
            root.screen = 8;
            return true;
        }
        // Terms & disclaimer: the first-run accept gate can't be skipped with
        // back; the read-only re-view returns to Settings.
        if (root.screen == 24) {
            if (root.terms-accept-mode) { return false; }
            root.screen = 8;
            return true;
        }
        if (root.screen == 25) { root.screen = 8; return true; } // info → Settings
        // Universal confirm screen: back always cancels (never a bare nav —
        // Rust's on_confirm_cancel clears the pending broadcast + props and
        // picks the return screen), so Android back can't quit from here.
        if (root.screen == 26) { root.confirm-cancel(); return true; }
        return false; // 0 onboarding / 17 notebook list: nothing to go back to
    }
    // Focus must never be nobody's, or key events (incl. Back) are dropped
    // before they can bubble anywhere: re-take it whenever the focused
    // element may just have been destroyed — a screen change, or one of the
    // two self-focusing rename dialogs closing.
    changed screen => { back-scope.focus(); }
    changed rename-address => { if (root.rename-address == "") { back-scope.focus(); } }
    changed fund-rename-id => { if (root.fund-rename-id == "") { back-scope.focus(); } }
    changed nb-rename-index => { if (root.nb-rename-index < 0) { back-scope.focus(); } }
    // A repeat copy while the toast is still showing resets the countdown
    // (see toast-ticks above) instead of cutting the dismiss short.
    changed toast-nonce => { root.toast-ticks = 6; }

    back-scope := FocusScope {
        focus-on-click: false; // never steal a tap's focus from a field
        focus-on-tab-navigation: false; // no invisible Tab stop between fields
        init => { self.focus(); }
        // The Down press decides (and navigates); the matching Up must replay
        // the same verdict — Android only runs its own default when it saw
        // the whole tracked down+up pair unhandled. Repeats replay too, so a
        // long-press can't navigate several screens at once.
        property <bool> back-eaten: false;
        key-pressed(event) => {
            if (event.text != Key.Back) { return reject; }
            if (!event.repeat) {
                back-eaten = root.nav-back();
                root.back-logged(back-eaten, root.screen);
            }
            return back-eaten ? accept : reject;
        }
        key-released(event) => {
            return (event.text == Key.Back && back-eaten) ? accept : reject;
        }

    // NOTE: back-scope wraps every window child from here down to its
    // matching closing brace at the bottom of the file; the children keep
    // their original one-level indent (mechanical wrap — slint is
    // whitespace-insensitive, and re-indenting ~2200 lines would bury the
    // file's history).

    // ---------- 0 · onboarding ----------
    if screen == 0: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 24px;
        spacing: 14px;
        alignment: start;
        Rectangle { height: 26px; }
        // SVG, not a typed "₿": Android's Roboto has no U+20BF glyph and
        // skia/femtovg have no font fallback (the icon rule).
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/bitcoin.svg");
                colorize: Pal.accent;
                width: 34px;
                height: 34px;
            }
        }
        H1 { text: "Chain Notes"; horizontal-alignment: center; }
        Caption {
            text: "Personal notes on the bitcoin blockchain — permanent, and yours.";
            horizontal-alignment: center;
        }
        Rectangle { height: 12px; }
        DoorCard {
            highlight: true;
            title: "Import a key";
            subtitle: "Any mnemonic, xprv, WIF, or 32-byte hex key — e.g. a BIP-85 child from your hardware wallet. An account xpub imports as watch-only. Type, scan, or open a file.";
            clicked => { root.door-import(); }
        }
        DoorCard {
            title: "Create a new 12-word seed";
            subtitle: "Fresh identity, backed up on paper. For everyone without a hardware wallet.";
            clicked => { root.door-create(12); }
        }
        DoorCard {
            title: "Create a new 18-word seed";
            subtitle: "Same, with a longer phrase.";
            clicked => { root.door-create(18); }
        }
        DoorCard {
            title: "Create a new 24-word seed";
            subtitle: "Same, with the longest phrase.";
            clicked => { root.door-create(24); }
        }
        if root.icloud-available: DoorCard {
            highlight: true;
            title: "Restore from iCloud";
            subtitle: "A key you backed up to iCloud Keychain is available — restore it on this device.";
            clicked => { root.restore-icloud(); }
        }
        Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 1 · import ----------
    if screen == 1: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Import key";
            back => { root.nav-back(); }
        }
        Caption { text: "Mnemonic (12/18/24 words), xprv, WIF, 32-byte hex — or an account xpub for a watch-only notebook (public notes and balance; private notes stay sealed, no composing)."; }
        EditArea {
            height: 110px;
            text <=> root.import-text;
            edited => { root.import-changed(self.text); }
        }
        if root.import-suggestions != "": Caption {
            text: root.import-suggestions;
            color: Pal.accent;
        }
        if root.import-feedback != "": Body {
            text: root.import-feedback;
            font-size: 12px;
            // Rust sets the flag alongside the text (string-matching the
            // feedback here rotted once already).
            color: root.import-feedback-ok ? Pal.good : Pal.warn;
        }
        HorizontalLayout {
            spacing: 10px;
            GhostButton { text: "Paste"; clicked => { root.paste-import(); } }
            GhostButton { text: "Scan QR"; clicked => { root.import-scan(); } }
            if root.desktop-platform: GhostButton { text: "From file…"; clicked => { root.import-file(); } }
        }
        if root.apple-platform && root.icloud-enabled: Switch {
            text: "Back up to iCloud";
            checked <=> root.icloud-backup;
            toggled => { root.set-icloud-backup(root.icloud-backup); }
        }
        if root.apple-platform && !root.icloud-enabled: Caption {
            text: "iCloud backup is off — sign into iCloud (with iCloud Keychain) to back up this key automatically.";
            color: Pal.warn;
        }
        PrimaryButton { text: "Import"; clicked => { root.import-confirm(root.import-text); } }
    }

    // ---------- 2 · backup ----------
    if screen == 2: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Write these words down";
            show-back: true;
            back => { root.nav-back(); }
        }
        Rectangle {
            border-radius: 10px;
            background: Pal.warn.with-alpha(0.12);
            height: warn-t.preferred-height + 20px;
            warn-t := Caption {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                color: Pal.warn;
                text: "Anyone with these words can spend your funds and read every private note. Write them on paper — never a screenshot.";
            }
        }
        Card {
            height: words-t.preferred-height + 32px;
            words-t := Mono {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                text: root.backup-words;
                font-size: 13px;
            }
            CopyButton {
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                clicked => { root.copy-text("backup-words", root.backup-words); }
            }
        }
        Caption {
            color: Pal.muted;
            text: "Generated on this online device, so treat it as a hot wallet — keep only note-fee amounts here. For real savings, use a hardware wallet and import it as watch-only. You can also view these words again later in Settings.";
        }
        // Advanced (collapsible, styled like the compose panels so it clearly
        // reads as tappable): optional user-supplied entropy ("salt").
        Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: adv-col.preferred-height;
            adv-col := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Rectangle {
                    height: 22px;
                    TouchArea { clicked => { root.advanced-expanded = !root.advanced-expanded; } }
                    HorizontalLayout {
                        Text {
                            text: "Advanced";
                            font-size: 12px;
                            color: Pal.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        Image {
                            source: root.advanced-expanded
                                ? @image-url("icons/caret-up.svg")
                                : @image-url("icons/caret-down.svg");
                            colorize: Pal.muted;
                            width: 16px;
                            height: 16px;
                            y: (parent.height - 16px) / 2;
                        }
                    }
                }
                if root.advanced-expanded: Caption {
                    text: "Add extra entropy — dice rolls, random words, anything. It's hashed with the device's secure RNG, so it can only ADD randomness. Press the reroll button or Enter to reroll.";
                }
                if root.advanced-expanded: HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        placeholder-text: "extra entropy (optional)";
                        text <=> root.entropy-salt;
                        accepted => { root.regenerate-words(); }
                    }
                    SvgIconButton {
                        icon: "refresh";
                        tint: Pal.text;
                        clicked => { root.regenerate-words(); }
                    }
                }
            }
        }
        if root.apple-platform && root.icloud-enabled: Switch {
            text: "Back up to iCloud";
            checked <=> root.icloud-backup;
            toggled => { root.set-icloud-backup(root.icloud-backup); }
        }
        if root.apple-platform && root.icloud-enabled: Caption {
            text: "Syncs your key to your Apple devices and lets you restore after reinstall. Change anytime in Settings.";
            color: Pal.muted;
        }
        if root.apple-platform && !root.icloud-enabled: Caption {
            text: "iCloud backup is off — you're not signed into iCloud. Turn on iCloud (with iCloud Keychain) in system Settings to back up your key automatically.";
            color: Pal.warn;
        }
        PrimaryButton { text: "I wrote them down"; clicked => { root.backup-continue(); } }
    }

    // ---------- 3 · quiz ----------
    if screen == 3: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Spot check";
            show-back: true;
            back => { root.nav-back(); }
        }
        Body { text: root.quiz-prompt; }
        EditField { text <=> root.quiz-answer; placeholder-text: "word  word  word"; }
        PrimaryButton { text: "Verify"; clicked => { root.quiz-submit(root.quiz-answer); } }
        Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 4 · home ----------
    if screen == 4: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 40px;
            BackButton { clicked => { root.open-notebooks(); } }
            Text {
                text: root.notebook-title;
                font-size: 19px;
                font-weight: 700;
                color: Pal.text;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle { }
            SvgIconButton { icon: "refresh"; clicked => { root.refresh(); } }
            SvgIconButton { icon: "activity"; clicked => { root.open-activity(); } }
            // No settings gear here (Sal 2026-07-11): settings is
            // wallet-level, reachable from the notebook list only.
        }
        Card {
            height: 132px;
            HorizontalLayout {
                padding: 12px;
                spacing: 14px;
                Rectangle {
                    width: 100px;
                    height: 100px;
                    background: white;
                    border-radius: 8px;
                    QrArea {
                        img: root.address-qr;
                        qr-size: 92px;
                        x: 4px;
                        y: 4px;
                    }
                    // Tap the QR to enlarge it for scanning by another device.
                    TouchArea {
                        clicked => {
                            root.qr-zoom-image = root.address-qr;
                            root.qr-zoom-open = true;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: root.balance-line;
                        font-size: 17px;
                        font-weight: 700;
                        color: Pal.text;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Mono {
                            text: root.address;
                            font-size: 10px;
                            color: Pal.muted;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            CopyButton { clicked => { root.copy-text("address", root.address); } }
                        }
                    }
                    if root.watch-only: HorizontalLayout {
                        alignment: start;
                        Badge { label: "watch-only"; tint: Pal.warn; }
                    }
                    Caption { text: root.status; }
                }
            }
        }
        PrimaryButton { text: "+  Compose note"; clicked => { root.compose-open(); } }
        if root.watch-only: Caption { text: "Watch-only — public notes only, signed on your external wallet. Private notes need the key."; }
        // Sender filter header: tap to expand the per-sender checklist; the
        // warn pill flags a persisted exclusion so hidden notes are never a
        // silent mystery.
        Rectangle {
            height: 24px;
            if root.senders.length > 1: TouchArea { clicked => { root.filter-expanded = !root.filter-expanded; } }
            HorizontalLayout {
                spacing: 8px;
                Caption {
                    text: root.notes.length == 0
                        ? (root.watch-only ? "No notes on this address yet." : "No notes yet — fund the address above, then compose.")
                        : "Notes";
                    vertical-alignment: center;
                }
                if root.hidden-senders-label != "": Badge { label: root.hidden-senders-label; tint: Pal.warn; }
                Rectangle { }
                if root.senders.length > 1: HorizontalLayout {
                    spacing: 6px;
                    Caption { text: "Senders"; vertical-alignment: center; }
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: root.filter-expanded
                                ? @image-url("icons/caret-up.svg")
                                : @image-url("icons/caret-down.svg");
                            colorize: Pal.muted;
                            width: 12px;
                            height: 12px;
                        }
                    }
                }
            }
        }
        if root.filter-expanded: VerticalLayout {
            spacing: 4px;
            for s in root.senders: Rectangle {
                height: 36px;
                border-radius: 8px;
                background: s-ta.has-hover ? Pal.card-hover : Pal.card;
                border-width: 1px;
                border-color: Pal.line;
                s-ta := TouchArea { clicked => { root.toggle-sender(s.key, !s.excluded); } }
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: s.excluded ? Pal.line : Pal.accent;
                            background: s.excluded ? transparent : Pal.accent.with-alpha(0.18);
                            if !s.excluded: Image {
                                source: @image-url("icons/check.svg");
                                colorize: Pal.accent;
                                width: 11px;
                                height: 11px;
                                x: 2.5px;
                                y: 2.5px;
                            }
                        }
                    }
                    Text {
                        text: s.label;
                        font-size: 12px;
                        color: s.excluded ? Pal.muted : Pal.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { }
                    Caption { text: s.sub; vertical-alignment: center; }
                }
            }
        }
        // Notebook list — top-aligned + scrollable (a plain ListView vertically
        // centres a short list). Matches the Settings-screen Flickable pattern.
        Flickable {
            viewport-height: notes-col.preferred-height;
            notes-col := VerticalLayout {
                alignment: start;
                spacing: 6px;
                for note in root.notes: Rectangle {
                height: 62px;
                nt := TouchArea { clicked => { root.open-note(note.id); } }
                Rectangle {
                    y: 2px;
                    height: parent.height - 6px;
                    border-radius: 10px;
                    background: nt.has-hover ? Pal.card-hover : Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    HorizontalLayout {
                        x: 14px;
                        width: note.web-url != "" ? parent.width - 60px : parent.width - 26px;
                        height: parent.height;
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            if note.private: Image {
                                source: @image-url("icons/lock.svg");
                                colorize: Pal.muted;
                                width: 13px;
                                height: 13px;
                                x: 0;
                                y: (parent.height - 13px) / 2;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text {
                                text: note.title;
                                horizontal-alignment: left;
                                font-size: 13px;
                                color: Pal.text;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 20px;
                                Badge {
                                    label: note.badge;
                                    tint: note.badge == "confirmed" ? Pal.good
                                        : (note.badge == "pending" ? Pal.warn : Pal.bad);
                                }
                                Caption {
                                    text: note.meta;
                                    vertical-alignment: center;
                                    height: 20px;
                                }
                            }
                        }
                    }
                    if note.web-url != "": WebViewButton {
                        x: parent.width - 44px;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.open-note-web-url(note.web-url); }
                    }
                }
            }
            }
        }
    }

    // ---------- 17 · notebooks (the main screen) ----------
    if screen == 17: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 8px;
            height: 40px;
            Text {
                text: "Chain Notes";
                font-size: 19px;
                font-weight: 700;
                color: Pal.text;
                vertical-alignment: center;
            }
            Rectangle { }
            SvgIconButton { icon: "refresh"; clicked => { root.refresh-notebooks(); } }
            SvgIconButton { icon: "activity"; clicked => { root.open-activity(); } }
            IconButton { glyph: "⚙"; clicked => { root.settings-open(); } }
        }
        if root.can-create-notebook: PrimaryButton { text: "+  New notebook"; clicked => { root.create-notebook(); } }
        Caption { text: root.status; }
        // Zero active notebooks is a legitimate state (fresh start, or
        // everything archived) — say so instead of showing a blank page.
        if root.notebooks.length == 0: Caption {
            text: root.archived-toggle-label != ""
                ? "All notebooks are archived."
                : (root.can-create-notebook
                    ? "No notebooks yet — create one to start writing."
                    : "No notebooks yet.");
        }
        Flickable {
            viewport-height: nb-col.preferred-height;
            nb-col := VerticalLayout {
                alignment: start;
                spacing: 6px;
                for nb in root.notebooks: Rectangle {
                    height: 86px;
                    nb-ta := TouchArea { clicked => { root.open-notebook(nb.index); } }
                    Rectangle {
                        y: 2px;
                        height: parent.height - 6px;
                        border-radius: 10px;
                        background: nb-ta.has-hover ? Pal.card-hover : Pal.card;
                        border-width: 1px;
                        border-color: nb.active ? Pal.accent.with-alpha(0.55) : Pal.line;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 4px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Text {
                                        text: nb.name;
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: Pal.text;
                                        overflow: elide;
                                    }
                                    if nb.unread != "": Badge { label: nb.unread; tint: Pal.good; }
                                }
                                Caption { text: nb.snippet; overflow: elide; }
                                Caption { text: nb.meta; color: Pal.faint; }
                            }
                            VerticalLayout {
                                alignment: center;
                                PencilButton { clicked => { root.nb-rename-start(nb.index, nb.name); } }
                            }
                            VerticalLayout {
                                alignment: center;
                                SvgIconButton {
                                    icon: "archive";
                                    size: 15px;
                                    width: 32px;
                                    height: 32px;
                                    clicked => { root.nb-archive(nb.index, true); }
                                }
                            }
                        }
                    }
                }
                if root.archived-toggle-label != "": Rectangle {
                    height: 34px;
                    arch-ta := TouchArea { clicked => { root.show-archived = !root.show-archived; } }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Caption { text: root.archived-toggle-label; vertical-alignment: center; }
                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: root.show-archived
                                    ? @image-url("icons/caret-up.svg")
                                    : @image-url("icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 12px;
                                height: 12px;
                            }
                        }
                    }
                }
                if root.show-archived: VerticalLayout {
                    spacing: 6px;
                    for nb in root.archived-notebooks: Rectangle {
                        height: 56px;
                        anb-ta := TouchArea { clicked => { root.open-notebook(nb.index); } }
                        Rectangle {
                            y: 2px;
                            height: parent.height - 6px;
                            border-radius: 10px;
                            background: anb-ta.has-hover ? Pal.card-hover : Pal.card;
                            border-width: 1px;
                            border-color: Pal.line;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;
                                    Text {
                                        text: nb.name;
                                        font-size: 13px;
                                        color: Pal.muted;
                                        overflow: elide;
                                    }
                                    Caption { text: nb.meta; color: Pal.faint; }
                                }
                                Rectangle { }
                                VerticalLayout {
                                    alignment: center;
                                    GhostButton { text: "Restore"; clicked => { root.nb-archive(nb.index, false); } }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------- 5 · note view ----------
    if screen == 5: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Note";
            back => { root.nav-back(); }
        }
        Card {
            height: nd.preferred-height + 32px;
            nd := Mono {
                x: 16px;
                y: 16px;
                width: parent.width - 32px;
                text: root.note-detail;
                font-size: 12px;
            }
        }
        HorizontalLayout {
            spacing: 10px;
            GhostButton { text: "Copy text"; clicked => { root.copy-text("note-text", root.note-detail); } }
            GhostButton { text: "Copy txid"; clicked => { root.copy-text("txid", root.note-txid); } }
        }
        if root.note-pending: Caption {
            text: "Still unconfirmed — speed it up or rebroadcast from Activity (the pulse icon on the home screen).";
        }
        if root.note-web-url != "": GhostButton {
            text: "Open in web viewer";
            clicked => { root.open-note-web(); }
        }
        if root.note-reply-address != "" || root.note-reply-set.length > 1: HorizontalLayout {
            spacing: 10px;
            if root.note-reply-address != "": GhostButton {
                text: "Reply";
                clicked => { root.reply-to-note(); }
            }
            // Hidden when the reply set has <= 1 entry — nothing beyond
            // plain Reply to add (a single-recipient note, or a self-note).
            if root.note-reply-set.length > 1: GhostButton {
                text: "Reply all";
                clicked => { root.reply-all-to-note(); }
            }
        }
        Caption { text: root.status; }
        if root.note-web-url == "": Caption {
            text: "Web viewer link unavailable on regtest.";
        }
    }

    // ---------- 6 · compose ----------
    if screen == 6: Rectangle {
        // Background tap layer: a tap on any empty area moves focus to
        // back-scope, which dismisses the on-screen keyboard. Interactive
        // children (the note editor, pills, buttons) sit on top in the
        // VerticalLayout and grab their own taps first — Sal 2026-07-13.
        TouchArea { clicked => { back-scope.focus(); } }
        VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Compose";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-height: compose-col.preferred-height;
            // Dismiss layer behind the content: the outer Rectangle's TouchArea
            // can't reach here (the Flickable intercepts its region), so a second
            // full-viewport TouchArea sits behind compose-col — taps on any gap
            // between fields dismiss the keyboard; the fields/editor on top grab
            // their own taps first — Sal 2026-07-13.
            TouchArea {
                width: parent.width;
                height: compose-col.preferred-height;
                clicked => { back-scope.focus(); }
            }
            compose-col := VerticalLayout {
                spacing: 12px;
        // Uniform To section (Sal, 2026-07-19): a "To" caption (same style
        // as the "Note" caption below) over UNIFORM rows — the primary
        // recipient row and every extra To-chip share ONE look (no "To: "
        // prefix on the primary, no "+ " prefix on the chips); only the
        // chips get a ✕ remove button (the primary is set back on the send-
        // to picker, screen 7 — tapping it here is a no-op today, same as
        // before this rework). Notebook-funded compose only for the chips
        // (Rust never opens the add-recipient picker on other pay-from
        // sources today, but the button below is also gated); the primary
        // row always shows regardless of pay-from.
        Text { text: "To"; font-size: 12px; color: Pal.muted; }
        VerticalLayout {
            spacing: 6px;
            Rectangle {
                height: 30px;
                border-radius: 8px;
                background: Pal.card;
                border-width: 1px;
                border-color: Pal.line;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    Text {
                        text: root.to-label;
                        font-size: 11px;
                        color: Pal.muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }
            for c in root.to-chips: Rectangle {
                height: 30px;
                border-radius: 8px;
                background: Pal.card;
                border-width: 1px;
                border-color: Pal.line;
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 4px;
                    spacing: 4px;
                    Text {
                        text: c.name == "" ? c.address : c.name;
                        font-size: 11px;
                        color: Pal.muted;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    IconButton {
                        glyph: "×";
                        glyph-size: 16px;
                        width: 26px;
                        height: 26px;
                        glyph-color: Pal.bad;
                        clicked => { root.remove-chip(c.address); }
                    }
                }
            }
        }
        if root.directed && !root.watch-only: GhostButton {
            text: root.to-chips.length + 1 >= 255 ? "Recipient limit reached (255)" : "+ Add recipient";
            clicked => { root.add-recipient-open(); }
        }
        // Just the label. Paste removed (native paste / the edit bubble
        // covers it) and Done removed (tapping empty space dismisses the
        // keyboard now) — Sal 2026-07-13.
        Text { text: "Note"; font-size: 12px; color: Pal.muted; }
        note-edit := EditArea {
            height: 150px;
            text <=> root.compose-text;
            edited => { root.compose-changed(); }
        }
        if !root.watch-only: HorizontalLayout {
            spacing: 12px;
            Switch {
                text: "Private";
                checked <=> root.compose-private;
                toggled => { root.compose-changed(); }
            }
            Rectangle { }
        }
        if root.watch-only: Caption {
            text: "Watch-only: public notes only — sealing needs the encryption key, which stays on your other device.";
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            SelectPill { text: "economy"; active: root.fee-tier == 0; clicked => { root.set-fee-tier(0); } }
            SelectPill { text: "normal"; active: root.fee-tier == 1; clicked => { root.set-fee-tier(1); } }
            SelectPill { text: "fast"; active: root.fee-tier == 2; clicked => { root.set-fee-tier(2); } }
            SelectPill { text: "custom"; active: root.fee-tier == 3; clicked => { root.set-fee-tier(3); } }
        }
        // Sat/vB rate box — ALWAYS visible (fee-tier redesign, 2026-07-16):
        // shows the active tier's effective rate and updates live when the
        // pills change; editing it auto-selects the Custom pill instead of
        // requiring a tap there first. Rust's on-set-fee-tier never
        // overwrites rate-text while fee-tier == 3, so this can't fight
        // the user's typing.
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            EditField {
                width: 84px;
                text <=> root.rate-text;
                edited => {
                    root.fee-tier = 3;
                    root.compose-changed();
                }
            }
            Caption { text: "sat/vB"; vertical-alignment: center; }
        }
        // Structured cost breakdown (Sal's build-17 follow-up, 2026-07-18:
        // the wrapped one-line string "doesn't look organized, use sections
        // key: value so it's more clear"): a compact card with one row per
        // figure. Empty value hides its row; the fold/total rows only exist
        // while the dust-rule fold prediction fires.
        if root.cost-size != "" || root.cost-fee != "": Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: cost-col.preferred-height;
            cost-col := VerticalLayout {
                padding: 12px;
                spacing: 4px;
                if root.cost-size != "": KvRow { label: "Size"; value: root.cost-size; }
                if root.cost-fee != "": KvRow { label: "Fee"; value: root.cost-fee; }
                if root.cost-gift != "": KvRow { label: "To recipient"; value: root.cost-gift; }
                if root.cost-dust != "": KvRow { label: "Dust to self"; value: root.cost-dust; }
                if root.cost-fold != "": KvRow { label: "Leftover (dust rule)"; value: root.cost-fold; value-color: Pal.warn; }
                if root.cost-total != "": KvRow { label: "Total"; value: root.cost-total; value-color: Pal.accent; }
            }
        }
        // Plain accent text: ERROR/status messaging only ("Too large to
        // broadcast…", "~N sats fee minimum", "funded from the external
        // wallet") — renders only while the structured card is empty, so
        // those look exactly as before.
        if root.cost-line != "" && root.cost-size == "" && root.cost-fee == "": Text {
            text: root.cost-line;
            font-size: 13px;
            font-weight: 600;
            color: Pal.accent;
            // The long-text overflow rule stands (Sal's build-16 iPhone
            // report): wrap instead of widening the compose column.
            wrap: word-wrap;
            preferred-width: 0;
            horizontal-stretch: 1;
        }
        // ---- gift amount (directed notes only), collapsible ----
        if root.directed: Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: gift-col.preferred-height;
            gift-col := VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Rectangle {
                    height: 22px;
                    TouchArea { clicked => { root.gift-expanded = !root.gift-expanded; } }
                    HorizontalLayout {
                        Text {
                            text: "Gift · \{root.gift-sats} sats";
                            font-size: 12px;
                            color: Pal.muted;
                            vertical-alignment: center;
                        }
                        Rectangle { }
                        Image {
                            source: root.gift-expanded
                                ? @image-url("icons/caret-up.svg")
                                : @image-url("icons/caret-down.svg");
                            colorize: Pal.muted;
                            width: 16px;
                            height: 16px;
                        }
                    }
                }
                if root.gift-expanded: Caption {
                    text: "Sats sent to the recipient along with your note. Minimum 330 (dust).";
                }
                if root.gift-expanded: EditField {
                    text <=> root.gift-sats;
                    input-type: number;
                    edited => { root.compose-changed(); }
                }
            }
        }
        // ---- pay from: ONE compact navigation row → screen 20 ----
        // Picker, coin control, and custom change all live on the "Pay from"
        // screen now (Sal 2026-07-16 iPhone-build-8 review — the old inline
        // rows widened past the right edge on iPhone). Every text elides so
        // this row can never do that again. Label + amount come from
        // `payfrom-source-label`/`payfrom-selected-line` (Sal's iPhone bug
        // cluster, 2026-07-18) — the TRUE cross-wallet selection, not the
        // last-tapped `pay-from`/`pay-from-label`, which could disagree with
        // what's actually selected (defect #4: the row used to lie).
        Rectangle {
            border-radius: 10px;
            background: pftap.has-hover ? Pal.card-hover : Pal.card;
            border-width: 1px;
            border-color: root.spend-enough ? Pal.line : Pal.bad;
            height: 44px;
            pftap := TouchArea { clicked => { root.open-funding-screen(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                Text {
                    text: "Pay from · " + root.payfrom-source-label;
                    font-size: 12px;
                    color: root.spend-enough ? Pal.text : Pal.bad;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.payfrom-selected-line;
                    font-size: 12px;
                    color: Pal.muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 0;
                }
                Text { text: "›"; font-size: 20px; color: Pal.muted; vertical-alignment: center; }
            }
        }
        // ---- change: ONE compact navigation row → screen 21, directly
        // below Pay-from (funding-unification UI rework, 2026-07-16). ----
        Rectangle {
            border-radius: 10px;
            background: chtap.has-hover ? Pal.card-hover : Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: 44px;
            chtap := TouchArea { clicked => { root.change-open(); } }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 6px;
                Text {
                    text: "Change · " + root.change-dest-label;
                    font-size: 12px;
                    color: Pal.text;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text { text: "›"; font-size: 20px; color: Pal.muted; vertical-alignment: center; }
            }
        }
        if root.mixed-linkage-hint: Caption {
            text: "This note spends coins from more than one wallet — their addresses become publicly linked on-chain.";
            color: Pal.warn;
        }
        Caption {
            text: root.compose-private
                ? "Encrypted forever on-chain — XChaCha20-Poly1305, 256-bit key; only your key (and a directed recipient) can read it."
                : "⚠  Public notes are world-readable, forever.";
        }
        if root.mixed-linkage-hint: PrimaryButton {
            text: root.compose-sending ? root.compose-progress-label : "Sign + review…";
            tint: (root.spend-enough && !root.compose-sending) ? Pal.accent : Pal.faint;
            tint-hover: (root.spend-enough && !root.compose-sending) ? Pal.accent-hover : Pal.faint;
            clicked => { if (root.spend-enough && !root.compose-sending) { root.compose-send-mixed(); } }
        }
        if !root.mixed-linkage-hint && root.pay-from == "notebook": PrimaryButton {
            text: root.compose-sending ? root.compose-progress-label : (root.watch-only ? "Build transaction to sign" : "Sign + review…");
            tint: (root.spend-enough && !root.compose-sending) ? Pal.accent : Pal.faint;
            tint-hover: (root.spend-enough && !root.compose-sending) ? Pal.accent-hover : Pal.faint;
            clicked => { if (root.spend-enough && !root.compose-sending) { root.compose-send(); } }
        }
        if !root.mixed-linkage-hint && root.pay-from == "spending": PrimaryButton {
            text: root.compose-sending ? root.compose-progress-label : "Sign + review…";
            tint: (root.spend-enough && !root.compose-sending) ? Pal.accent : Pal.faint;
            tint-hover: (root.spend-enough && !root.compose-sending) ? Pal.accent-hover : Pal.faint;
            clicked => { if (root.spend-enough && !root.compose-sending) { root.spending-compose-send(); } }
        }
        if !root.mixed-linkage-hint && root.fund-external: PrimaryButton {
            text: root.funding-ready ? "Build transaction to sign" : "Set a funding wallet first";
            tint: (root.funding-ready && root.spend-enough) ? Pal.accent : Pal.faint;
            tint-hover: (root.funding-ready && root.spend-enough) ? Pal.accent-hover : Pal.faint;
            clicked => {
                if (!root.funding-ready) {
                    root.open-funding();
                } else if (root.spend-enough) {
                    root.fund-build();
                }
            }
        }
        Caption { text: root.status; color: Pal.bad; }
            }
        }
        }
    }

    // ---------- 7 · contacts ----------
    if screen == 7: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: root.picking-extra ? "Add recipient" : (root.pick-mode == "sweep" ? "Sweep to" : "Send to");
            back => { root.nav-back(); }
        }
        // Self can't be an EXTRA recipient on a multi-recipient note (it's
        // already the notebook composing the tx) — hidden while adding.
        if root.pick-mode != "sweep" && !root.picking-extra: DoorCard {
            highlight: true;
            title: "Self — my notebook";
            subtitle: "A note in your own notebook.";
            clicked => { root.pick-contact("self"); }
        }
        // Divider between the Self card and the address-entry section.
        if root.pick-mode != "sweep" && !root.picking-extra: Rectangle { height: 1px; background: Pal.line; }
        HorizontalLayout {
            spacing: 10px;
            EditField {
                text <=> root.contact-input;
                placeholder-text: "taproot / segwit address";
                accepted(t) => { root.pick-contact(t); }
            }
            ScanButton { clicked => { root.contact-scan(); } }
            GhostButton { width: 64px; text: "Use"; clicked => { root.pick-contact(root.contact-input); } }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
        // Sweep = leaving the wallet: destinations are EXTERNAL addresses
        // (moving coins between notebooks is Consolidate's job).
        if root.pick-mode == "sweep": Caption {
            text: "The whole wallet — every notebook's coins — goes to this address in one transaction.";
        }
        if root.contacts.length > 0: Caption { text: "Recently used"; }
        // Recents list. A ListView / stretched Flickable vertically CENTRES a
        // short list, leaving a big gap under the "Recently used" separator.
        // Instead: a content-sized column that sits directly under the
        // separator, and a trailing stretch spacer that soaks up the leftover
        // space — so the rows always start at the top and grow downward.
        recents-col := VerticalLayout {
            spacing: 6px;
            for c in root.contacts: Rectangle {
                height: 52px;
                    ct := TouchArea { clicked => { root.pick-contact(c.address); } }
                    Rectangle {
                        y: 2px;
                        height: parent.height - 6px;
                        border-radius: 10px;
                        background: ct.has-hover ? Pal.card-hover : Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 6px;
                            spacing: 2px;
                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;
                                Text {
                                    text: c.name == "" ? c.address : c.name;
                                    font-size: 12px;
                                    color: Pal.text;
                                    overflow: elide;
                                }
                                if c.name != "": Caption { text: c.address; overflow: elide; }
                            }
                            VerticalLayout {
                                alignment: center;
                                PencilButton {
                                    clicked => { root.start-rename(c.address, c.name); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    glyph: "×";
                                    glyph-size: 20px;
                                    width: 32px;
                                    height: 32px;
                                    glyph-color: Pal.bad;
                                    clicked => { root.confirm-remove(c.address, c.name); }
                                }
                            }
                        }
                    }
                }
            }
    }

    // ---------- 8 · settings ----------
    if screen == 8: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Settings";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-height: settings-col.preferred-height;
            viewport-y <=> root.settings-scroll-y;
            settings-col := VerticalLayout {
                spacing: 12px;
                alignment: start;
        SettingsCard {
            title: "Identity";
            // Wallet-level on purpose: no per-notebook account or address
            // here (notebooks own those); kind · network · notebook count.
            subtitle: root.settings-identity;
            if root.settings-hierarchical: GhostButton {
                text: "Change account…";
                clicked => { root.open-account-picker(); }
            }
            GhostButton {
                text: "Switch identity — new seed or different key…";
                clicked => { root.show-reset-confirm = true; }
            }
        }
        if root.apple-platform: SettingsCard {
            title: "iCloud backup";
            subtitle: "Sync your key to iCloud Keychain — it's restored automatically after a reinstall or on your other Apple devices. Reveal still needs Face ID.";
            if root.icloud-enabled: Switch {
                text: "Back up to iCloud";
                checked <=> root.icloud-backup;
                toggled => { root.set-icloud-backup(root.icloud-backup); }
            }
            if !root.icloud-enabled: Caption {
                text: "iCloud is off on this device — sign into iCloud with iCloud Keychain to enable backup.";
                color: Pal.warn;
            }
        }
        SettingsCard {
            title: "Network";
            subtitle: "Which chain this notebook lives on. Every network keeps its own separate notebook for the same key.";
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill { text: "mainnet"; active: root.settings-network == "mainnet"; clicked => { root.set-network("mainnet"); } }
                SelectPill { text: "testnet4"; active: root.settings-network == "testnet4"; clicked => { root.set-network("testnet4"); } }
                SelectPill { text: "signet"; active: root.settings-network == "signet"; clicked => { root.set-network("signet"); } }
                SelectPill { text: "regtest"; active: root.settings-network == "regtest"; clicked => { root.set-network("regtest"); } }
            }
        }
        SettingsCard {
            title: "Note size limit";
            subtitle: "Largest OP_RETURN chunk per output. Standard suits modern relays (Core v30+). If a broadcast is rejected, switch to 80 compat and recompose.";
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                SelectPill {
                    text: "Standard";
                    active: !root.chunk-custom && root.chunk-text == "100000";
                    clicked => { root.set-chunk("100000"); }
                }
                SelectPill {
                    text: "80 compat";
                    active: !root.chunk-custom && root.chunk-text == "80";
                    clicked => { root.set-chunk("80"); }
                }
                SelectPill {
                    text: "Custom";
                    active: root.chunk-custom || (root.chunk-text != "100000" && root.chunk-text != "80");
                    clicked => { root.chunk-custom = true; }
                }
            }
            if root.chunk-custom || (root.chunk-text != "100000" && root.chunk-text != "80"): HorizontalLayout {
                spacing: 8px;
                EditField {
                    width: 130px;
                    text <=> root.chunk-text;
                    placeholder-text: "20 – 100000";
                    accepted(t) => { root.set-chunk(t); }
                }
                Caption { text: "bytes · press Return to apply"; vertical-alignment: center; }
            }
        }
        SettingsCard {
            title: "Bitcoin node";
            subtitle: "Scans and broadcasts go through this server — it learns your address and IP. Pick a provider, or point at your own Esplora/mempool-compatible node.";
            Dropdown {
                options: root.node-options;
                current-index: root.node-index;
                selected(i) => { root.node-index = i; root.set-node-preset(i); }
            }
            if root.node-index == root.node-options.length - 1: EditField {
                text <=> root.node-custom-text;
                placeholder-text: "https://mempool.example/api  or  http://127.0.0.1:3002";
                accepted(t) => { root.set-node-custom(t); }
            }
        }
        SettingsCard {
            title: "Block explorer";
            subtitle: "Where the app's Explorer links open a transaction. Pick a site or use your own (e.g. a self-hosted mempool); the link becomes <base>/tx/<txid>.";
            Dropdown {
                options: root.explorer-options;
                current-index: root.explorer-index;
                selected(i) => { root.explorer-index = i; root.set-explorer-preset(i); }
            }
            if root.explorer-index == root.explorer-options.length - 1: EditField {
                text <=> root.explorer-custom-text;
                placeholder-text: "https://your-mempool-host  (no trailing /tx)";
                accepted(t) => { root.set-explorer-custom(t); }
            }
        }
        SettingsCard {
            title: "Coins";
            subtitle: root.coins-summary-settings;
            GhostButton {
                text: "View wallet coins…";
                // This card summarizes NOTEBOOK coins, so always land on that
                // segment — without the reset, arriving after the spending
                // card's "View in Coins…" kept the spending segment active.
                clicked => { root.coins-segment = "notebook"; root.open-coins(); }
            }
        }
        if root.spending-capable: SettingsCard {
            title: "Separate spending wallet";
            subtitle: "Fresh bc1q addresses hold your funds instead of the notebook — protects your balance and pubkey behind the fresh-address discipline (costs slightly more per note). A shared spending pool publicly links the notes it pays for.";
            HorizontalLayout {
                Switch {
                    text: root.spending-enabled ? "On" : "Off";
                    checked <=> root.spending-enabled;
                    toggled => { root.set-spending-enabled(root.spending-enabled); }
                }
                Rectangle { }
            }
            if root.spending-enabled: Rectangle {
                border-radius: 10px;
                background: Pal.field;
                border-width: 1px;
                border-color: Pal.line;
                height: spending-card-col.preferred-height;
                spending-card-col := VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text {
                            text: root.spending-balance-line;
                            font-size: 13px;
                            font-weight: 700;
                            color: Pal.text;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        SvgIconButton { icon: "refresh"; size: 14px; width: 28px; height: 22px; clicked => { root.spending-refresh(); } }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            width: 64px;
                            height: 64px;
                            background: white;
                            border-radius: 6px;
                            QrArea {
                                img: root.spending-qr;
                                qr-size: 58px;
                                x: 3px;
                                y: 3px;
                            }
                            TouchArea {
                                clicked => {
                                    root.qr-zoom-image = root.spending-qr;
                                    root.qr-zoom-open = true;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            Caption { text: "Next receive address"; }
                            HorizontalLayout {
                                spacing: 4px;
                                Mono {
                                    text: root.spending-address;
                                    font-size: 10px;
                                    color: Pal.muted;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    CopyButton { clicked => { root.copy-text("address", root.spending-address); } }
                                }
                            }
                        }
                    }
                    GhostButton {
                        text: "Sweep notebook funds here…";
                        clicked => { root.spending-sweep-here(); }
                    }
                    GhostButton {
                        text: "View in Coins…";
                        // Through the callback, NOT a direct property write —
                        // set-coins-segment kicks the spending scan when the
                        // cache is cold (first-time View-in-Coins showed an
                        // empty spending list otherwise).
                        clicked => { root.set-coins-segment("spending"); root.open-coins(); }
                    }
                }
            }
        }
        SettingsCard {
            title: "Sweep wallet";
            subtitle: root.watch-only
                ? "Leaving this wallet: move everything (minus the fee) to an address you choose. Watch-only: you'll sign on your external wallet."
                : "Leaving this wallet: EVERY notebook's coins go to an address you choose, in one transaction (minus the fee). To move coins between notebooks, use Consolidate instead.";
            GhostButton {
                text: "Sweep wallet…";
                clicked => { root.sweep-open(); }
            }
        }
        SettingsCard {
            title: "Dangerous area";
            subtitle: root.watch-only
                ? "This is a watch-only identity — only public material (xpub / descriptor) can be revealed here. It can't spend and can't read private notes."
                : "Export this notebook's keys — to back them up, or move them to another wallet. Private material controls the funds and every private note: protect it like cash.";
            if root.reveal-can-public: GhostButton { text: "Public keys"; clicked => { root.reveal-public(); } }
            if !root.watch-only: GhostButton {
                text: "Private keys";
                clicked => { root.reveal-private(); }
            }
        }
        SettingsCard {
            title: "About & help";
            subtitle: "What Chain Notes is, how it handles your privacy, how to use it, and the terms you accepted.";
            GhostButton { text: "About"; clicked => { root.open-info("about"); } }
            GhostButton { text: "Help"; clicked => { root.open-info("help"); } }
            GhostButton { text: "Q & A"; clicked => { root.open-info("faq"); } }
            GhostButton { text: "Source code"; clicked => { root.open-source(); } }
            GhostButton { text: "Privacy"; clicked => { root.open-info("privacy"); } }
            GhostButton { text: "Terms & disclaimer"; clicked => { root.open-info("terms"); } }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
        // Signature tagline — last thing under every settings card, centered
        // with breathing room above and below.
        VerticalLayout {
            padding-top: 20px;
            padding-bottom: 28px;
            Text {
                text: "For bitcoiners by bitcoiners";
                horizontal-alignment: center;
                color: Pal.muted;
                font-size: 12px;
                font-italic: true;
            }
        }
            }
        }
    }

    // ---------- 9 · account picker ----------
    if screen == 9: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: root.account-pick-mode == "notebook" ? "New notebook"
                : (root.account-pick-mode == "wconsol" ? "Consolidate to" : "Choose account");
            back => { root.nav-back(); }
        }
        Caption {
            text: root.account-pick-mode == "notebook"
                ? "Name it, then pick its address — the account's next receive addresses. Used addresses already have on-chain history — picking one adopts its notes."
                : (root.account-pick-mode == "wconsol"
                    ? "Where should every coin end up? Pick one of your notebooks, or a used/new address — it becomes a notebook you can name from the list."
                    : "One seed holds many BIP-86 accounts — separate wallets with their own notebooks, switchable here. Notebooks live inside an account.");
        }
        // Create mode only: the name lives right here — tapping an
        // address creates immediately (no second dialog). The consolidate
        // picker deliberately has NO name field: most picks are existing
        // notebooks (a typed name would be dead input); a fresh destination
        // starts as the address short form, renameable from the list.
        if root.account-pick-mode == "notebook": EditField {
            text <=> root.nb-create-name;
            placeholder-text: "name (optional — empty = address short form)";
        }
        for a in root.accounts: Rectangle {
            // Rows already added as notebooks are informational-only when
            // CREATING (can't re-add); as a consolidate DESTINATION they
            // are first-class choices.
            property <bool> row-disabled: a.pill == "notebook" && root.account-pick-mode == "notebook";
            border-radius: 12px;
            border-width: 1px;
            border-color: a.active ? Pal.accent : Pal.line;
            background: at.has-hover && !self.row-disabled ? Pal.card-hover : Pal.card;
            opacity: self.row-disabled ? 0.45 : 1.0;
            height: al.preferred-height;
            at := TouchArea {
                enabled: !parent.row-disabled;
                clicked => { root.pick-account(a.index); }
            }
            al := VerticalLayout {
                padding: 14px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: (root.account-pick-mode == "notebook" || root.account-pick-mode == "wconsol"
                            ? "Notebook " : "Account ") + a.index;
                        font-size: 14px;
                        font-weight: 700;
                        color: a.active ? Pal.accent : Pal.text;
                    }
                    if a.pill != "": Badge {
                        label: a.pill;
                        tint: a.pill == "new" ? Pal.good
                            : (a.pill == "used" ? Pal.warn : Pal.muted);
                    }
                    Rectangle { }
                    if a.balance != "": Caption { text: a.balance; vertical-alignment: center; }
                    if a.active: Badge { label: "current"; tint: Pal.accent; }
                }
                Mono {
                    text: a.address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }
        }
        HorizontalLayout {
            spacing: 10px;
            GhostButton {
                width: 90px;
                text: "‹ Prev";
                clicked => { root.accounts-page(-1); }
            }
            Caption {
                text: (root.account-pick-mode == "notebook" || root.account-pick-mode == "wconsol"
                    ? "addresses " : "accounts ") + (root.account-page * 5) + " – " + (root.account-page * 5 + 4);
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            GhostButton {
                width: 90px;
                text: "Next ›";
                clicked => { root.accounts-page(1); }
            }
        }
    }

    // ---------- 10 · coins ----------
    if screen == 10: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Coins";
            back => { root.nav-back(); }
            SvgIconButton { icon: "refresh"; clicked => { root.refresh-coins(); } }
        }
        Caption {
            text: root.coins-segment == "spending"
                ? "The spending wallet's coins — fresh bc1q addresses that pay for notes, keeping funds off the public notebook."
                : (root.watch-only
                    ? "Every notebook's unspent outputs — a note tx spends from its own notebook's coins. Consolidating signs on your external wallet."
                    : "Every notebook's unspent outputs — a note tx spends from its own notebook's coins. Consolidating gathers them into ONE coin at an address you pick.");
        }
        if root.spending-capable && root.spending-enabled: HorizontalLayout {
            spacing: 8px;
            alignment: start;
            SelectPill { text: "notebook"; active: root.coins-segment == "notebook"; clicked => { root.coins-segment = "notebook"; } }
            SelectPill { text: "spending"; active: root.coins-segment == "spending"; clicked => { root.set-coins-segment("spending"); } }
        }
        // Viewer-first: the list is the point; consolidation is the ONE
        // action button on top (wallet-level — all notebooks at once).
        if root.coins-segment == "notebook": GhostButton {
            text: "Consolidate wallet…";
            clicked => { root.consolidate-wallet-open(); }
        }
        // CHANGE 3 (2026-07-17): the spending segment gets its own ONE
        // consolidate button (merges every spending coin into one, at the
        // NEXT FRESH spending receive address) — disabled below 2 coins.
        if root.coins-segment == "spending": GhostButton {
            text: "Consolidate spending coins…";
            opacity: root.spending-coins-list.length >= 2 ? 1.0 : 0.4;
            clicked => { if (root.spending-coins-list.length >= 2) { root.spending-consolidate-open(); } }
        }
        if root.coins-segment == "notebook": Body { text: root.coins-summary; font-size: 12px; }
        if root.coins-segment == "spending": Body { text: root.spending-balance-line; font-size: 12px; }
        if root.coins-segment == "notebook": Flickable {
            viewport-height: coins-col.preferred-height;
            coins-col := VerticalLayout {
                spacing: 8px;
                alignment: start;
                for c in root.coins: Rectangle {
                    height: cil.preferred-height;
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    cil := VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: c.value + " sats";
                                font-size: 13px;
                                font-weight: 700;
                                color: Pal.text;
                            }
                            if c.notebook != "": Badge { label: c.notebook; tint: Pal.muted; }
                            Rectangle { }
                            Badge {
                                label: c.status;
                                tint: c.status == "confirmed" ? Pal.good : Pal.warn;
                            }
                        }
                        Mono {
                            text: c.outpoint;
                            font-size: 10px;
                            color: Pal.muted;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }
                }
            }
        }
        if root.coins-segment == "spending": Flickable {
            viewport-height: spending-coins-col.preferred-height;
            spending-coins-col := VerticalLayout {
                spacing: 8px;
                alignment: start;
                for c in root.spending-coins-list: Rectangle {
                    height: scil.preferred-height;
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    scil := VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: c.value + " sats";
                                font-size: 13px;
                                font-weight: 700;
                                color: Pal.text;
                            }
                            Rectangle { }
                            Badge {
                                label: c.status;
                                tint: c.status == "confirmed" ? Pal.good : Pal.warn;
                            }
                        }
                        Mono {
                            text: c.address;
                            font-size: 10px;
                            color: Pal.muted;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // ---------- 11 · activity (transactions) ----------
    if screen == 11: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Activity";
            back => { root.nav-back(); }
        }
        Caption { text: root.activity-summary; }
        Flickable {
            viewport-height: act-col.preferred-height;
            act-col := VerticalLayout {
                spacing: 8px;
                alignment: start;
                for a in root.activity: Rectangle {
                    height: ail.preferred-height;
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    ail := VerticalLayout {
                        padding: 12px;
                        spacing: 5px;
                        HorizontalLayout {
                            spacing: 6px;
                            Text {
                                text: a.kind;
                                font-size: 12px;
                                font-weight: 700;
                                color: Pal.text;
                            }
                            if a.notebook != "": Badge { label: a.notebook; tint: Pal.muted; }
                            Rectangle { }
                            if a.replaced != "": Badge { label: a.replaced; tint: Pal.faint; }
                            Badge {
                                label: a.status;
                                // Task #14: "dropped" reads as amber, same
                                // warn tint "pending" uses (it's still a
                                // pending record — the tx just genuinely
                                // evaporated; Bump/Rebroadcast still work).
                                tint: a.status == "confirmed" ? Pal.good
                                    : ((a.status == "pending" || a.status == "dropped") ? Pal.warn : Pal.bad);
                            }
                        }
                        Body { text: a.title; font-size: 12px; overflow: elide; }
                        if a.status == "dropped": Caption { text: "dropped — bump fee to retry"; color: Pal.warn; }
                        Caption { text: a.fee-line; }
                        HorizontalLayout {
                            spacing: 6px;
                            Mono {
                                text: a.txid;
                                font-size: 10px;
                                color: Pal.muted;
                                wrap: no-wrap;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            if a.funded != "": Badge { label: a.funded; tint: Pal.accent; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            if a.pending && a.bumpable: GhostButton {
                                width: 96px;
                                height: 30px;
                                opacity: a.busy ? 0.5 : 1.0;
                                text: a.busy ? "…" : "Speed up";
                                clicked => { if (!a.busy) { root.act-bump-open(a.ref-id, a.is-note); } }
                            }
                            if a.pending: GhostButton {
                                width: 108px;
                                height: 30px;
                                opacity: a.busy ? 0.5 : 1.0;
                                text: a.busy ? "Sending…" : "Rebroadcast";
                                clicked => { if (!a.busy) { root.act-retry(a.ref-id, a.is-note); } }
                            }
                            if a.explorer != "": GhostButton {
                                width: 92px;
                                height: 30px;
                                text: "Explorer";
                                clicked => { root.act-explorer(a.explorer); }
                            }
                        }
                    }
                }
            }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 12 · funding wallet (external PSBT source) ----------
    if screen == 12: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Add wallet";
            back => { root.nav-back(); }
        }
        Caption {
            text: "Paste or scan an output descriptor / xpub, or scan your hardware wallet's account-export QR. Its key never leaves that wallet — you'll sign there.";
        }
        HorizontalLayout {
            spacing: 8px;
            EditField {
                text <=> root.funding-descriptor;
                placeholder-text: "tr([…]xpub…/<0;1>/*)  or  xpub…";
                edited => { root.funding-changed(self.text); }
            }
            ScanButton { clicked => { root.funding-scan(); } }
        }
        if root.desktop-platform: HorizontalLayout {
            alignment: start;
            GhostButton {
                width: 140px;
                text: "Load from file…";
                clicked => { root.funding-file(); }
            }
        }
        if root.funding-feedback != "": Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: root.funding-valid ? Pal.good.with-alpha(0.5) : Pal.bad.with-alpha(0.5);
            height: fbl.preferred-height;
            fbl := VerticalLayout {
                padding: 14px;
                Body {
                    text: root.funding-feedback;
                    color: root.funding-valid ? Pal.good : Pal.bad;
                }
            }
        }
        PrimaryButton {
            text: "Save & use";
            tint: root.funding-valid ? Pal.accent : Pal.faint;
            tint-hover: root.funding-valid ? Pal.accent-hover : Pal.faint;
            clicked => { if (root.funding-valid) { root.funding-use(); } }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 13 · export PSBT (sign externally) ----------
    if screen == 13: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Sign externally";
            // Funding flow came from compose (6); watch spends from settings (8).
            back => { root.nav-back(); }
        }
        Caption {
            text: root.desktop-platform
                ? "Scan this with your wallet (or save the file), sign it there, then bring the signed PSBT back."
                : "Scan this with your wallet, sign it there, then bring the signed PSBT back.";
        }
        if root.psbt-cost-line != "": Text {
            text: root.psbt-cost-line;
            font-size: 13px;
            font-weight: 600;
            color: Pal.accent;
            horizontal-alignment: center;
        }
        // Square card snug around the code — the old full-width card left
        // walls of white either side of the QR.
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 312px;
                height: 312px;
                border-radius: 14px;
                background: #FFFFFF;
                Image {
                    source: root.psbt-qr;
                    width: 288px;
                    height: 288px;
                    x: (parent.width - 288px) / 2;
                    y: (parent.height - 288px) / 2;
                    image-rendering: pixelated;
                }
            }
        }
        if root.psbt-frame-label != "": Caption {
            text: root.psbt-frame-label;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            spacing: 10px;
            if root.desktop-platform: GhostButton { text: "Save .psbt"; clicked => { root.psbt-save(); } }
            GhostButton { text: "Copy"; clicked => { root.psbt-copy(); } }
        }
        PrimaryButton {
            text: "I've signed it — Review";
            clicked => { root.psbt-goto-import(); }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 14 · import signed PSBT ----------
    // ONLY the load-signed-PSBT stage (funding-unification follow-up,
    // 2026-07-17): once a scanned/loaded PSBT validates, Rust navigates
    // straight to the universal confirm screen (26) — this screen never
    // shows a confirm view or a Broadcast button itself anymore.
    if screen == 14: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Review + broadcast";
            back => { root.nav-back(); }
        }
        Caption {
            text: root.desktop-platform
                ? "Load the signed PSBT from your wallet — file or QR."
                : "Scan the signed PSBT from your wallet.";
        }
        HorizontalLayout {
            spacing: 10px;
            if root.desktop-platform: GhostButton { text: "Load .psbt file"; clicked => { root.psbt-import-file(); } }
            GhostButton { text: "Scan QR"; clicked => { root.psbt-import-scan(); } }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 15 · funding wallets (manager list) ----------
    if screen == 15: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Funding wallets";
            back => { root.nav-back(); }
        }
        Caption {
            text: "Watch-only wallets that can pay for your notes. Tap one to use it, or add another.";
        }
        if root.funding-wallets.length == 0: Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            height: 60px;
            Caption {
                text: "No funding wallets yet — add one below.";
                horizontal-alignment: center;
                x: 0; width: parent.width;
                y: (parent.height - self.preferred-height) / 2;
            }
        }
        Flickable {
            viewport-height: fw-col.preferred-height;
            fw-col := VerticalLayout {
                spacing: 8px;
                alignment: start;
                for fw in root.funding-wallets: Rectangle {
                    height: fw-row.preferred-height;
                    border-radius: 10px;
                    background: fwta.has-hover ? Pal.card-hover : Pal.card;
                    border-width: 1px;
                    border-color: fw.active ? Pal.accent : Pal.line;
                    fwta := TouchArea { clicked => { root.use-funding-wallet(fw.id); } }
                    fw-row := HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 3px;
                            horizontal-stretch: 1;
                            HorizontalLayout {
                                spacing: 6px;
                                alignment: start;
                                Text {
                                    text: fw.label;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Pal.text;
                                    overflow: elide;
                                }
                                if fw.active: Badge { label: "active"; tint: Pal.accent; }
                            }
                            Caption { text: fw.meta; }
                        }
                        PencilButton { clicked => { root.fund-rename-start(fw.id, fw.label); } }
                        SvgIconButton {
                            icon: "refresh";
                            size: 14px;
                            width: 32px;
                            height: 32px;
                            clicked => { root.refresh-funding-wallet(fw.id); }
                        }
                        IconButton {
                            glyph: "×";
                            glyph-size: 18px;
                            glyph-color: Pal.bad;
                            width: 32px;
                            height: 32px;
                            clicked => { root.remove-funding-wallet(fw.id); }
                        }
                    }
                }
            }
        }
        Rectangle { }
        PrimaryButton {
            text: "+  Add wallet";
            clicked => { root.add-funding-wallet(); }
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- 16 · sweep (compose-like, minus the note text) ----------
    if screen == 16: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: root.sweep-kind == "consolidate" ? "Consolidate" : "Sweep";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-height: sweep-col.preferred-height;
            sweep-col := VerticalLayout {
                spacing: 12px;
                Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: 34px;
                    Text {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        text: root.sweep-to-label;
                        font-size: 12px;
                        color: Pal.muted;
                        overflow: elide;
                    }
                }
                if root.sweep-dest-note != "": Caption { text: root.sweep-dest-note; color: Pal.warn; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    SelectPill { text: "economy"; active: root.sweep-tier == 0; clicked => { root.set-sweep-tier(0); } }
                    SelectPill { text: "normal"; active: root.sweep-tier == 1; clicked => { root.set-sweep-tier(1); } }
                    SelectPill { text: "fast"; active: root.sweep-tier == 2; clicked => { root.set-sweep-tier(2); } }
                    SelectPill { text: "custom"; active: root.sweep-tier == 3; clicked => { root.sweep-tier = 3; root.sweep-rate-changed(); } }
                }
                if root.sweep-tier == 3: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    EditField {
                        width: 84px;
                        text <=> root.sweep-rate-text;
                        edited => { root.sweep-rate-changed(); }
                    }
                    Caption { text: "sat/vB"; vertical-alignment: center; }
                }
                if root.sweep-cost-line != "": Text {
                    text: root.sweep-cost-line;
                    font-size: 13px;
                    font-weight: 600;
                    color: Pal.accent;
                }
                // ---- pay the fee from another wallet (watch-only: the
                // external signer's full-value transfer needs it; keyed
                // sweeps pay their own fee out of the swept amount) ----
                if root.watch-only: HorizontalLayout {
                    Switch {
                        text: "Pay the fee from another wallet";
                        checked <=> root.sweep-fund-external;
                        toggled => { root.toggle-sweep-fund-external(self.checked); }
                    }
                    Rectangle { }
                }
                if root.sweep-fund-external: Caption {
                    text: "The full balance arrives at the destination. The fee comes out of the funding wallet; its change returns there.";
                }
                if root.sweep-fund-external: Rectangle {
                    border-radius: 10px;
                    background: sftap.has-hover ? Pal.card-hover : Pal.card;
                    border-width: 1px;
                    border-color: root.funding-ready ? Pal.line : Pal.accent.with-alpha(0.5);
                    height: 44px;
                    sftap := TouchArea { clicked => { root.funding-return = 16; root.open-funding(); } }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        Text {
                            text: root.funding-summary;
                            font-size: 12px;
                            color: root.funding-ready ? Pal.text : Pal.accent;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text { text: "›"; font-size: 22px; color: Pal.muted; vertical-alignment: center; }
                    }
                }
                // ---- inputs (read-only: a sweep spends everything) ----
                Rectangle {
                    border-radius: 10px;
                    background: Pal.card;
                    border-width: 1px;
                    border-color: Pal.line;
                    height: sw-in-col.preferred-height;
                    sw-in-col := VerticalLayout {
                        padding: 10px;
                        spacing: 8px;
                        Rectangle {
                            height: 22px;
                            TouchArea { clicked => { root.sweep-inputs-expanded = !root.sweep-inputs-expanded; } }
                            HorizontalLayout {
                                Text {
                                    text: root.sweep-inputs-title;
                                    font-size: 12px;
                                    color: Pal.muted;
                                    vertical-alignment: center;
                                }
                                Rectangle { }
                                Image {
                                    source: root.sweep-inputs-expanded
                                        ? @image-url("icons/caret-up.svg")
                                        : @image-url("icons/caret-down.svg");
                                    colorize: Pal.muted;
                                    width: 16px;
                                    height: 16px;
                                    y: (parent.height - 16px) / 2;
                                }
                            }
                        }
                        if root.sweep-inputs-expanded: Caption {
                            text: "A sweep spends every spendable coin, so the inputs are fixed.";
                        }
                        if root.sweep-inputs-expanded: VerticalLayout {
                            spacing: 6px;
                            for c in root.sweep-coins: Rectangle {
                                height: 42px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Pal.accent;
                                background: Pal.accent.with-alpha(0.10);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 10px;
                                    VerticalLayout {
                                        alignment: center;
                                        Text {
                                            text: c.value + " sats";
                                            font-size: 12px;
                                            color: Pal.text;
                                        }
                                    }
                                    Rectangle { }
                                    VerticalLayout {
                                        alignment: center;
                                        Badge {
                                            label: c.confirmed ? "confirmed" : "unconfirmed";
                                            tint: c.confirmed ? Pal.good : Pal.warn;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            height: 22px;
                                            width: swpill.preferred-width + 14px;
                                            border-radius: 11px;
                                            border-width: 1px;
                                            border-color: Pal.line;
                                            background: swpta.has-hover && c.explorer != "" ? Pal.card-hover : transparent;
                                            swpta := TouchArea {
                                                clicked => { if (c.explorer != "") { root.act-explorer(c.explorer); } }
                                            }
                                            swpill := HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 7px;
                                                spacing: 4px;
                                                Text {
                                                    text: c.txid-short;
                                                    font-family: "Menlo";
                                                    font-size: 10px;
                                                    color: Pal.muted;
                                                    vertical-alignment: center;
                                                }
                                                if c.explorer != "": Image {
                                                    source: @image-url("icons/external.svg");
                                                    colorize: Pal.accent;
                                                    width: 11px;
                                                    height: 11px;
                                                    y: (parent.height - 11px) / 2;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if !root.sweep-fund-external && !root.watch-only: PrimaryButton {
                    text: root.sweep-kind == "consolidate" ? "Consolidate — sign + review…" : "Sweep — sign + review…";
                    clicked => { root.sweep-send(); }
                }
                if !root.sweep-fund-external && root.watch-only: PrimaryButton {
                    text: "Build transaction to sign";
                    clicked => { root.sweep-send(); }
                }
                if root.sweep-fund-external: PrimaryButton {
                    text: root.funding-ready ? "Build transaction to sign" : "Set a funding wallet first";
                    clicked => {
                        if (!root.funding-ready) {
                            root.funding-return = 16;
                            root.open-funding();
                        } else {
                            root.sweep-send();
                        }
                    }
                }
                Caption { text: root.status; color: Pal.bad; }
            }
        }
    }

    // ---------- 20 · pay from (funding-unification: picker + coin control +
    // custom change, moved off compose wholesale — Sal 2026-07-16 iPhone
    // build-8 review). Reached only from compose's compact "Pay from" row;
    // back (nav-back, screen == 20) always returns to compose with the
    // draft untouched. Independent-expand rework (2026-07-18, Sal's iPhone
    // feedback): Notebook/Spending/each external wallet expand and collapse
    // on their own — a header tap ONLY shows/hides a section, it never
    // selects coins (that needs an actual coin tap, or the on-open
    // auto-selection); a pinned summary card up top shows required vs.
    // selected sats (reusing the exact figures the compose flow already
    // computes) so the totals stay visible while the wallet list scrolls
    // beneath it (no `alignment: start` + the Flickable gets
    // `vertical-stretch: 1`, same pattern as the universal confirm screen,
    // commit c3ec2d5). ----------
    if screen == 20: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Pay from";
            back => { root.nav-back(); }
            SvgIconButton { icon: "refresh"; clicked => { root.funding-refresh(); } }
        }
        Rectangle {
            border-radius: 10px;
            background: Pal.card;
            border-width: 1px;
            border-color: root.spend-enough ? Pal.line : Pal.warn;
            height: pf-summary.preferred-height;
            pf-summary := VerticalLayout {
                padding: 12px;
                spacing: 4px;
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Required"; font-size: 11px; color: Pal.muted; vertical-alignment: center; }
                    Text {
                        text: root.payfrom-required-line;
                        font-size: 13px;
                        font-weight: 600;
                        color: root.spend-enough ? Pal.text : Pal.warn;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text { text: "Selected"; font-size: 11px; color: Pal.muted; vertical-alignment: center; }
                    Text {
                        text: root.payfrom-selected-line;
                        font-size: 13px;
                        font-weight: 600;
                        color: root.spend-enough ? Pal.good : Pal.warn;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                        overflow: elide;
                    }
                }
                // ONE insufficiency message for the whole screen (Sal's
                // iPhone bug cluster, 2026-07-18: this used to render inside
                // EVERY expanded wallet panel — now it lives here, under the
                // summary card that carries the global verdict; panel
                // captions/borders stay neutral always, see `CoinListPanel`).
                if !root.spend-enough: Caption {
                    text: "Selected coins don't cover the note + fee — select more.";
                    color: Pal.warn;
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            viewport-height: payfrom-scr-col.preferred-height;
            payfrom-scr-col := VerticalLayout {
                spacing: 10px;
                alignment: start;
                // ---- Notebook: expands/collapses independently of every
                // other section — a header tap ONLY toggles visibility. ----
                VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.nb-expanded ? Pal.accent : Pal.line;
                        background: root.nb-expanded ? Pal.accent.with-alpha(0.10) : Pal.card;
                        TouchArea { clicked => { root.payfrom-expand("notebook"); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text {
                                text: "Notebook";
                                font-size: 12px;
                                color: root.nb-expanded ? Pal.accent : Pal.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: root.funding-notebook-balance;
                                font-size: 11px;
                                color: Pal.muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Image {
                                source: root.nb-expanded
                                    ? @image-url("icons/caret-up.svg")
                                    : @image-url("icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 14px;
                                height: 14px;
                                y: (parent.height - 14px) / 2;
                            }
                        }
                    }
                    if root.nb-expanded: Rectangle {
                        border-radius: 10px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        height: nb20panel.preferred-height;
                        nb20panel := CoinListPanel {
                            coins: root.nb-panel-coins;
                            title: root.nb-panel-title;
                            strategy: root.coin-strategy;
                            pick-strategy(i) => { root.set-coin-strategy(i); }
                            toggle(op) => { root.toggle-coin("notebook", op); }
                            refresh() => { root.refresh-coins(); }
                            explorer(u) => { root.act-explorer(u); }
                        }
                    }
                }
                // ---- Spending wallet: independent of Notebook + wallets. ----
                if root.spending-capable && root.spending-enabled: VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.sp-expanded ? Pal.accent : Pal.line;
                        background: root.sp-expanded ? Pal.accent.with-alpha(0.10) : Pal.card;
                        TouchArea { clicked => { root.payfrom-expand("spending"); } }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            Text {
                                text: "Spending wallet";
                                font-size: 12px;
                                color: root.sp-expanded ? Pal.accent : Pal.text;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            Text {
                                text: root.spending-summary;
                                font-size: 11px;
                                color: Pal.muted;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            Image {
                                source: root.sp-expanded
                                    ? @image-url("icons/caret-up.svg")
                                    : @image-url("icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 14px;
                                height: 14px;
                                y: (parent.height - 14px) / 2;
                            }
                        }
                    }
                    if root.sp-expanded: Rectangle {
                        border-radius: 10px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        height: sp20panel.preferred-height;
                        sp20panel := CoinListPanel {
                            coins: root.sp-panel-coins;
                            title: root.sp-panel-title;
                            strategy: root.coin-strategy;
                            pick-strategy(i) => { root.set-coin-strategy(i); }
                            toggle(op) => { root.toggle-coin("spending", op); }
                            refresh() => { root.refresh-coins(); }
                            explorer(u) => { root.act-explorer(u); }
                        }
                    }
                }
                // ---- External wallets: an accordion among THEMSELVES only
                // (this app keeps one external wallet's coins scanned/cached
                // live at a time) — independent of Notebook/Spending. ----
                for fw in root.funding-wallets: VerticalLayout {
                    spacing: 8px;
                    Rectangle {
                        height: fw20-row.preferred-height;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: fw.expanded ? Pal.accent : Pal.line;
                        background: fw.expanded ? Pal.accent.with-alpha(0.10) : Pal.card;
                        TouchArea { clicked => { root.payfrom-expand("wallet:" + fw.id); } }
                        fw20-row := VerticalLayout {
                            padding: 8px;
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 2px;
                            Text {
                                text: fw.label;
                                font-size: 12px;
                                color: fw.expanded ? Pal.accent : Pal.text;
                                overflow: elide;
                            }
                            Caption { text: "watch-only"; }
                        }
                    }
                    if fw.expanded: Rectangle {
                        border-radius: 10px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        height: fwpanel.preferred-height;
                        fwpanel := CoinListPanel {
                            coins: fw.coins;
                            title: fw.coin-title;
                            strategy: root.coin-strategy;
                            pick-strategy(i) => { root.set-coin-strategy(i); }
                            toggle(op) => { root.toggle-coin("wallet:" + fw.id, op); }
                            refresh() => { root.refresh-coins(); }
                            explorer(u) => { root.act-explorer(u); }
                        }
                    }
                }
                GhostButton {
                    text: "+ External wallet…";
                    clicked => { root.funding-return = 20; root.open-funding(); }
                }
                if root.mixed-linkage-hint: Caption {
                    text: "This note spends coins from more than one wallet — their addresses become publicly linked on-chain.";
                    color: Pal.warn;
                }
                if root.status != "": Caption { text: root.status; color: Pal.bad; }
            }
        }
    }

    // ---------- 21 · change destination (funding-unification UI rework) ----------
    // Moved off the Pay-from screen onto its own screen, reached from a
    // second compose nav row. Single-select rows; "Custom address…" reveals
    // the existing validated text input. Defaults (never overridden once an
    // explicit pick is made this session) come from app-core's
    // `mixed::resolve_change_default`.
    if screen == 21: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        alignment: start;
        Header {
            title: "Change";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-height: change-scr-col.preferred-height;
            change-scr-col := VerticalLayout {
                spacing: 10px;
                alignment: start;
                if root.spending-capable && root.spending-enabled: Rectangle {
                    height: chg-sp-row.preferred-height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.change-choice == "spending" ? Pal.accent : Pal.line;
                    background: root.change-choice == "spending" ? Pal.accent.with-alpha(0.10) : Pal.card;
                    TouchArea { clicked => { root.change-pick("spending"); } }
                    chg-sp-row := VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "Spending wallet · fresh change";
                                font-size: 12px;
                                font-weight: 600;
                                color: root.change-choice == "spending" ? Pal.accent : Pal.text;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if root.change-default-choice == "spending": Badge { label: "default"; tint: Pal.accent; }
                        }
                        if root.change-spending-line != "": Caption { text: root.change-spending-line; }
                        if root.change-default-choice == "spending": Caption { text: root.change-default-reason; }
                        Caption { text: "Never used before — keeps your funds unlinked."; }
                    }
                }
                Rectangle {
                    height: chg-nb-row.preferred-height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.change-choice == "notebook" ? Pal.accent : Pal.line;
                    background: root.change-choice == "notebook" ? Pal.accent.with-alpha(0.10) : Pal.card;
                    TouchArea { clicked => { root.change-pick("notebook"); } }
                    chg-nb-row := VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: "Notebook";
                                font-size: 12px;
                                font-weight: 600;
                                color: root.change-choice == "notebook" ? Pal.accent : Pal.text;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if root.change-default-choice == "notebook": Badge { label: "default"; tint: Pal.accent; }
                        }
                        if root.change-notebook-line != "": Caption { text: root.change-notebook-line; }
                        if root.change-default-choice == "notebook": Caption { text: root.change-default-reason; }
                        Caption { text: "Reuses your public notebook address."; }
                    }
                }
                for fw in root.funding-wallets: Rectangle {
                    height: chg-fw-row.preferred-height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.change-choice == "wallet:" + fw.id ? Pal.accent : Pal.line;
                    background: root.change-choice == "wallet:" + fw.id ? Pal.accent.with-alpha(0.10) : Pal.card;
                    TouchArea { clicked => { root.change-pick("wallet:" + fw.id); } }
                    chg-fw-row := VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text {
                                text: fw.label + " change";
                                font-size: 12px;
                                font-weight: 600;
                                color: root.change-choice == "wallet:" + fw.id ? Pal.accent : Pal.text;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if root.change-default-choice == "wallet:" + fw.id: Badge { label: "default"; tint: Pal.accent; }
                        }
                        if fw.change-addr != "": Caption { text: fw.change-addr; }
                        if root.change-default-choice == "wallet:" + fw.id: Caption { text: root.change-default-reason; }
                        Caption { text: fw.label + "'s change chain."; }
                    }
                }
                Rectangle {
                    height: chg-custom-row.preferred-height;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: root.change-choice == "custom" ? Pal.accent : Pal.line;
                    background: root.change-choice == "custom" ? Pal.accent.with-alpha(0.10) : Pal.card;
                    TouchArea { clicked => { root.change-pick("custom"); } }
                    chg-custom-row := VerticalLayout {
                        padding: 10px;
                        spacing: 3px;
                        Text {
                            text: "Custom address…";
                            font-size: 12px;
                            font-weight: 600;
                            color: root.change-choice == "custom" ? Pal.accent : Pal.text;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                }
                if root.change-choice == "custom": HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        text <=> root.change-address;
                        placeholder-text: "change address";
                        edited => { root.compose-changed(); }
                    }
                    ScanButton { clicked => { root.change-scan(); } }
                }
                if root.change-choice == "custom": Caption {
                    text: "Leaves this wallet — the coin won't be tracked here.";
                    color: Pal.warn;
                }
                if root.change-error != "": Caption { text: root.change-error; color: Pal.bad; }
                Caption { text: "Current: " + root.change-dest-label; }
            }
        }
    }

    // ---------- 18 · public keys (watch-only-safe, no re-auth) ----------
    if screen == 18: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Public keys";
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-width: self.width;
            viewport-height: pub-col.preferred-height;
            pub-col := VerticalLayout {
                width: parent.width;
                spacing: 14px;
                alignment: start;
                Caption {
                    text: "Watch-only — these can't spend your funds or read a private note. But an xpub or descriptor reveals every address in this notebook, so anyone you share it with can see its full balance and transaction history and track your activity. Share only with people you trust.";
                    color: Pal.warn;
                }
                if root.reveal-fingerprint != "": Mono {
                    text: root.reveal-fingerprint;
                    color: Pal.muted;
                }
                if root.reveal-public-hint != "": Caption { text: root.reveal-public-hint; color: Pal.warn; }
                // Collapsed by default — tap a row header to expand its value +
                // QR; both can be open at once.
                for row[idx] in root.reveal-public-rows: VerticalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 46px;
                        border-radius: 10px;
                        background: Pal.card;
                        border-width: 1px;
                        border-color: Pal.line;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 8px;
                            Text {
                                text: row.label;
                                color: Pal.text;
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Image {
                                source: row.expanded ? @image-url("icons/caret-up.svg") : @image-url("icons/caret-down.svg");
                                colorize: Pal.muted;
                                width: 16px;
                                height: 16px;
                            }
                        }
                        TouchArea {
                            clicked => {
                                root.reveal-public-rows[idx].expanded = !root.reveal-public-rows[idx].expanded;
                            }
                        }
                    }
                    if row.expanded: VerticalLayout {
                        spacing: 6px;
                        Rectangle {
                            border-radius: 10px;
                            background: Pal.card;
                            border-width: 1px;
                            border-color: Pal.line;
                            height: pkv.preferred-height + 24px;
                            pkv := Mono {
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                                text: row.value;
                            }
                        }
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 176px;
                                height: 176px;
                                QrArea {
                                    img: row.qr;
                                    qr-size: 176px;
                                }
                                TouchArea {
                                    clicked => {
                                        root.qr-zoom-image = row.qr;
                                        root.qr-zoom-open = true;
                                    }
                                }
                            }
                        }
                        GhostButton { text: "Copy"; clicked => { root.copy-value(row.value); } }
                    }
                }
            }
        }
    }

    // ---------- 19 · private keys (fresh Touch ID before entry) ----------
    if screen == 19: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: "Private keys";
            back => { root.nav-back(); }
        }
        Rectangle {
            border-radius: 10px;
            background: Pal.bad.with-alpha(0.12);
            height: priv-warn.preferred-height + 20px;
            priv-warn := Caption {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                color: Pal.bad;
                text: "Make sure no cameras or onlookers — anyone who captures a private key below controls the funds and can read every private note.";
            }
        }
        if root.reveal-fingerprint != "": Mono {
            text: root.reveal-fingerprint;
            color: Pal.muted;
        }
        Flickable {
            viewport-width: self.width;
            viewport-height: priv-col.preferred-height;
            priv-col := VerticalLayout {
                width: parent.width;
                spacing: 14px;
                alignment: start;
                HorizontalLayout {
                    spacing: 6px;
                    if root.reveal-has-recovery: SelectPill {
                        text: "BIP-39";
                        active: root.reveal-private-format == "recovery";
                        clicked => { root.private-select("recovery"); }
                    }
                    if root.reveal-has-xprv: SelectPill {
                        text: "xprv";
                        active: root.reveal-private-format == "xprv";
                        clicked => { root.private-select("xprv"); }
                    }
                    if root.reveal-has-hex: SelectPill {
                        text: "hex";
                        active: root.reveal-private-format == "hex";
                        clicked => { root.private-select("hex"); }
                    }
                    if root.reveal-has-wif: SelectPill {
                        text: "WIF";
                        active: root.reveal-private-format == "wif";
                        clicked => { root.private-select("wif"); }
                    }
                }
                if root.reveal-private-format == "": Caption {
                    text: "Tap a format to reveal it. Only one is ever shown at a time.";
                    color: Pal.muted;
                }

                // ---- Notebook picker: hex/WIF only (seed/account-level
                // formats don't vary per notebook) ----
                if root.reveal-private-format == "hex" || root.reveal-private-format == "wif": VerticalLayout {
                    spacing: 6px;
                    Caption { text: "Notebook:"; color: Pal.muted; }
                    for nb in root.reveal-nb-rows: Rectangle {
                        height: 44px;
                        nbp-ta := TouchArea { clicked => { root.private-pick-notebook(nb.index); } }
                        Rectangle {
                            border-radius: 10px;
                            background: nb.index == root.reveal-nb-index
                                ? Pal.accent.with-alpha(0.18)
                                : (nbp-ta.has-hover ? Pal.card-hover : Pal.card);
                            border-width: 1px;
                            border-color: nb.index == root.reveal-nb-index ? Pal.accent.with-alpha(0.55) : Pal.line;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 8px;
                                Text {
                                    text: nb.name;
                                    font-size: 13px;
                                    font-weight: 600;
                                    color: Pal.text;
                                    overflow: elide;
                                    horizontal-stretch: 2;
                                    vertical-alignment: center;
                                }
                                Mono {
                                    text: nb.addr;
                                    color: Pal.muted;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    wrap: no-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }

                // ---- Recovery phrase: word grid + SeedQR toggle ----
                if root.reveal-private-format == "recovery": VerticalLayout {
                    spacing: 10px;
                    if !root.reveal-show-seedqr: HorizontalLayout {
                        spacing: 16px;
                        Mono { text: root.reveal-words-col1; horizontal-stretch: 1; }
                        Mono { text: root.reveal-words-col2; horizontal-stretch: 1; }
                    }
                    if root.reveal-show-seedqr: HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 200px;
                            height: 200px;
                            QrArea {
                                img: root.reveal-seedqr-image;
                                qr-size: 200px;
                            }
                            TouchArea {
                                clicked => {
                                    root.qr-zoom-image = root.reveal-seedqr-image;
                                    root.qr-zoom-open = true;
                                }
                            }
                        }
                    }
                    GhostButton {
                        text: root.reveal-show-seedqr ? "Show words" : "Show as SeedQR";
                        clicked => { root.reveal-show-seedqr = !root.reveal-show-seedqr; }
                    }
                }

                // ---- xprv / hex / WIF: a single red-tinted value box ----
                if root.reveal-private-format == "xprv" || root.reveal-private-format == "hex" || root.reveal-private-format == "wif": VerticalLayout {
                    spacing: 10px;
                    Rectangle {
                        border-radius: 10px;
                        background: Pal.warn.with-alpha(0.10);
                        border-width: 1px;
                        border-color: Pal.warn.with-alpha(0.4);
                        height: pvv.preferred-height + 24px;
                        pvv := Mono {
                            x: 12px;
                            y: 12px;
                            width: parent.width - 24px;
                            text: root.reveal-private-value;
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 176px;
                            height: 176px;
                            QrArea {
                                img: root.reveal-private-qr;
                                qr-size: 176px;
                            }
                            TouchArea {
                                clicked => {
                                    root.qr-zoom-image = root.reveal-private-qr;
                                    root.qr-zoom-open = true;
                                }
                            }
                        }
                    }
                }

                if root.reveal-private-format != "": GhostButton {
                    text: "Copy";
                    clicked => { root.copy-value(root.reveal-private-value); }
                }
            }
        }
    }

    // ---------- 24 · terms & disclaimer (first-run accept gate + re-view) ----------
    if screen == 24: VerticalLayout { padding-top: root.safe-top + 20px; padding-bottom: root.safe-bottom + 10px;
        padding: 24px;
        spacing: 16px;
        // View mode (opened from Settings) gets a normal header + back chevron.
        // Accept mode has NO back chevron — it must be accepted to proceed.
        if !root.terms-accept-mode: Header {
            title: "Terms & disclaimer";
            back => { root.nav-back(); }
        }
        Rectangle { }  // stretch — vertically centers the block on tall screens
        if root.terms-accept-mode: HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/bitcoin.svg");
                colorize: Pal.accent;
                width: 42px;
                height: 42px;
            }
        }
        if root.terms-accept-mode: H1 {
            text: "Before you begin";
            horizontal-alignment: center;
        }
        Body {
            text: root.disclaimer-body;
            font-size: 17px;
        }
        Rectangle { }  // stretch
        if root.terms-accept-mode: PrimaryButton {
            text: "I understand and accept";
            clicked => { root.accept-terms(); }
        }
    }

    // ---------- 25 · info (About / Privacy / Help / Q&A) ----------
    if screen == 25: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        Header {
            title: root.info-title;
            back => { root.nav-back(); }
        }
        Flickable {
            viewport-width: self.width;
            viewport-height: info-body-t.preferred-height;
            info-body-t := Body {
                width: parent.width;
                text: root.info-body;
                font-size: 17px;
            }
        }
    }

    // ---------- 26 · Confirm & broadcast (universal) ----------
    // Every broadcast path (compose/spending/mixed/signed-PSBT) lands here
    // before anything hits the wire — full decoded tx, Broadcast is the
    // only way out besides Cancel. Funding-unification follow-up,
    // 2026-07-17.
    if screen == 26: VerticalLayout { padding-top: root.safe-top + 14px; padding-bottom: root.safe-bottom;
        padding: 20px;
        spacing: 12px;
        // No `alignment: start` here: the detail view stretches to fill so
        // the Broadcast button stays PINNED at the bottom — a long tx
        // (mixed sweep, many inputs) scrolls inside TxConfirmView instead
        // of pushing Broadcast off-screen (and the e2e tap point is one
        // constant, not per-tx-shape).
        Header {
            title: "Confirm & broadcast";
            back => { root.confirm-cancel(); }
        }
        if root.confirm-context != "": Caption { text: root.confirm-context; }
        TxConfirmView {
            vertical-stretch: 1;
            note: root.confirm-note;
            inputs: root.confirm-inputs;
            outputs: root.confirm-outputs;
            fee-line: root.confirm-fee-line;
            warn: root.confirm-warn;
            txid: root.confirm-txid;
        }
        Rectangle {
            height: 46px;
            PrimaryButton {
                width: 100%;
                height: 100%;
                text: root.wallet-tx-busy ? "Broadcasting…" : "Broadcast";
                tint: root.wallet-tx-busy ? Pal.faint : Pal.accent;
                clicked => { if (!root.wallet-tx-busy) { root.confirm-broadcast(); } }
            }
            // A label swap alone was too subtle on a slow/dying connection
            // (Sal 2026-07-18: the button "did nothing" for several seconds
            // on weak cellular before the error landed) — pair it with the
            // same rotating spinner.svg QrSpinner already used elsewhere for
            // in-flight work, plus the reassurance caption below.
            if root.wallet-tx-busy: QrSpinner {
                width: 22px;
                height: 22px;
                x: parent.width - self.width - 14px;
                y: (parent.height - self.height) / 2;
            }
        }
        if root.wallet-tx-busy: Caption {
            text: "Sending to your node — a weak connection can take up to 30 seconds.";
        }
        if root.status != "": Caption { text: root.status; color: Pal.bad; }
    }

    // ---------- shared camera-scan overlay (live preview) ----------
    if root.scanning: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.86);
        z: 200;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 16px;
            padding: 24px;
            HorizontalLayout {
                alignment: center;
                Text {
                    text: root.scan-hint;
                    color: Pal.text;
                    font-size: 15px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    max-width: 340px;
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 300px;
                    border-radius: 16px;
                    clip: true;
                    background: #0a0a0a;
                    border-width: 2px;
                    border-color: Pal.accent;
                    Image {
                        source: root.camera-frame;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 300px;
                    height: 6px;
                    border-radius: 3px;
                    background: Pal.line;
                    Rectangle {
                        x: 0;
                        y: 0;
                        height: 100%;
                        width: parent.width * clamp(root.scan-progress, 0, 1);
                        background: Pal.accent;
                        border-radius: 3px;
                        animate width { duration: 150ms; }
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                Caption {
                    text: root.scan-progress > 0.001
                        ? "Collecting frames · \{round(root.scan-progress * 100)}%"
                        : "Hold your phone steady and fill the frame.";
                    horizontal-alignment: center;
                }
            }
            HorizontalLayout {
                alignment: center;
                GhostButton {
                    text: "Cancel";
                    min-width: 220px;
                    clicked => { root.cancel-scan(); }
                }
            }
        }
    }

    // ---------- funding-wallet rename (modal overlay) ----------
    if root.fund-rename-id != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.fund-rename-cancel(); } }
        Rectangle {
            width: 400px;
            height: frl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            frl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this wallet";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                EditField {
                    text <=> root.fund-rename-input;
                    placeholder-text: "wallet name";
                    accepted(t) => { root.fund-rename-save(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.fund-rename-cancel(); } }
                    PrimaryButton { text: "Save"; clicked => { root.fund-rename-save(root.fund-rename-input); } }
                }
            }
        }
    }

    // ---------- rename dialog (modal overlay) ----------
    if root.rename-address != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.cancel-rename(); } }
        Rectangle {
            width: 400px;
            height: dl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { } // swallow clicks on the card body
            dl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this contact";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Mono {
                    text: root.rename-address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
                rename-edit := EditField {
                    text <=> root.rename-input;
                    placeholder-text: "name (empty clears it)";
                    accepted(t) => { root.save-rename(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.cancel-rename(); } }
                    PrimaryButton { text: "Save"; clicked => { root.save-rename(root.rename-input); } }
                }
            }
        }
    }

    // ---------- notebook rename dialog (modal overlay) ----------
    if root.nb-rename-index >= 0: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.nb-rename-cancel(); } }
        Rectangle {
            width: 400px;
            height: nbl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { } // swallow clicks on the card body
            nbl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Name this notebook";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Caption { text: "The name stays on this device — it is never published."; }
                nb-rename-edit := EditField {
                    text <=> root.nb-rename-input;
                    placeholder-text: "name (empty = address short form)";
                    accepted(t) => { root.nb-rename-save(t); }
                    init => {
                        self.focus();
                        self.select-all();
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.nb-rename-cancel(); } }
                    PrimaryButton { text: "Save"; clicked => { root.nb-rename-save(root.nb-rename-input); } }
                }
            }
        }
    }

    // ---------- remove-contact confirmation (modal overlay) ----------
    if root.confirm-remove-address != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.cancel-remove(); } }
        Rectangle {
            width: 400px;
            height: cl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 220px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            cl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Remove this contact?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                if root.confirm-remove-name != "": Body { text: root.confirm-remove-name; }
                Mono {
                    text: root.confirm-remove-address;
                    font-size: 10px;
                    color: Pal.muted;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Caption { text: "Only removes it from recents — sending to this address again re-adds it."; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.cancel-remove(); } }
                    PrimaryButton {
                        text: "Remove";
                        tint: Pal.bad;
                        tint-hover: #ff6b62;
                        clicked => { root.remove-contact(root.confirm-remove-address); }
                    }
                }
            }
        }
    }

    // ---------- reset-identity confirmation (modal overlay) ----------
    if root.show-reset-confirm: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.show-reset-confirm = false; } }
        Rectangle {
            width: 400px;
            height: rl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            rl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Switch identity?";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body {
                    text: "This removes the current key from this device and returns to onboarding, where you can create a new seed or import a different key (and pick its account).";
                    font-size: 12px;
                }
                Caption {
                    text: "Your notes and funds stay on-chain. Re-import the same key + account and everything comes back. Make sure the backup is written down — without it, this identity is gone.";
                    color: Pal.warn;
                }
                if root.icloud-backup: Caption {
                    text: "iCloud backup is ON — this also deletes the key from iCloud, so it will NOT return on reinstall. Your written backup is the only recovery.";
                    color: Pal.bad;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.show-reset-confirm = false; } }
                    PrimaryButton {
                        text: "Remove key & switch";
                        tint: Pal.bad;
                        tint-hover: #ff6b62;
                        clicked => { root.reset-identity(); }
                    }
                }
            }
        }
    }

    // ---------- note-too-large dialog (modal overlay) ----------
    if root.show-oversize-modal: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.show-oversize-modal = false; } }
        Rectangle {
            width: 400px;
            height: ol.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            ol := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Note too large";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body {
                    text: root.oversize-message;
                    font-size: 12px;
                }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton {
                        text: root.oversize-offer-bump ? "Cancel" : "OK";
                        clicked => { root.show-oversize-modal = false; }
                    }
                    if root.oversize-offer-bump: PrimaryButton {
                        text: "Switch to Standard";
                        clicked => { root.oversize-bump(); }
                    }
                }
            }
        }
    }

    // ---------- speed-up (RBF bump) dialog ----------
    if root.show-bump-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.55);
        TouchArea { clicked => { root.show-bump-dialog = false; } }
        Rectangle {
            width: 400px;
            height: bl.preferred-height;
            x: (parent.width - self.width) / 2;
            y: 200px;
            border-radius: 14px;
            background: Pal.card;
            border-width: 1px;
            border-color: Pal.line;
            TouchArea { }
            bl := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: "Speed up transaction";
                    font-size: 16px;
                    font-weight: 700;
                    color: Pal.text;
                }
                Body { text: root.bump-kind; font-size: 12px; }
                Caption { text: root.bump-current; }
                HorizontalLayout {
                    spacing: 8px;
                    EditField {
                        width: 96px;
                        text <=> root.bump-rate;
                        edited => { root.act-bump-rate-changed(self.text); }
                    }
                    Caption { text: "sat/vB"; vertical-alignment: center; }
                }
                Body { text: root.bump-new-fee; font-size: 13px; font-weight: 600; color: Pal.accent; }
                Caption { text: root.bump-min; color: Pal.warn; }
                if root.bump-error != "": Caption { text: root.bump-error; color: Pal.bad; }
                HorizontalLayout {
                    spacing: 10px;
                    GhostButton { text: "Cancel"; clicked => { root.show-bump-dialog = false; } }
                    PrimaryButton { text: "Sign…"; clicked => { root.act-bump-confirm(); } }
                }
            }
        }
    }

    // ---------- QR zoom overlay (tap any QR to enlarge it for scanning) ----------
    // Any small on-card QR (address, SeedQR, key export) opens this; a tap
    // anywhere — the dim OR the enlarged code — closes it. The QR image is
    // native module resolution + `pixelated`, so blowing it up stays crisp.
    if root.qr-zoom-open: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000.with-alpha(0.82);
        qr-zoom-card := Rectangle {
            width: min(root.width - 48px, min(root.height - 168px, 380px));
            height: self.width;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: white;
            border-radius: 16px;
            QrArea {
                img: root.qr-zoom-image;
                qr-size: parent.width - 36px;
                x: 18px;
                y: 18px;
            }
        }
        Text {
            text: "Tap to close";
            x: (parent.width - self.width) / 2;
            y: qr-zoom-card.y + qr-zoom-card.height + 18px;
            color: white;
            font-size: 14px;
        }
        // Dismiss layer on TOP so a tap anywhere — including on the enlarged
        // QR — closes it (non-TouchArea siblings above would otherwise swallow
        // the click).
        TouchArea { clicked => { root.qr-zoom-open = false; } }
    }

    // ---------- Copy toast ("Copied") ----------
    // Every copy affordance (backup words, address, note text/txid, key-export
    // rows, PSBT base64) funnels through Rust's on-copy-text/on-copy-value/
    // on-psbt-copy, which set toast-text + bump toast-nonce + open toast-open.
    // Non-interactive (no TouchArea) so it never blocks taps underneath. The
    // timer just ticks a countdown (toast-ticks, reset by the toast-nonce
    // changed-handler above) while open, so it auto-dismisses ~1.5s after the
    // LAST copy — see the note on toast-ticks for why this isn't a simple
    // running-toggle restart.
    toast-timer := Timer {
        interval: 250ms;
        running: root.toast-open;
        triggered => {
            root.toast-ticks -= 1;
            if (root.toast-ticks <= 0) {
                root.toast-open = false;
            }
        }
    }
    if root.toast-open: Rectangle {
        width: 100%;
        height: 100%;
        toast-pill := Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 64px;
            width: toast-label.preferred-width + 32px;
            height: 36px;
            border-radius: 18px;
            background: Pal.card.with-alpha(0.96);
            border-width: 1px;
            border-color: Pal.line;
            toast-label := Text {
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: root.toast-text;
                color: Pal.text;
                font-size: 13px;
                font-weight: 600;
            }
        }
    }

    // Splash cover — the topmost child, so it hides everything until Rust
    // flips `ready` (once the safe-area inset is known). Prevents the content
    // from visibly sliding down from under the status bar on cold start.
    if !root.ready: Rectangle {
        width: 100%;
        height: 100%;
        background: Pal.bg;
    }
    } // end back-scope (system back)
}

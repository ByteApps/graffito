component CopyButton inherits Rectangle {
    callback clicked;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: ta.has-hover ? Pal.card-hover : transparent;
    ta := TouchArea { clicked => { root.clicked(); } }
    Image {
        source: @image-url("icons/copy.svg");
        colorize: Pal.muted;
        width: 13px;
        height: 13px;
        x: (parent.width - 13px) / 2;
        y: (parent.height - 13px) / 2;
    }
}

// Continuously-rotating loading indicator for QR cards (Sal 2026-07-16): QR
// generation can lag behind an async refresh (e.g. the spending wallet's
// receive-address QR is cleared to the default image while its worker-
// thread scan runs) — without this, that gap rendered as a plain white
// square that looked stuck. A Timer bumps the rotation angle continuously
// (Slint's `animate` has no infinite-iteration mode, so a timer step gives
// the same continuous-spin effect — femtovg-safe, no GPU shader needed);
// the icon is the plain arc SVG (`icons/spinner.svg`) per the tofu rule —
// no glyph spinners.
component QrSpinner inherits Rectangle {
    property <angle> spin-angle: 0deg;
    Timer {
        interval: 16ms;
        running: true;
        triggered => { spin-angle += 8deg; }
    }
    Image {
        source: @image-url("icons/spinner.svg");
        colorize: Pal.faint;
        width: min(parent.width, parent.height) * 0.4;
        height: self.width;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        rotation-angle: spin-angle;
        rotation-origin-x: self.width / 2;
        rotation-origin-y: self.height / 2;
    }
}

// A QR image with an automatic loading spinner: whenever `img` is the
// default/unset image (width == 0 — Rust hasn't produced/refreshed it yet),
// shows QrSpinner instead of a blank white square. `qr-size` is the square
// side; callers keep their own tap-to-zoom TouchArea layered on top.
component QrArea inherits Rectangle {
    in property <image> img;
    in property <length> qr-size: 100px;
    width: root.qr-size;
    height: root.qr-size;
    if root.img.width > 0: Image {
        source: root.img;
        width: 100%;
        height: 100%;
        image-rendering: pixelated;
    }
    if root.img.width <= 0: QrSpinner {
        width: 100%;
        height: 100%;
    }
}


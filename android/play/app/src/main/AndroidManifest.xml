<?xml version="1.0" encoding="utf-8"?>
<!--
  Hand-mirrored from the cargo-apk-generated manifest of the known-good
  sideload release APK at
  /Users/sal/Projects/prime/graffito/target-mobile/release/apk/graffito.apk
  (read-only reference checkout, sibling of this worktree — dumped with
  aapt2's "dump xmltree" subcommand).

  Structural NativeActivity attributes (activity name, exported,
  configChanges, the android.app.lib_name meta-data, the MAIN/LAUNCHER
  intent-filter) are copied VERBATIM from that dump (hasCode=false was
  dropped 2026-09-04 — see the comment on <application>) — those are what cargo-apk's manifest template always sets for a
  NativeActivity app and are not app-specific.

  App-identity values (label, icon, theme, permissions, uses-feature) instead
  follow ../../../../Cargo.toml's CURRENT [package.metadata.android] —
  the reference APK predates both the Graffito rebrand (it still says
  "Chain Notes") and the USE_BIOMETRIC permission, so those two fields were
  NOT mirrored from it; everything else was.

  package/versionCode/versionName/compileSdk/minSdk/targetSdk are NOT set
  here — AGP injects them from app/build.gradle.kts (applicationId,
  versionCode, versionName, compileSdk, minSdk, targetSdk) at merge time.
  windowSoftInputMode and launchMode are absent from the reference dump too
  (cargo-apk's default: standard launchMode, unset softInputMode), so this
  manifest leaves them at platform defaults, matching it exactly.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- No explicit <uses-sdk> here: AGP injects min/targetSdkVersion from
         app/build.gradle.kts's defaultConfig at manifest-merge time. -->

    <!-- Chain sync + broadcast (esplora/mempool.space over HTTPS). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- QR scan (camera) — install-time half; the runtime half is NDK
         Camera2, requested at capture time. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Reveal gate for the BiometricPrompt bridge (see
         src/keychain/android.rs). Without it BiometricPrompt.authenticate
         throws a SecurityException, caught by the bridge and reported as a
         denial — so the symptom is "reveal always refused, no dialog ever
         appears", not a crash. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- android:name + NO hasCode="false" (2026-09-04): Play's Automatic
         protection injects a dex and wraps the declared Application class;
         with hasCode=false ART loads no dex and the Play-served build crashed
         on launch (ClassNotFoundException com.pairip.application.Application).
         GraffitoApplication is an empty subclass that exists to be wrapped. -->
    <!-- enableOnBackInvokedCallback=false (2026-09-05): from targetSdk 36
         the system defaults to predictive back, which delivers back ONLY to a
         registered OnBackInvokedCallback — the app registers none (logcat:
         "Setting back callback null"), so a back gesture/button finished the
         activity from any screen instead of navigating. The legacy path
         delivers KEYCODE_BACK as a key event, which app.slint's root
         back-scope turns into nav-back(). The cargo-apk sideload manifest
         targets SDK 34 and never had this, which is why the emulator pass
         (API 34) could not see it. -->
    <application
        android:name="com.byteapps.graffito.GraffitoApplication"
        android:label="Graffito"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="false"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|fontScale|uiMode|locale|layoutDirection">
            <!-- fontScale here (2026-09-05): a font-size change must NOT
                 recreate the activity — that re-runs android_main in the same
                 process and left the safe-area insets at 0; the app re-reads
                 Configuration.fontScale itself (util::apply_type_scale). -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="graffito" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
